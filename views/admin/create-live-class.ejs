<%- include('navbar.ejs') %>

    <section class="live-class-section">

        <div class="container-live">
            <div class="live-card">

                <div class="live-header">
                    <h2>
                        <i class="fa fa-video-camera"></i> Create Live Class
                    </h2>
                    <p>Schedule your upcoming online session with Google Meet integration.</p>
                </div>

                <form action="/admin/create-live-class" method="POST">

                    <div class="form-group">
    <label><i class="fa fa-book"></i> Select Course</label>

    <select name="course_id" required>
        <option value="">-- Select Course --</option>

        <% courses.forEach(course => { %>
            <option value="<%= course.course_id %>">
                <%= course.course_title %>
            </option>
        <% }) %>

    </select>
</div>

                    <div class="form-row">

                        <div class="form-group half">
                            <label><i class="fa fa-calendar"></i> Date</label>
                            <input type="date" name="class_date" required>
                        </div>

                        <div class="form-group half">
                            <label><i class="fa fa-clock-o"></i> Time</label>
                            <input type="time" name="class_time" required>
                        </div>

                    </div>

                    <button type="submit" class="btn-create">
                        <i class="fa fa-video-camera"></i> Create Live Class
                    </button>

                </form>

            </div>
        </div>

    </section>


    <style>
        .live-class-section {
            padding: 60px 20px;
            background: #f4f6fb;
            min-height: 60vh;
        }

        .container-live {
            max-width: 600px;
            margin: auto;
        }

        .live-card {
            background: #fff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            transition: 0.3s;
        }

        .live-card:hover {
            transform: translateY(-3px);
        }

        .live-header h2 {
            margin: 0;
            font-weight: 600;
            color: #2c3e50;
        }

        .live-header h2 i {
            color: #28a745;
            margin-right: 8px;
        }

        .live-header p {
            margin-top: 8px;
            font-size: 14px;
            color: #777;
        }

        .form-group {
            margin-top: 20px;
        }

        .form-group label {
            display: block;
            font-weight: 500;
            margin-bottom: 6px;
            color: #444;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid #ddd;
            transition: 0.3s;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: #28a745;
            box-shadow: 0 0 6px rgba(40, 167, 69, 0.3);
            outline: none;
        }

        .form-row {
            display: flex;
            gap: 15px;
        }

        .half {
            flex: 1;
        }

        .btn-create {
            margin-top: 25px;
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 6px;
            background: #28a745;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-create:hover {
            background: #218838;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
        }
    </style>

    <%- include('footer.ejs') %>