<%- include('navbar.ejs') %>

    <div class="container p-5 mt-5 border shadow bg-white font-weight-bold" style="color: black;width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">User Footer Details</h3>
            </div>
            <div class="col-12">
                <form action="/admin/save_institute" method="post" enctype="multipart/form-data">
                    <label for="">Enter Institute Name</label>
                    <input type="text" name="institute_name" class="form-control" required>
                    <br>
                    <div class="text-center">
                        <button class="btn btn-primary font-weight-bold">Save Details</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="container border shadow mt-5 p-4 bg-white" style="width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">Our Institute Names</h3>
            </div>
            <div class="col-12">
                <table class="table table-bordered table-striped mt-2">
                    <thead class="thead-dark">
                        <tr>
                            <th>Action</th>
                            <th>Sr.No</th>
                            <th>Certification Images</th>
                        </tr>
                    </thead>
                    <tbody class="p-0">
                        <% for(var i=0; i < institute_name.length; i++) { %>
                            <tr class="text-dark">
                                <td class="text-center" style="white-space: nowrap; width: 10%;">
                                    <a style="text-decoration: none;"
                                        href="/admin/delete_institute_name/<%= institute_name[i].institute_id %>"
                                        onclick="return confirm('Are You Sure')">
                                        <button class="btn btn-danger"><i class="fa fa-trash"></i></button>
                                    </a>
                                </td>
                                <td>
                                    <%= i + 1 %>
                                </td>
                                <td>
                                    <%= institute_name[i].institute_name %>
                                </td>
                            </tr>
                            <% } %>
                    </tbody>
                </table>

            </div>
        </div>
    </div>

    <%- include('footer.ejs') %>