<%- include('navbar.ejs') %>
<!DOCTYPE html>
<html>

<head>

<title>Edit Service</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

.service-container{
    background:#fff;
    padding:30px;
    border-radius:10px;
    box-shadow:0px 3px 10px rgba(0,0,0,.08);
}

.page-heading{
    background:#d9ebff;
    color:#003b82;
    font-size:40px;
    font-weight:700;
    text-align:center;
    padding:18px;
    border-radius:8px;
    margin-bottom:30px;
}

.form-label{
    font-weight:600;
}

.current-image{
    width:170px;
    height:110px;
    object-fit:cover;
    border-radius:6px;
    border:1px solid #ddd;
}

.update-btn{
    background:#0d6efd;
    color:white;
    border:none;
    padding:14px 40px;
    border-radius:8px;
    font-size:18px;
    font-weight:600;
}

.update-btn:hover{
    background:#0b5ed7;
}

</style>

</head>

<body>

<div class="container mt-4 mb-5">

<div class="service-container">

<div class="page-heading">

UPDATE SERVICE

</div>

<form
action="/admin/update_service"
method="POST"
enctype="multipart/form-data">

<input
type="hidden"
name="service_id"
value="<%= service.service_id %>">

<div class="row">

<div class="col-md-6">

<label class="form-label">

Upload Service Image

</label>

<input
type="file"
name="service_image"
class="form-control">

</div>

<div class="col-md-2">

<img
src="/user_assets/images/<%= service.service_image %>"
class="current-image"
alt="Service Image">

</div>

<div class="col-md-4">

<label class="form-label">

Service Title

</label>

<input
type="text"
name="service_title"
value="<%= service.service_title %>"
class="form-control">

</div>

<div class="col-md-4">

<label class="form-label">
Service Slug
</label>

<input
type="text"
name="service_slug"
value="<%= service.service_slug %>"
class="form-control"
placeholder="website-development-in-ahilyanagar">

</div>

<div class="col-md-4">

<label class="form-label">
Footer CTA Title (Attractive Line)
</label>

<input
type="text"
name="cta_title"
value="<%= service.cta_title || '' %>"
class="form-control"
placeholder="e.g., Get your amazing website developed here!">

</div>

</div>

<br>



<div class="row">

<div class="col-md-6">
<label class="form-label">Point 1</label>
<input type="text"
name="point1"
value="<%= service.point1 %>"
class="form-control">
</div>

<div class="col-md-6">
<label class="form-label">Point 2</label>
<input type="text"
name="point2"
value="<%= service.point2 %>"
class="form-control">
</div>

</div>

<br>

<div class="row">

<div class="col-md-6">
<label class="form-label">Point 3</label>
<input type="text"
name="point3"
value="<%= service.point3 %>"
class="form-control">
</div>

<div class="col-md-6">
<label class="form-label">Point 4</label>
<input type="text"
name="point4"
value="<%= service.point4 %>"
class="form-control">
</div>

</div>

<br>

<label class="form-label">

Service Description

</label>

<textarea
name="service_description"
rows="8"
class="form-control"><%= service.service_description %></textarea>

<br>

<label class="form-label">

SEO Title

</label>

<input
type="text"
name="seo_title"
value="<%= service.seo_title %>"
class="form-control">

<br>

<label class="form-label">

Meta Description

</label>

<textarea
name="meta_description"
rows="3"
class="form-control"><%= service.meta_description %></textarea>

<br>

<label class="form-label">

Meta Keywords

</label>

<textarea
name="meta_keywords"
rows="3"
class="form-control"><%= service.meta_keywords %></textarea>

<br>

<label class="form-label">

SEO Content

</label>

<textarea
name="seo_content"
rows="6"
class="form-control"><%= service.seo_content %></textarea>

<br>

<label class="form-label">

    <br>

<h4 class="mb-4 text-primary fw-bold">
    FAQ Section
</h4>

<% for(let i=1; i<=10; i++){ %>

<div class="row mb-3">

    <div class="col-md-6">

        <label class="form-label">
            FAQ Question <%= i %>
        </label>

        <input
            type="text"
            name="faq_question<%= i %>"
            value="<%= service['faq_question'+i] || '' %>"
            class="form-control">

    </div>

    <div class="col-md-6">

        <label class="form-label">
            FAQ Answer <%= i %>
        </label>

        <textarea
            name="faq_answer<%= i %>"
            rows="2"
            class="form-control"><%= service['faq_answer'+i] || '' %></textarea>

    </div>

</div>

<% } %>

<br>

Status

</label>

<select
name="status"
class="form-select">

<option value="Active"
<%= service.status=="Active"?"selected":"" %>>
Active
</option>

<option value="Inactive"
<%= service.status=="Inactive"?"selected":"" %>>
Inactive
</option>

</select>

<br>

<div class="text-center">

<button class="update-btn">

Update Service

</button>

</div>

</form>

</div>

</div>

</body>
</html>
<%- include('footer.ejs') %>