<%- include('navbar.ejs') %>

<form action="/admin/save_business" method="post" enctype="multipart/form-data">

    <div class="container border shadow p-5 mt-5 bg-white" style="width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <h3 class="font-weight-bold text-center alert alert-primary p-3">Add Best Business Solution</h3>
            </div>
            <div class="col-md-6 mt-3">
                <label class="font-weight-bold" for="">Upload Image</label>
                <input type="file" accept="image/*" name="business_image" value="" class="form-control">
            </div>
            <div class="col-md-6 mt-3">
                <label class="font-weight-bold" for="">Enter Business Title</label>
                <input type="text" name="business_title"  class="form-control">
            </div>
            <div class="col-md-12 mt-3">
                <label class="font-weight-bold" for="">Enter Button (Link)</label>
                <input type="text" name="business_button_link"  class="form-control">
            </div>
            <div class="col-md-12 mt-4 text-center">
                <button class="font-weight-bold btn btn-primary">Save Details</button>
            </div>
        </div>
    </div>
</form>

<%- include('footer.ejs') %>