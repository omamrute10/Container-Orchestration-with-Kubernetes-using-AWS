<%- include('navbar.ejs') %>


    <div class="container border shadow mt-5 p-4 bg-white" style="width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">Industrial Visits List</h3>
            </div>
            <div class="col-12">
                <div class="table-responsive ">
                    <table class="table table-bordered table-striped mt-2">
                        <thead class="thead-dark">
                            <tr>
                                <th class="text-center">Sr.No</th>
                                <th style="white-space: nowrap; width: 10%;">First Name</th>
                                <th style="white-space: nowrap; width: 10%;">Last Name</th>
                                <th style="white-space: nowrap; width: 10%;">Email</th>
                                <th style="white-space: nowrap; width: 10%;">Mobile</th>
                                <th style="white-space: nowrap; width: 10%;">Photo</th>
                                <th style="white-space: nowrap; width: 10%;">Adhar Front</th>
                                <th style="white-space: nowrap; width: 10%;">Adhar Back</th>
                                <th style="white-space: nowrap; width: 10%;">College ID</th>
                            </tr>
                        </thead>
                        <tbody class="p-0">
                            <% for(var i=0; i < industrial_training.length; i++) { %>
                                <tr class="text-dark">
                                    <td class="text-center">
                                        <%= i + 1 %>
                                    </td>
                                    <td>
                                        <%= industrial_training[i].first_name %>
                                    </td>
                                    <td>
                                        <%= industrial_training[i].last_name %>
                                    </td>
                                    <td>
                                        <%= industrial_training[i].email_id %>
                                    </td>
                                    <td>
                                        <%= industrial_training[i].mobile %>
                                    </td>
                                    <td>
                                        <a href="#" data-toggle="modal" data-target="#imageModal"
                                            onclick="showImage('/uploads/<%= industrial_training[i].passport_photo %>')">
                                            <img src="/uploads/<%= industrial_training[i].passport_photo %>"
                                                class="img-thumbnail" style="width: 80px;">
                                        </a>
                                    </td>
                                    <td>
                                        <a href="#" data-toggle="modal" data-target="#imageModal"
                                            onclick="showImage('/uploads/<%= industrial_training[i].adhar_front %>')">
                                            <img src="/uploads/<%= industrial_training[i].adhar_front %>"
                                                class="img-thumbnail" style="width: 80px;">
                                        </a>
                                    </td>
                                    <td>
                                        <a href="#" data-toggle="modal" data-target="#imageModal"
                                            onclick="showImage('/uploads/<%= industrial_training[i].adhar_back %>')">
                                            <img src="/uploads/<%= industrial_training[i].adhar_back %>"
                                                class="img-thumbnail" style="width: 80px;">
                                        </a>
                                    </td>
                                    <td>
                                        <a href="#" data-toggle="modal" data-target="#imageModal"
                                            onclick="showImage('/uploads/<%= industrial_training[i].college_ID %>')">
                                            <img src="/uploads/<%= industrial_training[i].college_ID %>"
                                                class="img-thumbnail" style="width: 80px;">
                                        </a>
                                    </td>
                                </tr>
                                <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Image Modal -->
    <div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imageModalLabel">Image Preview</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center">
                    <img id="modalImage" src="" class="img-fluid">
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript for Image Preview -->
    <script>
        function showImage(src) {
            document.getElementById('modalImage').src = src;
        }
    </script>

    <%- include('footer.ejs') %>