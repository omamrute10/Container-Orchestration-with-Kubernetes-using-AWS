<%- include('navbar.ejs') %>

    <div class="container border shadow mt-5 p-4 bg-white" style="width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">Job Applications List</h3>
            </div>
            <div class="col-12">
            <div class="table-responsive ">
                <table class="table table-bordered table-striped mt-4">
                    <thead class="thead-dark">
                        <tr>
                            <th>Action</th>
                            <th>Sr.No</th>
                            <th>Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Job Role</th>
                            <th>Experience</th>
                            <th>Resume</th>
                        </tr>
                    </thead>
                    <tbody class="p-0">
                        <% for(var i=0; i < applications.length; i++) { %>
                            <tr class="text-dark">
                                <td class="text-center">
                                    <a style="text-decoration: none;"
                                        href="/admin/delete_job_applications/<%= applications[i].applications_id %>"
                                        onclick="return confirm('Are You Sure')">
                                        <button class="btn btn-danger"><i class="fa fa-trash"></i></button>
                                    </a>
                                </td>
                                <td>
                                    <%= i + 1 %>
                                </td>
                                <td>
                                    <%= applications[i].name %>
                                </td>
                                <td>
                                    <%= applications[i].mobile %>
                                </td>
                                <td>
                                    <%= applications[i].email %>
                                </td>
                                <td>
                                    <%= applications[i].job_roles %>
                                </td>
                                <td>
                                    <%= applications[i].experience %>
                                </td>
                                <td><img src="/uploads/<%= applications[i].resume %>" style="height: 60px;"
                                        alt="resume"></td>
                            </tr>
                            <% } %>
                    </tbody>
                </table>
</div>
            </div>
        </div>
    </div>

    <%- include('footer.ejs') %>