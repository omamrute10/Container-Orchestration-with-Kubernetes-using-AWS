<%- include('navbar.ejs') %>

<form action="/admin/update_company_policy" method="post" enctype="multipart/form-data">

    <div class="container border shadow p-5 mt-5 bg-white" style="width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <input type="hidden" name="policy_id" value="<%=company_policy.policy_id %>">
                <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">Our Company Policy</h3>
            </div>
            <div class="col-md-3 mb-4 mt-3">
                <label class="font-weight-bold" for="">Upload Image</label>
                <input type="file" accept="image/*" name="company_policy_image" value="" class="form-control">
            </div>
            <div class="col-md-3 mb-2 mt-2">
                <img src="/uploads/<%=company_policy.company_policy_image %>" class="w-100">
            </div>
            <div class="col-md-6 mb-4 mt-3">
                <label class="font-weight-bold" for="">Enter Course Title</label>
                <input type="text" name="company_policy_title" value="<%=company_policy.company_policy_title %>" class="form-control">
            </div>
            <div class="col-md-12 mb-4 mt-3">
                <label class="font-weight-bold" for="">Enter Description</label>
                <textarea name="company_policy_description"  class="form-control"><%-company_policy.company_policy_description %></textarea>
            </div>
            <div class="col-md-12 text-center">
                <button class="font-weight-bold btn btn-primary">Save Details</button>
            </div>
        </div>
    </div>
</form>

<%- include('footer.ejs') %>
