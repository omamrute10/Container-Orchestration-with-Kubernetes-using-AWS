<%- include('navbar.ejs') %>

<form action="/admin/update_gallery" method="post" enctype="multipart/form-data">

    <div class="container border shadow p-5 mt-5 bg-white" style="width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <input type="hidden" name="image_id" value="<%=gallery.image_id%>">
                <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">Add New Course</h3>
            </div>
            <div class="col-md-10 mb-4 mt-3">
                <label class="font-weight-bold" for="">Upload Image</label>
                <input type="file" accept="image/*" name="gallery_image" value="" class="form-control">
            </div>
            <div class="col-md-2 mb-2 mt-2">
                <img src="/uploads/<%=gallery.gallery_image%>" class="w-100">
            </div>
            <div class="col-md-12 text-center">
                <button class="font-weight-bold btn btn-primary">Update Gallery</button>
            </div>
        </div>
    </div>
</form>


<%- include('footer.ejs') %>