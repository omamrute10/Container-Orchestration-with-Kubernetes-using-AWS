<%- include('navbar.ejs') %>


    <form action="/admin/save_about_kanak" method="post" enctype="multipart/form-data">

        <div class="container border shadow p-5 mt-5 bg-white">
            <div class="row">
                <div class="col-md-12">
                    <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">About Kanak Digifex</h3>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="font-weight-bold" for="">Enter Heading</label>
                    <input type="text" name="about_heading" value="<%= about_kanak.about_heading %>" class="form-control">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="font-weight-bold" for="">Enter Sub-Heading</label>
                    <input type="text" name="about_sub_heading" value="<%= about_kanak.about_sub_heading %>" class="form-control">
                </div>
                <div class="col-md-12 mb-3">
                    <label class="font-weight-bold" for="">Enter Description</label>
                    <textarea name="about_description" class="form-control"><%- about_kanak.about_description %></textarea>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="font-weight-bold" for="">Enter Button Link</label>
                    <input type="text" name="about_button_link" value="<%= about_kanak.about_button_link %>" class="form-control">
                </div>
                <div class="col-md-6 mb-4">
                    <label class="font-weight-bold" for="">Upload Image</label>
                    <input type="file" accept="image/*" name="about_image" value="" class="form-control">
                </div>
                <div class="col-md-2 mb-2 mt-2">
                    <img src="/uploads/<%= about_kanak.about_image %>" class="w-100" style="height: 100px;">
                </div>
                <div class="col-md-12 text-center mt-3">
                    <button class="font-weight-bold btn btn-primary">Save Details</button>
                </div>
            </div>
        </div>
    </form>


<%- include('footer.ejs') %>