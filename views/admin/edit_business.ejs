<%- include('navbar.ejs') %>

<form action="/admin/update_business" method="post" enctype="multipart/form-data">

    <div class="container border shadow p-5 mt-5 bg-white" style="width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <input type="hidden" name="business_id" value="<%=business_info.business_id%>">
                <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">Add New Course</h3>
            </div>
            <div class="col-md-8 mb-4 mt-3">
                <label class="font-weight-bold" for="">Upload Image</label>
                <input type="file" accept="image/*" name="business_image" value="" class="form-control">
            </div>
            <div class="col-md-4 mb-2 mt-2">
                <img src="/uploads/<%=business_info.business_image%>" class="w-100">
            </div>
            <div class="col-md-6 mb-4 mt-3">
                <label class="font-weight-bold" for="">Enter Course Title</label>
                <input type="text" name="business_title" value="<%=business_info.business_title%>"  class="form-control">
            </div>
            <div class="col-md-6 mb-4 mt-3">
                <label class="font-weight-bold" for="">Enter Button (Link)</label>
                <input type="text" name="business_button_link" value="<%=business_info.business_button_link%>" class="form-control">
            </div>
            <div class="col-md-12 text-center">
                <button class="font-weight-bold btn btn-primary">Update Details</button>
            </div>
        </div>
    </div>
</form>


<%- include('footer.ejs') %>