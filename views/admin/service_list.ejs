<%- include('navbar.ejs') %>
<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<title>Service List</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>

.service-card{

    background:white;
    border-radius:12px;
    padding:20px;
    box-shadow:0 3px 12px rgba(0,0,0,.08);

}

.page-title{

    background:#dbeeff;
    text-align:center;
    padding:20px;
    font-size:35px;
    font-weight:700;
    color:#003b82;
    border-radius:8px;
    margin-bottom:25px;

}

.table img{

    width:80px;
    height:50px;
    object-fit:cover;
    border-radius:5px;

}

.action-btn{

    width:40px;
    height:40px;
    border:none;
    border-radius:5px;
    color:white;
    font-size:15px;

}

.delete-btn{

    background:#e74c3c;

}

.edit-btn{

    background:#0d6efd;

}

.action-btn:hover{

    opacity:.8;

}

.table th{

    background:#1f2329;
    color:white;

}

</style>

</head>

<body>

<div class="container mt-4">

<div class="service-card">

<div class="page-title">

OUR SERVICES LIST

</div>

<table class="table table-bordered align-middle">

<thead>

<tr>

<th width="140">Action</th>

<th>Sr.No</th>

<th>Image</th>

<th>Service Title</th>

</tr>

</thead>

<tbody>

<%
let sr=1;

services.forEach(function(service){
%>

<tr>

<td>

<a href="/admin/delete_service/<%= service.service_id %>"
onclick="return confirm('Delete Service ?')">

<button class="action-btn delete-btn">

<i class="fa fa-trash"></i>

</button>

</a>

<a href="/admin/edit_service/<%= service.service_id %>">

<button class="action-btn edit-btn">

<i class="fa fa-pen"></i>

</button>

</a>

</td>

<td>

<%= sr++ %>

</td>

<td>

<img
src="/user_assets/images/<%= service.service_image %>"
class="current-image"
alt="Service Image">

</td>

<td>

<%= service.service_title %>

</td>

</tr>

<%
});
%>

</tbody>

</table>

</div>

</div>

</body>

</html>
<%- include('footer.ejs') %>