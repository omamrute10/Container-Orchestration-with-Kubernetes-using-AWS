<head>
    <title>Our Services | Kanak Digifex NextGen Pvt. Ltd.</title>

    <meta charset="UTF-8">

    <meta name="keywords"
        content="website development Ahmednagar, mobile app development, AI IoT development, software company Ahmednagar, digital marketing company, graphic designing services">

    <meta name="description"
        content="Kanak Digifex provides website development, app development, AI & IoT solutions, software development, digital marketing and business solutions.">

    <meta name="author" content="Kanak Digifex NextGen Pvt. Ltd.">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<%- include("header.ejs") %>

<style>

/*========== SERVICES PAGE CSS START ==========*/

/*========== SERVICES PAGE CSS START ==========*/

.services-section{
    padding: 60px 0;
    background: #f8f9fc;
}

.services-card{
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    transition: 0.4s ease;
    box-shadow: 0 5px 25px rgba(0,0,0,0.08);
    height: 100%;
}

.services-card:hover{
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

/* Image */

.services-image{
    overflow: hidden;
}

.services-image img{
    width: 100%;
    height: 220px;
     object-fit: fill; 
    transition: 0.5s ease;
}

.services-card:hover .services-image img{
    transform: scale(1.05);
}

/* Content Area */

.services-content{
    padding: 14px 16px;
}

/* Title */

.services-content h3{
    font-size: 21px;
    font-weight: 700;
    color: #111;
    margin-bottom: 8px;   /* Reduced from 20px */
    line-height: 1.3;
}

/* Link */

.service-link{
    text-decoration: none;
    color: #111;
    transition: 0.3s;
}

.service-link:hover{
    color: #c056fc;
}

/* Points List */

.services-points{
    list-style: none;
    padding: 0;
    margin: 0;
}

.services-points li{
    position: relative;
    padding: 8px 0 8px 30px; /* Reduced from 12px */
    border-bottom: 1px dashed #d7d7d7;
    color: #555;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
}

.services-points li:last-child{
    border-bottom: none;
}

/* Check Icon */

.services-points li::before{
    content: "✓";
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 18px;
    background: linear-gradient(135deg,#7b2ff7,#c056fc);
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
}

/* Mobile */

@media(max-width:767px){

    .services-content{
        padding: 12px;
    }

    .services-content h3{
        font-size: 20px;
        margin-bottom: 6px;
    }

    .services-image img{
        height: 200px;
    }

    .services-points li{
        font-size: 14px;
        padding: 7px 0 7px 28px;
    }
}

/*========== SERVICES PAGE CSS END ==========*/
/*========== SERVICES PAGE CSS END ==========*/

</style>

<!--========== Banner Start ==========-->

<section class="inner-banner">

    <div class="main-banner-bg-shape">
        <div class="shape-1"></div>
        <div class="shape-2"></div>
    </div>

    <div class="inner-banner-bg-aliment-wp">

        <div class="bg-aliment-1 rotate-animation">
            <img src="/user_assets/images/aliment-01.svg" width="30" height="30">
        </div>

        <div class="bg-aliment-2 animate-this">
            <img src="/user_assets/images/aliment-02.svg" width="26" height="22">
        </div>

        <div class="bg-aliment-3 zoom-fade-animation">
            <img src="/user_assets/images/aliment-03.svg" width="44" height="44">
        </div>

        <div class="bg-aliment-4 rotate-animation">
            <img src="/user_assets/images/aliment-01.svg" width="30" height="30">
        </div>

        <div class="bg-aliment-5 animate-this">
            <img src="/user_assets/images/aliment-04.svg" width="26" height="22">
        </div>

    </div>

    <div class="container">

        <div class="row">

            <div class="col-lg-12">

                <div class="banner-content text-center">

                    <h1 class="h1-title mb-2">Our Services</h1>

                    <div class="banner-breadcrum">

                        <ul>
                            <li><a href="/">Home</a></li>

                            <li>
                                <i class="fa-solid fa-angle-right"></i>
                            </li>

                            <li>
                                <a href="/services">Services</a>
                            </li>
                        </ul>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!--========== Banner End ==========-->



<!--========== Services Section Start ==========-->

<section class="services-section">

<div class="container">

<div class="row g-4">

<% for(var i=0; i<services.length; i++) { %>

<div class="col-lg-3 col-md-6">

    <div class="services-card">

        <div class="services-image">
        <img src="/user_assets/images/<%= services[i].service_image %>" alt="">
        </div>

        <div class="services-content">

            <h3>
            <a href="/service/<%= services[i].service_slug %>" class="service-link">
    <%= services[i].service_title %>
</a>
            </h3>

            <ul class="services-points">
                <li><%= services[i].point1 %></li>
                <li><%= services[i].point2 %></li>
                <li><%= services[i].point3 %></li>
                <li><%= services[i].point4 %></li>
            </ul>

        </div>

    </div>

</div>

<% } %>

</div>
 </div>

    </div>

</section>

<!--========== Services Section End ==========-->

<%- include("footer.ejs") %>