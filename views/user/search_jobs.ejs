        <script>
            $(document).ready(function () {
                let currentStep = 1;
                const totalSteps = 5;

                function showStep(step) {
                    $('.form-step').removeClass('active');
                    $('#step-' + step).addClass('active');
                }

                $('.next-btn').click(function () {
                    if (currentStep < totalSteps) {
                        currentStep++;
                        showStep(currentStep);
                    }
                });

                $('.prev-btn').click(function () {
                    if (currentStep > 1) {
                        currentStep--;
                        showStep(currentStep);
                    }
                });

                $('#jobTitles').change(function () {
                    let selected = $(this).val();
                    if (selected.length > 3) {
                        $('#jobError').text('You can select up to 3 job titles only.');
                        $(this).val(selected.slice(0, 3));
                    } else {
                        $('#jobError').text('');
                    }
                });
            });
        </script>

        <script>
            $(document).ready(function () {
                let selectedJobs = [];

                $('.job-btn').click(function () {
                    let job = $(this).attr('data-value');

                    if ($(this).hasClass('selected')) {
                        // Remove job from list
                        selectedJobs = selectedJobs.filter(item => item !== job);
                        $(this).removeClass('selected');
                    } else {
                        if (selectedJobs.length < 3) {
                            selectedJobs.push(job);
                            $(this).addClass('selected');
                        } else {
                            $('#jobError').text('You can only select up to 3 job titles.');
                            return;
                        }
                    }

                    updateSelectedJobs();
                    $('#jobError').text('');
                });

                function updateSelectedJobs() {
                    $('#selectedJobs').html('');
                    selectedJobs.forEach(job => {
                        $('#selectedJobs').append(
                            `<span class="selected-job-badge">${job} <i class="fa fa-times remove-job" data-value="${job}"></i></span>`
                        );
                    });
                }

                $(document).on('click', '.remove-job', function () {
                    let jobToRemove = $(this).attr('data-value');
                    selectedJobs = selectedJobs.filter(job => job !== jobToRemove);
                    $('.job-btn[data-value="' + jobToRemove + '"]').removeClass('selected');
                    updateSelectedJobs();
                });
            });
        </script>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const jobButtons = document.querySelectorAll(".job-btn");
                const selectedJobsContainer = document.getElementById("selectedJobs");
                const jobError = document.getElementById("jobError");
                const nextButton = document.querySelector("#step-2 .next-btn");
                let selectedJobs = [];

                jobButtons.forEach(button => {
                    button.addEventListener("click", function () {
                        const jobTitle = this.getAttribute("data-value");

                        if (selectedJobs.includes(jobTitle)) {
                            // Remove if already selected
                            selectedJobs = selectedJobs.filter(job => job !== jobTitle);
                            this.classList.remove("btn-success");
                            this.classList.add("btn-primary");
                        } else {
                            if (selectedJobs.length < 3) {
                                // Add if less than 3 selected
                                selectedJobs.push(jobTitle);
                                this.classList.remove("btn-primary");
                                this.classList.add("btn-success");
                            } else {
                                jobError.innerText = "You can select up to 3 job titles only.";
                                return;
                            }
                        }

                        // Update UI
                        selectedJobsContainer.innerHTML = selectedJobs.map(job => `<span class="badge bg-success me-2">${job}</span>`).join("");
                        jobError.innerText = selectedJobs.length === 0 ? "Please select at least one job title." : "";

                        // Enable/Disable Next Button
                        nextButton.disabled = selectedJobs.length === 0;
                    });
                });

                // Initially disable Next button
                nextButton.disabled = true;
            });

        </script>

