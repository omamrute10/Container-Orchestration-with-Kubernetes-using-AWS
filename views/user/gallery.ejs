<head>
    <title>Kanak Digifex NextGen Pvt. Ltd | Data Science & Data Analytics Course in Ahilyanagar / Ahmednagar</title>
    <meta charset="UTF-8">
    <meta name="keywords"
        content="data science course Ahmednagar, data analytics course Ahmednagar, machine learning course Ahmednagar, IT training institute Ahmednagar, best data science course Ahmednagar, graphic design company Ahmednagar, Java full stack course Ahmednagar, cloud computing course Ahmednagar, digital marketing course Ahmednagar">
    <meta name="description"
        content="Kanak Digifex – Ahmednagar’s trusted IT partner offering expert-led data science and data analytics courses along with web & app development, digital marketing, and cloud software solutions.">
    <meta name="author" content="Kanak Digifex NextGen Pvt. Ltd.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>


<%- include("header.ejs") %>

    <!-- Banner Start -->
    <section class="inner-banner">
        <div class="main-banner-bg-shape">
            <div class="shape-1"></div>
            <div class="shape-2"></div>
        </div>
        <div class="inner-banner-bg-aliment-wp">
            <div class="bg-aliment-1 rotate-animation">
                <img src="/user_assets/images/aliment-01.svg" width="30" height="30" alt="Aliment">
            </div>
            <div class="bg-aliment-2 animate-this">
                <img src="/user_assets/images/aliment-02.svg" width="26" height="22" alt="Aliment">
            </div>
            <div class="bg-aliment-3 zoom-fade-animation">
                <img src="/user_assets/images/aliment-03.svg" width="44" height="44" alt="Aliment">
            </div>
            <div class="bg-aliment-4 rotate-animation">
                <img src="/user_assets/images/aliment-01.svg" width="30" height="30" alt="Aliment">
            </div>
            <div class="bg-aliment-5 animate-this">
                <img src="/user_assets/images/aliment-04.svg" width="26" height="22" alt="Aliment">
            </div>
            <div class="bg-aliment-6 zoom-fade-animation">
                <img src="/user_assets/images/aliment-03.svg" width="44" height="44" alt="Aliment">
            </div>
            <div class="bg-aliment-7 rotate-animation">
                <img src="/user_assets/images/aliment-05.svg" width="30" height="30" alt="Aliment">
            </div>
            <div class="bg-aliment-8 animate-this">
                <img src="/user_assets/images/aliment-06.svg" width="19" height="16" alt="Aliment">
            </div>
            <div class="bg-aliment-9 zoom-fade-animation">
                <img src="/user_assets/images/aliment-03.svg" width="29" height="29" alt="Aliment">
            </div>
            <div class="bg-aliment-10 rotate-animation">
                <img src="/user_assets/images/aliment-09.svg" width="30" height="30" alt="Aliment">
            </div>
            <div class="bg-aliment-11 animate-this">
                <img src="/user_assets/images/aliment-08.svg" width="34" height="34" alt="Aliment">
            </div>
            <div class="bg-aliment-12 animate-this">
                <img src="/user_assets/images/aliment-10.svg" width="26" height="22" alt="Aliment">
            </div>
            <div class="bg-aliment-13 rotate-animation">
                <img src="/user_assets/images/aliment-11.svg" width="30" height="30" alt="Aliment">
            </div>
            <div class="bg-aliment-14 animate-this">
                <img src="/user_assets/images/aliment-07.svg" width="38" height="32" alt="Aliment">
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="banner-content text-center">
                        <h1 class="h1-title">Captured Moments</h1>
                        <div class="banner-breadcrum">
                            <ul>
                                <li><a href="/" title="Home">Home</a></li>
                                <li><i class="fa-solid fa-angle-right"></i></li>
                                <li><a href="/gallery" title="Course">Gallery</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Banner End -->

    <div class="container mb-5 mt-4 gallery-container">
        <h1 class="h1-title mb-5 text-center">Showcasing Our Journey and Achievements</h1>

        <div class="row g-4">
            <% for(i=0;i<gallery.length;i++) { %>
                <div class="col-12 col-sm-6 col-md-6 col-lg-4 mb-4" data-aos="zoom-in" data-aos-delay="<%=i*100%>">
                    <div class="gallery-card" data-bs-toggle="modal" data-bs-target="#imageModal"
                        onclick="openImageModal('/uploads/<%=gallery[i].gallery_image%>')">
                        <div class="gallery-img-container">
                            <img src="/uploads/<%=gallery[i].gallery_image%>" alt="Gallery image <%=i+1%>"
                                class="img-fluid rounded-4 gallery-image" loading="lazy">
                            <div class="gallery-overlay">
                                <div class="overlay-content">
                                    <i class="bi bi-zoom-in overlay-icon"></i>
                                    <p class="overlay-text">Click to view</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
        </div>
    </div>

    <!-- Image Modal -->
    <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-header border-0">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="modalImage" src="" class="img-fluid rounded-3" alt="Full size image">
                    <h5 class="text-white mt-3" id="modalTitle"></h5>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openImageModal(imageSrc, title) {
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('modalTitle').textContent = title;
        }
    </script>

    <style>
        .gallery-container {
            padding: 2rem 0;
        }

        .gallery-card {
            position: relative;
            overflow: hidden;
            border-radius: 1rem;
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            height: 100%;
            background: #fff;
            cursor: pointer;
        }

        .gallery-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.2);
        }

        .gallery-img-container {
            position: relative;
            padding-top: 100%;
            overflow: hidden;
        }

        .gallery-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .gallery-card:hover .gallery-image {
            transform: scale(1.05);
        }

        .gallery-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            opacity: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.3s ease;
            border-radius: 1rem;
        }

        .gallery-card:hover .gallery-overlay {
            opacity: 1;
        }

        .overlay-content {
            text-align: center;
            color: white;
            transform: translateY(20px);
            transition: transform 0.3s ease;
        }

        .gallery-card:hover .overlay-content {
            transform: translateY(0);
        }

        .overlay-icon {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }

        .overlay-text {
            font-size: 1rem;
            margin-bottom: 0;
        }

        /* Modal Styles */
        .modal-content {
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
        }

        #modalImage {
            max-height: 80vh;
            max-width: 100%;
            object-fit: contain;
        }
    </style>

    <%- include("footer.ejs") %>