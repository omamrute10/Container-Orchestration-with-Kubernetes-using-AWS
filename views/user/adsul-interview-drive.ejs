<style>
    :root {
        --primary-color: #6a11cb;
        --secondary-color: #c95afc;
        --accent-color: #c95afc;
        --dark-color: #c95afc;
        --light-color: #f8f9fa;
    }

    body {
        background: linear-gradient(135deg, rgba(70, 186, 231, 0.1), rgba(175, 11, 78, 0.1));
        font-family: 'Poppins', sans-serif;
        background-attachment: fixed;
    }

    .form-container {
        max-width: 800px;
        margin: 50px auto;
        margin-bottom: 20px;
        padding: 0 15px;
    }

    .registration-card {
        border-radius: 16px;
        background-color: white;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border: none;
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    .registration-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 8px;
        background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
        z-index: 2;
    }

    .header-title {
        font-size: 28px;
        color: var(--dark-color);
        font-weight: 700;
        margin-bottom: 20px;
        position: relative;
        padding-bottom: 10px;
    }

    .header-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
        border-radius: 2px;
    }

    .sub-header {
        color: var(--dark-color);
        margin-bottom: 20px;
        margin-top: 20px;
        font-weight: 600;
        font-size: 18px;
    }

    .description {
        color: #555;
        font-size: 16px;
        line-height: 1.7;
        text-align: justify;
        font-weight: 400;
    }

    .website-link a {
        font-weight: 600;
        color: var(--accent-color);
        text-decoration: none;
        transition: all 0.3s ease;
        position: relative;
    }

    .website-link a:hover {
        color: var(--primary-color);
        text-decoration: none;
    }

    .website-link a::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--primary-color);
        transition: width 0.3s ease;
        text-decoration: none;
    }

    .website-link a:hover::after {
        width: 100%;
    }

    .experience-title {
        font-size: 22px;
        font-weight: 700;
        color: var(--dark-color);
        margin-top: 25px;
        position: relative;
        padding-bottom: 8px;
    }

    .experience-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 40px;
        height: 3px;
        background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
        border-radius: 2px;
    }

    .experience-list {
        padding: 0;
        list-style-type: none;
    }

    .experience-list li {
        font-size: 16px;
        padding: 10px 0;
        color: #555;
        position: relative;
        padding-left: 30px;
        transition: all 0.3s ease;
    }

    .experience-list li:hover {
        color: var(--dark-color);
        transform: translateX(5px);
    }

    .experience-list li::before {
        content: '▹';
        position: absolute;
        left: 0;
        color: var(--secondary-color);
        font-size: 20px;
    }

    .info-banner {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: white;
        text-align: center;
        padding: 15px;
        font-weight: 600;
        border-radius: 8px;
        font-size: 16px;
        margin-top: 25px;
        box-shadow: 0 4px 15px rgba(106, 17, 203, 0.3);
        transition: all 0.3s ease;
    }

    .info-banner:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(106, 17, 203, 0.4);
    }

    .form-group {
        margin-bottom: 25px;
        background-color: white;
        border-radius: 10px;
        padding: 25px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

    .form-group:hover {
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        border-color: rgba(106, 17, 203, 0.2);
    }

    .input-container {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .input-container label {
        font-weight: 600;
        color: var(--dark-color);
        margin-bottom: 8px;
        font-size: 15px;
    }

    .input-container input {
        border: none;
        border-bottom: 2px solid #e0e0e0;
        padding: 10px 0;
        font-size: 16px;
        background: transparent;
        outline: none;
        width: 100%;
        transition: all 0.3s ease;
    }

    .input-container input:focus {
        border-bottom-color: transparent;
    }

    .input-underline {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
        transition: width 0.4s ease;
    }

    .input-container input:focus~.input-underline {
        width: 100%;
    }

    .form-card {
        margin: 25px 0;
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

    .form-card:hover {
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        border-color: rgba(106, 17, 203, 0.2);
    }

    .form-title {
        font-size: 18px;
        color: var(--dark-color);
        margin-bottom: 20px;
        font-weight: 700;
        position: relative;
        padding-bottom: 8px;
    }

    .form-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 30px;
        height: 3px;
        background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
        border-radius: 2px;
    }

    .custom-radio {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        cursor: pointer;
    }

    .custom-input {
        width: 20px;
        height: 20px;
        margin-right: 12px;
        position: relative;
    }

    .custom-radio input[type="radio"] {
        appearance: none;
        width: 20px;
        height: 20px;
        border: 2px solid #ddd;
        border-radius: 50%;
        outline: none;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

    .custom-radio input[type="radio"]:checked {
        border-color: var(--secondary-color);
        background-color: white;
        box-shadow: 0 0 0 5px white, 0 0 0 7px var(--secondary-color);
    }

    .custom-radio label {
        color: #555;
        font-weight: 500;
        font-size: 15px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .custom-radio:hover label {
        color: var(--dark-color);
    }

    .custom-radio input[type="radio"]:checked+label {
        color: var(--secondary-color);
        font-weight: 600;
    }

    .btn-submit {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: white;
        border: none;
        padding: 12px 30px;
        font-size: 16px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(106, 17, 203, 0.3);
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        position: relative;
        overflow: hidden;
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(106, 17, 203, 0.4);
    }

    .btn-submit::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: all 0.5s ease;
    }

    .btn-submit:hover::after {
        left: 100%;
    }

    .btn-clear {
        background: #f8f9fa;
        color: var(--dark-color);
        border: 1px solid #ddd;
        padding: 12px 30px;
        font-size: 16px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-left: 15px;
    }

    .btn-clear:hover {
        background: #e9ecef;
        border-color: #ccc;
    }

    .btn-group {
        display: flex;
        justify-content: center;
        margin-top: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

    /* Floating animation for decorative elements */
    @keyframes floating {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-10px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .floating-element {
        animation: floating 3s ease-in-out infinite;
    }

    /* Responsive adjustments */
    @media (max-width: 767.98px) {
        .form-container {
            padding: 0 10px;
        }

        .header-title {
            font-size: 24px;
        }

        .form-card,
        .form-group {
            padding: 20px;
        }

        .btn-group {
            flex-direction: column;
            align-items: center;
        }

        .btn-clear {
            margin-left: 0;
            margin-top: 15px;
        }
    }

    @media (max-width: 575.98px) {
        .header-title {
            font-size: 22px;
        }

        .experience-list li {
            font-size: 15px;
            padding-left: 25px;
        }

        .form-title {
            font-size: 16px;
        }

        .btn-submit,
        .btn-clear {
            padding: 10px 20px;
            font-size: 14px;
        }
    }

    .h1-title span {
        display: block;
        font-size: 1.2rem;
        font-weight: 500;
        margin-top: -5px;
    }

    @media (max-width: 576px) {
        .h1-title span {
            font-size: 1rem;
            margin-top: 0;
        }

        .btn-clear {
            margin-left: 44px;
        }

        .btn-submit {
            margin-left: 40px;

        }
    }
</style>

