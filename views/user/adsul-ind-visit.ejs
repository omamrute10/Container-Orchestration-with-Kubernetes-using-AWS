                        <h4 class="form-title">Would You Like To Get Information About Internship, Job Openings, Current
                            Updates in IT Industry on Your WhatsApp?</h4>

                        <div class="row">
                            <div class="col-md-2">
                                <div class="custom-radio">
                                    <input type="radio" id="job-alerts-yes" value="job-alerts-yes" name="job_alerts"
