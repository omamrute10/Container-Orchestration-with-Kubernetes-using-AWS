<!-- Apply Now Start -->
<section class="apply-now-sec">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="apply-now-box wow fadeup-animation" data-wow-duration="0.8s" data-wow-delay="0.2s">
                    <div class="apply-now-shape animate-this">
                        <img src="/user_assets/images/newsletter-bg-shape.svg" width="838" height="488"
                            alt="Apply Now Background Shape">
                    </div>
                    <div class="apply-now-content">
                        <div class="apply-now-image-box">
                            <img src="/user_assets/images/apply-now-image.png" width="305" height="287"
                                alt="Apply Now Image">
                        </div>
                       <div class="apply-now-text">
    <div class="sec-title">
        <!-- 1) Hide "Apply Now" text on service detail screen, show on all others -->
        <% if (typeof service === 'undefined') { %>
            <span class="sub-title">Apply Now</span>
        <% } %>

        <h3 class="h3-title">
            <% if (typeof service !== 'undefined' && service.cta_title) { %>
                <%= service.cta_title %>
            <% } else { %>
                Get Your Best Skills Certificate Now!
            <% } %>
        </h3>
    </div>
    
    <div class="apply-now-btn">
        <!-- 2) Custom WhatsApp redirect for service screen; standard route fallback for others -->
        <% if (typeof service !== 'undefined') { %>
            <% 
                
                let whatsappText = encodeURIComponent("Hello, I am interested in your " + service.service_title + " service. Please provide more details.");
            %>
            <a href="https://wa.me/919167776161?text=<%= whatsappText %>" target="_blank" class="sec-btn">
                <span>Get Started</span>
            </a>
        <% } else { %>
            <a href="/get-certificate" class="sec-btn">
                <span>Get Started</span>
            </a>
        <% } %>
    </div>
</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Apply Now End -->

