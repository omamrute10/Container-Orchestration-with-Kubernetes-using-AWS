<script> document.querySelectorAll('.faq-question').forEach(button => { button.addEventListener('click', () => { const item = button.parentElement; const isActive = item.classList.contains('active'); document.querySelectorAll('.faq-item').forEach(i => { i.classList.remove('active'); }); if(!isActive){ item.classList.add('active'); } }); }); </script>
