<head>
   <title>
<%= service.seo_title ? service.seo_title : service.service_title %>
</title>

    <meta charset="UTF-8">

    <meta name="description"
      content="<%= service.meta_description %>">

   <meta name="keywords"
      content="<%= service.meta_keywords %>">

    <meta name="author" content="Kanak Digifex NextGen Pvt. Ltd.">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<%- include("header.ejs") %>

<style>

/*========== SERVICES PAGE CSS START ==========*/

.services-section{
    padding: 80px 0;
    background: #f8f9fc;
}

.services-card{
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    transition: 0.4s ease;
    box-shadow: 0 5px 25px rgba(0,0,0,0.08);
    height: 100%;
}

.services-card:hover{
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

.services-image{
    overflow: hidden;
}

.services-image img{
    width: 100%;
    height: 240px;
    object-fit: cover;
    transition: 0.5s ease;
}

.services-card:hover .services-image img{
    transform: scale(1.05);
}

.services-content{
    padding: 25px;
}

.services-content h3{
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 20px;
    color: #111;
}

.services-points{
    list-style: none;
    padding: 0;
    margin: 0;
}

.services-points li{
    position: relative;
    padding: 12px 0 12px 35px;
    border-bottom: 1px dashed #d7d7d7;
    color: #555;
    font-size: 15px;
    font-weight: 500;
}

.services-points li:last-child{
    border-bottom: none;
}

.services-points li::before{
    content: "✓";
    position: absolute;
    left: 0;
    top: 10px;
    width: 22px;
    height: 22px;
    background: linear-gradient(135deg,#7b2ff7,#c056fc);
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}

@media(max-width:767px){

.services-content h3{
    font-size: 22px;
}

}

.service-details-section{
    padding:100px 0;
    background:#f8f9fc;
}

.service-image-box{
    overflow:hidden;
    border-radius:20px;
    box-shadow:0 15px 40px rgba(0,0,0,0.12);
}

.service-image-box img{
    width:500px;
    height:500px;
    /* object-fit:cover; */
    display:block;
}

.service-content-box{
    padding-left:40px;
}

.service-subtitle{
    display:inline-block;
    color:#7b2ff7;
    font-size:16px;
    font-weight:600;
    margin-bottom:15px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.service-title{
    font-size:42px;
    font-weight:700;
    color:#111;
    margin-bottom:20px;
    line-height:1.3;
}

.service-description{
    color:#666;
    font-size:16px;
    line-height:1.9;
    margin-bottom:30px;
}

.service-list{
    list-style:none;
    padding:0;
    margin:0;
}

.service-list li{
    position:relative;
    padding:12px 0 12px 35px;
    color:#555;
    border-bottom:1px solid #eee;
}

.service-list li:last-child{
    border-bottom:none;
}

.service-list li::before{
    content:"✓";
    position:absolute;
    left:0;
    top:10px;
    width:22px;
    height:22px;
    background:linear-gradient(135deg,#7b2ff7,#c056fc);
    border-radius:50%;
    color:#fff;
    text-align:center;
    line-height:22px;
    font-size:12px;
}

.service-btn{
    display:inline-block;
    margin-top:30px;
    padding:14px 35px;
    background:linear-gradient(135deg,#7b2ff7,#c056fc);
    color:#fff;
    text-decoration:none;
    border-radius:50px;
    font-weight:600;
    transition:0.3s;
}

.service-btn:hover{
    color:#fff;
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(123,47,247,0.3);
}

@media(max-width:991px){

.service-content-box{
    padding-left:0;
    margin-top:40px;
}

.service-image-box img{
    height:350px;
}

.service-title{
    font-size:32px;
}

}

/*========== SERVICES PAGE CSS END ==========*/

/*===================================
SERVICE DETAILS CSS
===================================*/

.service-details-section{
    padding:80px 0;
    background:#fff;
}

.service-image-box{
    overflow:hidden;
    border-radius:20px;
    box-shadow:0 15px 40px rgba(0,0,0,0.12);
}

.service-image-box img{
    width:100%;
    transition:.6s;
}

.service-image-box:hover img{
    transform:scale(1.06);
}

.service-subtitle{
    display:inline-block;
    background:#f4e8ff;
    color:#7b2ff7;
    padding:8px 18px;
    border-radius:30px;
    font-size:14px;
    font-weight:600;
    margin-bottom:15px;
}

.service-title{
    font-size:42px;
    font-weight:700;
    color:#111;
    margin-bottom:20px;
}

.service-description{
    color:#666;
    line-height:30px;
    margin-bottom:25px;
    text-align:justify;
}

.service-list{
    list-style:none;
    padding:0;
    margin:0 0 30px;
}

.service-list li{
    position:relative;
    padding:12px 0 12px 35px;
    color:#555;
    border-bottom:1px dashed #ddd;
}

.service-list li:last-child{
    border-bottom:none;
}

.service-list li::before{
    content:"✓";
    position:absolute;
    left:0;
    top:11px;
    width:22px;
    height:22px;
    background:linear-gradient(135deg,#7b2ff7,#c056fc);
    color:#fff;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:12px;
}

.service-btn{
    display:inline-block;
    padding:14px 35px;
    background:linear-gradient(135deg,#7b2ff7,#c056fc);
    color:#fff;
    text-decoration:none;
    border-radius:50px;
    font-weight:600;
    transition:.4s;
}

.service-btn:hover{
    color:#fff;
    transform:translateY(-3px);
}

.faq-accordion {
    position: relative;
    z-index: 2;
    max-width: 100%; /* Changed from 980px to fill the grid columns naturally */
    margin: auto;
}

/* Optional tweak to make it look smooth when columns collapse on mobile devices */
@media(max-width: 991px) {
    .faq-accordion {
        margin-bottom: 0;
    }
}
/* =================================================== LUXURY SEO CONTENT SECTION =================================================== */ .seo-luxury-section{ position:relative; padding:100px 0; background:linear-gradient(135deg,#0f172a 0%,#111827 40%,#1f2937 100%); overflow:hidden; } .seo-bg-circle{ position:absolute; border-radius:50%; filter:blur(80px); opacity:.18; animation:float 8s ease-in-out infinite; } .seo-circle-1{ width:280px; height:280px; background:#8b5cf6; top:-60px; left:-80px; } .seo-circle-2{ width:320px; height:320px; background:#06b6d4; bottom:-100px; right:-100px; animation-delay:2s; } .seo-luxury-box{ position:relative; z-index:2; max-width:1100px; margin:auto; background:rgba(255,255,255,0.08); backdrop-filter:blur(14px); border:1px solid rgba(255,255,255,0.12); border-radius:28px; padding:56px; box-shadow:0 30px 60px rgba(0,0,0,.35); } .seo-heading-wrap{ text-align:center; margin-bottom:42px; } .seo-chip{ display:inline-flex; align-items:center; gap:8px; padding:10px 18px; border-radius:999px; background:rgba(139,92,246,.16); color:#c4b5fd; font-size:13px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; } .seo-luxury-title{ font-size:44px; font-weight:800; line-height:1.2; color:#fff; margin:22px 0 14px; } .seo-luxury-subtitle{ max-width:760px; margin:auto; color:rgba(255,255,255,.72); line-height:1.9; font-size:16px; } .seo-content-luxury{ color:rgba(255,255,255,.84); font-size:16px; line-height:2; } .seo-content-luxury h2{ color:#fff; font-size:30px; font-weight:800; margin:34px 0 16px; position:relative; } .seo-content-luxury h2::after{ content:""; position:absolute; left:0; bottom:-8px; width:64px; height:4px; border-radius:999px; background:linear-gradient(90deg,#8b5cf6,#06b6d4); } .seo-content-luxury h3{ color:#fff; font-size:24px; font-weight:700; margin:28px 0 12px; } .seo-content-luxury p{ margin-bottom:18px; } .seo-content-luxury ul{ list-style:none; padding:0; margin:0 0 20px; } .seo-content-luxury li{ position:relative; padding:12px 0 12px 34px; border-bottom:1px solid rgba(255,255,255,.08); } .seo-content-luxury li:last-child{ border-bottom:none; } .seo-content-luxury li::before{ content:"✓"; position:absolute; left:0; top:11px; width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#8b5cf6,#06b6d4); color:#fff; font-size:12px; font-weight:700; box-shadow:0 10px 20px rgba(139,92,246,.35); }
/* =================================================== LUXURY FAQ SECTION =================================================== */ .faq-luxury-section{ position:relative; padding:100px 0 180px 0; background:#f8fafc; overflow:visible; } .faq-bg-circle{ position:absolute; border-radius:50%; filter:blur(80px); opacity:.18; animation:float 10s ease-in-out infinite; } .faq-circle-1{ width:260px; height:260px; background:#8b5cf6; top:-80px; right:-60px; } .faq-circle-2{ width:320px; height:320px; background:#06b6d4; bottom:-120px; left:-120px; animation-delay:3s; } .faq-header{ position:relative; z-index:2; margin-bottom:42px; } .faq-chip{ display:inline-flex; align-items:center; gap:8px; padding:10px 18px; border-radius:999px; background:#ede9fe; color:#6d28d9; font-size:13px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; } .faq-title{ font-size:42px; font-weight:800; color:#0f172a; margin:18px 0 10px; } .faq-subtitle{ color:#64748b; max-width:680px; margin:auto; line-height:1.8; } .faq-accordion{ position:relative; z-index:2; max-width:980px; margin:auto; } .faq-item{ background:#fff; border:1px solid rgba(148,163,184,.18); border-radius:22px; margin-bottom:18px; overflow:hidden; box-shadow:0 18px 40px rgba(15,23,42,.08); transition:.35s ease; } .faq-item:hover{ transform:translateY(-4px); box-shadow:0 24px 50px rgba(15,23,42,.12); } .faq-item.active{ border-color:rgba(139,92,246,.35); } .faq-question{ width:100%; border:none; background:transparent; padding:24px 26px; display:flex; align-items:center; justify-content:space-between; gap:16px; cursor:pointer; text-align:left; } .faq-question span{ font-size:19px; font-weight:700; color:#111827; line-height:1.5; } .faq-question i{ width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#f3f4f6; color:#6b7280; transition:.3s ease; flex-shrink: 0; } .faq-item.active .faq-question i{ transform:rotate(180deg); background:linear-gradient(135deg,#8b5cf6,#06b6d4); color:#fff; } .faq-answer{ max-height:0; overflow:hidden; transition:max-height .45s ease; } .faq-item.active .faq-answer{ max-height:400px; } .faq-answer p{ padding:0 26px 24px; color:#64748b; line-height:1.9; margin:0; } /* =================================================== ANIMATIONS =================================================== */ @keyframes float{ 0%,100%{transform:translateY(0);} 50%{transform:translateY(-14px);} } /* =================================================== RESPONSIVE =================================================== */ @media(max-width:991px){ .seo-luxury-box{ padding:40px 32px; } .seo-luxury-title{ font-size:34px; } .faq-title{ font-size:34px; } } @media(max-width:767px){ .seo-luxury-section, .faq-luxury-section{ padding:70px 0; } .seo-luxury-box{ padding:28px 22px; border-radius:22px; } .seo-luxury-title{ font-size:28px; } .seo-content-luxury h2{ font-size:24px; } .seo-content-luxury h3{ font-size:20px; } .faq-title{ font-size:28px; } .faq-question{ padding:20px 20px; } .faq-question span{ font-size:17px; } .faq-answer p{ padding:0 20px 20px; } }

