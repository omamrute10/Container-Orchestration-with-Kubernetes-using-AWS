    color: #fff;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Hover Effect */
.service-points li:hover {
    color: #0d6efd;
    padding-left: 32px;
}
