<section class="top-course-sec sec-space-top pb-5 pt-5" id="courses">
    <div class="container">
        <div class="top-course-title">
            <div class="row">
                <div class="col-xl-12">
                    <div class="sec-title">
                        <center><span class="sub-title">Top Courses</span></center>
                        <center>
                            <h2 class="h2-title">Industry-Ready Corporate Training Programs</h2>
                        </center>
                    </div>
                </div>
            </div>
        </div>
        <div class="grid wow fadeup-animation" data-wow-duration="0.8s" data-wow-delay="0.4s">

            <% if (typeof course_info !== 'undefined' && course_info && course_info.length > 0) { %>

                <!-- 1. Show course_id = 28 first (if it exists) -->
                <% course_info.forEach(function(course) { %>
                    <% if (course.course_id == 28) { %>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-4 mt-4 mb-3 grid-item pb-0 mb-0" data-type="computer-science" data-aos="zoom-in">
                            <div class="common-post-card border shadow p-4 pb-0 mb-0">
                                
                                <div class="post-image-box-wp mb-0 pb-3">
                                    <div class="post-image" style="height: 170px;">
                                        <a href="/course_details/<%= course.slug %>" title="<%= course.course_title %>">
                                            <img src="/uploads/<%= course.course_image %>" alt="Course Image">
                                        </a>
                                    </div>
                                </div>

                                <div class="common-post-content">
                                    <div class="post-lessons-info">
                                        <ul>
                                            <li>
                                                <span class="post-info-icon">
                                                    <img src="/user_assets/images/book-icon.svg" width="26" height="18" alt="Book Icon">
                                                </span>
                                                <span class="post-info-text">करिअर कौशल्ये</span>
                                            </li>
                                            <li>
                                                <span class="post-info-icon">
                                                    <img src="/user_assets/images/clock-icon.svg" width="20" height="20" alt="Clock Icon">
                                                </span>
                                                <span class="post-info-text"><%= course.course_duration %></span>
                                            </li>
                                        </ul>
                                    </div>

                                    <div class="post-content-title">
                                        <a href="/course_details/<%= course.slug %>" title="<%= course.course_title %>">
                                            <h4 class="h4-title" style="font-size: 20px;"><%= course.course_title %></h4>
                                        </a>
                                    </div>

                                    <div class="post-author-review-info px-3 py-3 mt-3 benefits-card">
                                        <ul class="benefits-list mb-0">
                                            <li>IT क्षेत्राची ओळख करून देण्यासाठी</li>
                                            <li>करिअरला योग्य सुरुवात करण्यासाठी</li>
                                            <li>स्वतःचा व्यवसाय Online वाढवण्यासाठी</li>
                                            <li>नवीन तंत्रज्ञान सहज शिकण्यासाठी</li>
                                            <li>नोकरीसाठी लागणारी कौशल्ये मिळवण्यासाठी</li>
                                            <li>भविष्यातील संधी ओळखण्यासाठी</li>
                                        </ul>
                                    </div>

                                    <div class="course-price mt-3 d-flex justify-content-between align-items-center">
                                        <h4 class="h4-title mb-0">
                                            <%= course.course_price ? '₹' + course.course_price : 'Free' %> /-
                                        </h4>
                                        <a href="/course_details/<%= course.slug %>">
                                            <button class="explore-btn">
                                                <span>Explore More</span>
                                                <i class="fa fa-arrow-right ms-2"></i>
                                            </button>
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    <% } %>
                <% }); %>


                <!-- 2. Show all other courses dynamically -->
                <% course_info.forEach(function(course) { %>
                    <% if (course.course_id != 28) { %>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-4 mt-4 mb-3 grid-item pb-0 mb-0" data-type="computer-science" data-aos="zoom-in">
                            <div class="common-post-card border shadow p-4 pb-0 mb-0">

                                <div class="post-image-box-wp mb-0 pb-3">
                                    <div class="post-image" style="height: 170px;">
                                        <a href="/course_details/<%= course.slug %>" title="<%= course.course_title %>">
                                            <img src="/uploads/<%= course.course_image %>" alt="Course Image">
                                        </a>
                                    </div>
                                </div>

                                <div class="common-post-content">
                                    <div class="post-lessons-info">
                                        <ul>
                                            <li>
                                                <span class="post-info-icon">
                                                    <img src="/user_assets/images/book-icon.svg" width="26" height="18" alt="Book Icon">
                                                </span>
                                                <span class="post-info-text">Career-Ready Skills</span>
                                            </li>
                                            <li>
                                                <span class="post-info-icon">
                                                    <img src="/user_assets/images/clock-icon.svg" width="20" height="20" alt="Clock Icon">
                                                </span>
                                                <span class="post-info-text"><%= course.course_duration %></span>
                                            </li>
                                        </ul>
                                    </div>

                                    <div class="post-content-title">
                                        <a href="/course_details/<%= course.slug %>" title="<%= course.course_title %>">
                                            <h4 class="h4-title"><%= course.course_title %></h4>
                                        </a>
                                    </div>

                                    <div class="post-author-review-info px-3 py-3 mt-3 benefits-card">
                                        <ul class="benefits-list mb-0">
                                            <li>Affordable Monthly Installments</li>
                                            <li>Globally Recognized Certification</li>
                                            <li>Work on Real Client Projects</li>
                                            <li>6-Month Full-Time Internship</li>
                                            <li>Mock Interviews & GD Practice</li>
                                            <li>Soft Skills & Stress Management</li>
                                        </ul>
                                    </div>

                                    <div class="course-price mt-3 d-flex justify-content-between align-items-center">
                                        <h4 class="h4-title mb-0">
                                            <%= course.course_price ? '₹' + course.course_price : 'Free' %> /-
                                        </h4>
                                        <a href="/course_details/<%= course.slug %>">
                                            <button class="explore-btn">
                                                <span>Explore More</span>
                                                <i class="fa fa-arrow-right ms-2"></i>
                                            </button>
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    <% } %>
                <% }); %>

            <% } else { %>
                <div class="col-12 text-center py-4">
                    <p>No courses available at the moment.</p>
                </div>
            <% } %>

        </div>
    </div>
</section>
