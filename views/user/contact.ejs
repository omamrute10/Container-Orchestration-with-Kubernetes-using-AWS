                                    </div>
                                </div>
                            </form>

                            <!-- Google reCAPTCHA script -->
                            <script src="https://www.google.com/recaptcha/api.js" async defer></script>

                            <!-- Optional check (client-side) -->
                            <script>
                                document.addEventListener("DOMContentLoaded", function () {
                                    const form = document.getElementById("captchaForm");
                                    const errorMsg = document.getElementById("captchaError");

                                    form.addEventListener("submit", function (e) {
                                        if (typeof grecaptcha !== "undefined") {
                                            if (grecaptcha.getResponse() === "") {
                                                e.preventDefault();
                                                errorMsg.style.display = "block"; // error दाखवा
                                            } else {
                                                errorMsg.style.display = "none"; // error hide करा
                                            }
                                        } else {
                                            e.preventDefault();
                                            errorMsg.textContent = "Captcha not loaded. Please refresh the page.";
                                            errorMsg.style.display = "block";
                                        }
                                    });
