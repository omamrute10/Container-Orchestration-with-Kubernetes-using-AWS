<%- include('navbar.ejs') %>

    <form action="/admin/save_associates" method="post" enctype="multipart/form-data">

        <div class="container border shadow p-4 mt-5 bg-white" style="width: 100%;">
            <div class="row">
                <div class="col-md-12">
                    <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">Our Associates</h3>
                </div>
                <div class="col-md-12 mb-4">
                    <label class="font-weight-bold" for="">Upload Image</label>
                    <input type="file" accept="image/*" name="associates_image" class="form-control">
                </div>
                <div class="col-md-12 text-center">
                    <button class="font-weight-bold btn btn-primary">Add Image</button>
                </div>
            </div>
        </div>
    </form>


    <div class="container border shadow mt-5 p-4 bg-white" style="width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">Our Associates</h3>
            </div>
            <div class="col-12">
                <table class="table table-bordered table-striped mt-2">
                    <thead class="thead-dark">
                        <tr>
                            <th>Action</th>
                            <th>Sr.No</th>
                            <th>Associates Image</th>
                        </tr>
                    </thead>
                    <tbody class="p-0">
                        <% for(var i=0; i < associates.length; i++) { %>
                            <tr class="text-dark">
                                <td class="text-center" style="white-space: nowrap; width: 10%;">
                                    <a style="text-decoration: none;"
                                        href="/admin/delete_associates/<%= associates[i].image_id %>"
                                        onclick="return confirm('Are You Sure')">
                                        <button class="btn btn-danger"><i class="fa fa-trash"></i></button>
                                    </a>
                                    <a style="text-decoration: none;"
                                        href="/admin/edit_associates/<%= associates[i].image_id %>">
                                        <button class="btn btn-primary"><i class="fa fa-edit"></i></button>
                                    </a>
                                </td>
                                <td>
                                    <%= i + 1 %>
                                </td>
                                <td>
                                    <img src="/uploads/<%= associates[i].associates_image %>" alt="Card Image"
                                        style="max-width: 120px;height: 60px;">
                                </td>
                            </tr>
                            <% } %>
                    </tbody>
                </table>

            </div>
        </div>
    </div>

    <%- include('footer.ejs') %>