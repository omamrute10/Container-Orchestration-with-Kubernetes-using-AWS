<%- include('navbar.ejs') %>

    <div class="container p-5 mt-5 border shadow bg-white font-weight-bold" style="color: black;width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">Update Office Address</h3>
            </div>
            <div class="col-12 mt-4">
                <form action="/admin/update_office" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="office_id" value="<%=office.office_id%>">
                    <label for="">Enter Office Location</label>
                    <input type="text" name="office_location" value="<%=office.office_location%>" class="form-control"
                        required>
                    <br>
                    <label for=""> Enter Office Address</label>
                    <input type="text" name="office_detail_address" value="<%=office.office_detail_address%>"
                        class="form-control" required>
                    <br>
                    <label for=""> Enter Mobile</label>
                    <input type="text" name="office_mobile" value="<%=office.office_mobile%>" class="form-control"
                        required>
                    <br>
                    <label for=""> Enter Email</label>
                    <input type="email" name="office_email" value="<%=office.office_email%>" class="form-control"
                        required>
                    <br>
                    <label for=""> Upload Map (Link)</label>
                    <input type="text" name="office_map_link" value="<%=office.office_map_link%>" class="form-control"
                        required>
                    <br>
                    <div class="text-center mt-4">
                        <button class="btn btn-primary font-weight-bold">Save Details</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include('footer.ejs') %>