<%- include('navbar.ejs') %>

    <div class="container p-4 mt-5 border shadow bg-white font-weight-bold" style="width: 100%;color: black;">
        <div class="row">
            <div class="col-md-12">
                <h3 class="font-weight-bold text-center alert alert-primary p-3">Update Certificate</h3>
            </div>
            <div class="col-12 mt-2">
                <form action="/admin/update_certificate" method="post" enctype="multipart/form-data"
                    onsubmit="return validateForm()">
                    <input type="hidden" name="id" value="<%= edit_certificate.id %>">

                    <!-- Name -->
                    <label class="mt-3" for="student_name">Enter Name</label>
                    <input type="text" name="student_name" value="<%= edit_certificate.student_name %>"
                        placeholder="Enter Full Name" class="form-control" required>

                    <!-- Mobile -->
                    <label class="mt-3" for="student_mobile">Enter Mobile</label>
                    <input type="text" name="student_mobile" value="<%= edit_certificate.student_mobile %>"
                        id="student_mobile" placeholder="Enter Mobile" class="form-control" required
                        oninput="validateMobile()">
                    <small id="mobile_error" class="text-danger"></small>

                    <!-- Certificate Upload -->
                    <div class="row mt-3">
                        <div class="col-md-10">
                            <label for="student_certificate">Update Certificate</label>
                            <input type="file" name="student_certificate" class="form-control">
                        </div>
                        <div class="col-md-2">
                            <img src="/uploads/<%= edit_certificate.student_certificate %>"
                                class="w-100 shadow rounded">
                        </div>
                    </div>

                    <!-- Certificate Type -->
                    <label class="mt-3" for="certificate_type">Select Certificate Type</label>
                    <select name="certificate_type" id="certificate_type" class="form-control"
                        onchange="toggleSubOptions()" required>
                        <option value="">-- Select Type --</option>
                        <option value="course" <%=edit_certificate.certificate_type==='course' ? 'selected' : '' %>
                            >Course</option>
                        <option value="workshop" <%=edit_certificate.certificate_type==='workshop' ? 'selected' : '' %>
                            >Workshop</option>
                        <option value="internship" <%=edit_certificate.certificate_type==='internship' ? 'selected' : ''
                            %>>Internship</option>
                    </select>

                    <!-- Course Sub-options -->
                    <div id="course_options" style="display: none;">
                        <label class="mt-3" for="course_name">Select Course</label>
                        <select name="course_name" class="form-control">
                            <option value="web_dev" <%=edit_certificate.course_name==='web_dev' ? 'selected' : '' %>>Web
                                Development</option>
                            <option value="data_science" <%=edit_certificate.course_name==='data_science' ? 'selected'
                                : '' %>>Data Science</option>
                            <option value="ai_ml" <%=edit_certificate.course_name==='ai_ml' ? 'selected' : '' %>>AI/ML
                            </option>
                            <option value="cyber_security" <%=edit_certificate.course_name==='cyber_security'
                                ? 'selected' : '' %>>Cyber Security</option>
                        </select>
                    </div>

                    <!-- Workshop Sub-options -->
                    <div id="workshop_options" style="display: none;">
                        <label class="mt-3" for="workshop_name">Select Workshop</label>
                        <select name="workshop_name" class="form-control">
                            <option value="digital_marketing" <%=edit_certificate.workshop_name==='digital_marketing'
                                ? 'selected' : '' %>>Digital Marketing</option>
                            <option value="graphic_design" <%=edit_certificate.workshop_name==='graphic_design'
                                ? 'selected' : '' %>>Graphic Design</option>
                            <option value="public_speaking" <%=edit_certificate.workshop_name==='public_speaking'
                                ? 'selected' : '' %>>Public Speaking</option>
                            <option value="business_analytics" <%=edit_certificate.workshop_name==='business_analytics'
                                ? 'selected' : '' %>>Business Analytics</option>
                        </select>
                    </div>

                    <!-- Internship Sub-options -->
                    <div id="internship_options" style="display: none;">
                        <label class="mt-3" for="internship_name">Select Internship</label>
                        <select name="internship_name" class="form-control">
                            <option value="software_dev" <%=edit_certificate.internship_name==='software_dev'
                                ? 'selected' : '' %>>Software Development</option>
                            <option value="hr_management" <%=edit_certificate.internship_name==='hr_management'
                                ? 'selected' : '' %>>HR Management</option>
                            <option value="finance_analysis" <%=edit_certificate.internship_name==='finance_analysis'
                                ? 'selected' : '' %>>Finance Analysis</option>
                            <option value="content_writing" <%=edit_certificate.internship_name==='content_writing'
                                ? 'selected' : '' %>>Content Writing</option>
                        </select>
                    </div>

                    <!-- Certificate Number -->
                    <label class="mt-3" for="student_certificate_number">Enter Certificate Number</label>
                    <div class="input-group">
                        <span class="input-group-text">UCN-KD-</span>
                        <input type="text" id="student_certificate_number" name="student_certificate_number"
                            value="<%= edit_certificate.student_certificate_number %>" class="form-control" required>
                    </div>

                    <div class="text-center mt-3">
                        <button type="submit" id="submit_btn" class="btn btn-primary font-weight-bold">Update
                            Certificate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function toggleSubOptions() {
            var type = document.getElementById("certificate_type").value;
            document.getElementById("course_options").style.display = "none";
            document.getElementById("workshop_options").style.display = "none";
            document.getElementById("internship_options").style.display = "none";

            if (type === "course") {
                document.getElementById("course_options").style.display = "block";
            } else if (type === "workshop") {
                document.getElementById("workshop_options").style.display = "block";
            } else if (type === "internship") {
                document.getElementById("internship_options").style.display = "block";
            }
        }

        function validateMobile() {
            var mobile = document.getElementById("student_mobile").value;
            var error = document.getElementById("mobile_error");
            var submitBtn = document.getElementById("submit_btn");

            if (mobile.length !== 10 || isNaN(mobile)) {
                error.innerText = "Please enter a valid 10-digit mobile number.";
                submitBtn.disabled = true;
            } else {
                error.innerText = "";
                submitBtn.disabled = false;
            }
        }

        function validateForm() {
            var mobile = document.getElementById("student_mobile").value;
            if (mobile.length !== 10 || isNaN(mobile)) {
                return false; // Prevent form submission if mobile is invalid
            }
            alert("Certificate updated successfully!");
            return true;
        }

        // Auto-select and show the correct fields based on existing data
        document.addEventListener("DOMContentLoaded", function () {
            toggleSubOptions();
        });
    </script>

    <%- include('footer.ejs') %>