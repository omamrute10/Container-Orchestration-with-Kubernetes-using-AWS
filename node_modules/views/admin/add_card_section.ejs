<%- include('navbar.ejs') %>
<style>
    .table-cell {
        max-width: 200px;
        /* Fixed width */
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

<form action="/admin/save_card" method="post" enctype="multipart/form-data">

    <div class="container border shadow p-5 mt-5 bg-white" style="width: 100%;">
        <div class="row">
            <div class="col-md-12">
                <h3 class="font-weight-bold text-center alert alert-primary p-3">About Card Section</h3>
            </div>
            <div class="col-md-6 mt-3">
                <label class="font-weight-bold" for="">Upload Card Logo</label>
                <input type="file" accept="image/*" name="about_card_logo" value="" class="form-control">
            </div>
            <div class="col-md-6 mt-3">
                <label class="font-weight-bold" for="">Enter Card Header</label>
                <input type="text" name="about_card_header"  class="form-control">
            </div>
            <div class="col-md-6 mt-3">
                <label class="font-weight-bold" for="">Add Card Button (Link)</label>
                <input type="text" name="about_card_button"  class="form-control">
            </div>
            <div class="col-md-6 mb-3 mt-3">
                <label class="font-weight-bold" for="">Enter Card Sub-Headings</label>
                <textarea name="about_card_sub_heading" class="form-control"></textarea>
            </div>
            
            <div class="col-md-12 text-center">
                <button class="font-weight-bold btn btn-primary">Save Details</button>
            </div>
        </div>
    </div>
</form>

<br><br>

<div class="container border shadow p-5 bg-white" style="width: 100%;">
    <div class="row">
        <div class="col-md-12">
            <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">About Card List</h3>
        </div>
        <div class="col-12">
            <div class="table-responsive ">
            <table class="table table-bordered table-striped mt-2">
                <thead class="thead-dark">
                    <tr>
                        <th>Action</th>
                        <th>Sr.No</th>
                        <th>Card Image</th>
                        <th>Heading</th>
                        <th>Card Sub Heading</th>
                        <th>Card Button Link</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(var i = 0; i < about_card.length; i++) { %>
                        <tr class="text-dark">
                            <td class="text-center" style="white-space: nowrap; width: 10%;">
                                <a style="text-decoration: none;" href="/admin/delete_about_card/<%= about_card[i].about_card_id %>" onclick="return confirm('Are You Sure')">
                                    <button class="btn btn-danger mt-5"><i class="fa fa-trash"></i></button>
                                </a>
                                <a style="text-decoration: none;" href="/admin/edit_about_card/<%= about_card[i].about_card_id %>">
                                    <button class="btn btn-primary mt-5"><i class="fa fa-edit"></i></button>
                                </a>
                            </td>
                            <td><%= i + 1 %></td>
                            <td>
                                <img src="/uploads/<%= about_card[i].add_card_logo %>" alt="Card Image" class="img-fluid" style="max-width: 100px;">
                            </td>
                            <td><%= about_card[i].add_card_heading %></td>
                            <td class="table-cell"><%= about_card[i].add_card_sub_heading %></td>
                            <td><%= about_card[i].add_card_button %></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>


<%- include('footer.ejs') %>