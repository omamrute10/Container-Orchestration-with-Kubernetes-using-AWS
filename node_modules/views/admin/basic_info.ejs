<%- include('navbar.ejs') %>


    <form action="/admin/save_basic_info" method="post" enctype="multipart/form-data">

        <div class="container border shadow p-5 mt-5 bg-white" style="width: 100%;">
            <div class="row">
                <div class="col-md-12">
                    <h3 class="font-weight-bold text-center alert alert-primary p-3 mb-4">About Company Details</h3>
                </div>
               
                <div class="col-md-6 mb-3">
                    <label class="font-weight-bold" for="">Enter Company Location</label>
                    <input type="text" name="company_location" style="padding: 8px;" value="<%= company_info.company_location %>"
                        class="form-control">
                </div>
                 <div class="col-md-3 mb-3">
                    <label class="font-weight-bold" for="">Upload Company Logo</label>
                    <input type="file" accept="image/*" name="company_logo" value="" class="form-control">
                </div>
                <div class="col-md-3 bg-dark mb-2">
                    <img src="/uploads/<%= company_info.company_logo %>" class="w-100 pt-md-3">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="font-weight-bold" for="">Enter Company Mobile</label>
                    <input type="text" name="company_mobile" value="<%= company_info.company_mobile %>"
                        class="form-control">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="font-weight-bold" for="">Enter Company Email</label>
                    <input type="email" name="company_email" value="<%= company_info.company_email %>"
                        class="form-control">
                </div>
                <div class="col-md-12 mb-3">
                    <label class="font-weight-bold" for="">Enter Company Address</label>
                    <textarea name="company_address" class="form-control"><%- company_info.company_address %></textarea>
                </div>

                <div class="col-md-12 text-center mt-3">
                    <button class="font-weight-bold btn btn-primary">Save Details</button>
                </div>
            </div>
        </div>
    </form>


    <%- include('footer.ejs') %>