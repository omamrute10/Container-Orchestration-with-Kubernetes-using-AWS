/*========== SERVICES PAGE CSS START ==========*/

.services-section{
    padding: 80px 0;
    background: #f8f9fc;
}

.services-card{
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    transition: 0.4s ease;
    box-shadow: 0 5px 25px rgba(0,0,0,0.08);
    height: 100%;
}

.services-card:hover{
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

.services-image{
    overflow: hidden;
}

.services-image img{
    width: 100%;
    height: 240px;
    object-fit: cover;
    transition: 0.5s ease;
}

.services-card:hover .services-image img{
    transform: scale(1.05);
}

.services-content{
    padding: 25px;
}

.services-content h3{
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 20px;
    color: #111;
}

.services-points{
    list-style: none;
    padding: 0;
    margin: 0;
}

.services-points li{
    position: relative;
    padding: 12px 0 12px 35px;
    border-bottom: 1px dashed #d7d7d7;
    color: #555;
    font-size: 15px;
    font-weight: 500;
}

.services-points li:last-child{
    border-bottom: none;
}

.services-points li::before{
    content: "✓";
    position: absolute;
    left: 0;
    top: 10px;
    width: 22px;
    height: 22px;
    background: linear-gradient(135deg,#7b2ff7,#c056fc);
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}

@media(max-width:767px){

.services-content h3{
