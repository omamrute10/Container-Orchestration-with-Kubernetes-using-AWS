      // Generate additional questions to meet pool size requirements
      function generateAdditionalQuestions(subject, level, baseQuestions, targetCount) {
        const questions = [...baseQuestions];
        const topics = {
          python: ['variables', 'functions', 'classes', 'modules', 'exceptions', 'data structures'],
          java: ['classes', 'inheritance', 'interfaces', 'collections', 'threads'],
          javascript: ['functions', 'objects', 'arrays', 'promises', 'DOM'],
          dbms: ['tables', 'queries', 'joins', 'indexes', 'transactions']
        };

        while (questions.length < targetCount) {
          const topic = topics[subject][questions.length % topics[subject].length];
          const qNum = questions.length + 1;
          questions.push({
            id: `${subject}-${level}-${qNum}`,
            q: `${level.charAt(0).toUpperCase() + level.slice(1)} question about ${topic} in ${subject.toUpperCase()} (Q${qNum})`,
            options: ['Option A', 'Option B', 'Option C', 'Option D'],
            ans: Math.floor(Math.random() * 4),
            explain: `This is a ${level} level explanation about ${topic} in ${subject}.`
          });
        }
        return questions;
      }

      // Build complete pools
      const ALL_POOLS = {};
      Object.keys(QUESTION_POOLS).forEach(subject => {
        ALL_POOLS[subject] = {};
        Object.keys(QUESTION_POOLS[subject]).forEach(level => {
          const baseQuestions = QUESTION_POOLS[subject][level];
          const targetCount = AES.poolSizes[level];
          ALL_POOLS[subject][level] = generateAdditionalQuestions(subject, level, baseQuestions, targetCount);
        });
      });

      // ---------- STATE ----------
      let state = {
        name: '',
        subject: 'python',
        level: 'basic',
        timeLeft: 0,
        questions: [],
        current: 0,
        answers: {},
        marked: new Set(),
        timerInterval: null,
        usedFifty: new Set(),
        usedHint: new Set(),
        skips: 0,
        isPractice: false
      };

      // helpers
      function sampleQuestions(subject, level, count) {
        const pool = ALL_POOLS[subject][level];
        const arr = [...pool];
        for (let i = arr.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr.slice(0, count).map(q => ({ ...q, options: shuffle([...q.options]) }));
      }

      function shuffle(a) {
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      }

      function startTimer(minutes) {
        clearInterval(state.timerInterval);
        state.timeLeft = minutes * 60;
        updateTimer();
        state.timerInterval = setInterval(() => {
          state.timeLeft--;
          updateTimer();
          if (state.timeLeft <= 0) {
            finishExam();
          }
        }, 1000);
      }

      function updateTimer() {
        document.getElementById('aesTimer').innerText = formatTime(state.timeLeft);
      }

      function formatTime(s) {
        if (s < 0) s = 0;
        const m = String(Math.floor(s / 60)).padStart(2, '0');
        const sec = String(s % 60).padStart(2, '0');
        return `${m}:${sec}`;
      }

      // UI bindings
      document.getElementById('aesStart').addEventListener('click', () => {
        const name = document.getElementById('aesName').value.trim();
        const subject = document.getElementById('aesSubject').value;
        const level = document.getElementById('aesLevel').value;
        const timeMin = parseInt(document.getElementById('aesTime').value) || 30;
        if (!name) {
          Swal.fire({
            icon: 'warning',
            title: 'Name Required',
            text: 'Please enter your full name to start the exam.'
          });
          return;
        }
        state.name = name;
        state.subject = subject;
        state.level = level;
        beginExam({ practice: false, timeMin });
      });

      document.getElementById('aesPractice').addEventListener('click', () => {
        const name = document.getElementById('aesName').value.trim() || 'Practice User';
        const subject = document.getElementById('aesSubject').value;
        const level = document.getElementById('aesLevel').value;
        state.name = name;
        state.subject = subject;
        state.level = level;
        beginExam({ practice: true, timeMin: 30 });
      });

      document.getElementById('aesNext').addEventListener('click', () => submitAnswerAndMove(1));
      document.getElementById('aesPrev').addEventListener('click', () => submitAnswerAndMove(-1));
      document.getElementById('aesMark').addEventListener('click', () => toggleMark());
      document.getElementById('aesExplain').addEventListener('click', () => showAnswer(true));
      document.getElementById('aesDownload').addEventListener('click', () => downloadCertificatePDF());
      document.getElementById('aesRestart').addEventListener('click', () => location.reload());

      document.getElementById('aesHint').addEventListener('click', () => useHint());
      document.getElementById('aesFifty').addEventListener('click', () => useFifty());
      document.getElementById('aesSkip').addEventListener('click', () => useSkip());

      // begin
      function beginExam({ practice = false, timeMin = 30 }) {
        const count = AES.examCounts[state.level];
        state.questions = sampleQuestions(state.subject, state.level, count);
        state.current = 0;
        state.answers = {};
        state.marked = new Set();
        state.usedFifty = new Set();
        state.usedHint = new Set();
        state.skips = 0;
        state.isPractice = practice;

        document.getElementById('aesTitle').innerText = `${capitalize(state.subject)} — ${capitalize(state.level)} ${practice ? '(Practice)' : ''}`;
        document.getElementById('aesSubtitle').innerText = `${state.name} — ${count} questions`;
        document.getElementById('aesSystemStatus').innerText = 'Exam started';

        if (!practice) {
          startTimer(timeMin);
        } else {
          document.getElementById('aesTimer').innerText = 'Practice Mode';
        }

        renderQuestion();
        renderReviewList();

        Swal.fire({
          icon: 'success',
          title: 'Exam Started!',
          text: `Good luck with your ${state.subject} ${state.level} exam!`,
          timer: 2000,
          showConfirmButton: false
        });
      }

      function renderQuestion() {
        const q = state.questions[state.current];
        document.getElementById('aesQNo').innerText = `Question ${state.current + 1} of ${state.questions.length}`;
        document.getElementById('aesQText').innerText = q.q;
        const opts = document.getElementById('aesOptions');
        opts.innerHTML = '';

        q.options.forEach((opt, idx) => {
          const wrap = document.createElement('label');
          wrap.className = 'aes-option';
          const checked = (state.answers[q.id] !== undefined && state.answers[q.id] === opt) ? 'checked' : '';
          wrap.innerHTML = `<input type='radio' name='aesAnswer' value='${idx}' ${checked} /> <div style='flex:1'>${opt}</div>`;
          wrap.addEventListener('click', () => {
            document.querySelectorAll('input[name="aesAnswer"]').forEach(i => i.checked = false);
            wrap.querySelector('input').checked = true;
            state.answers[q.id] = opt;
            updateProgress();
            renderReviewList();
          });
          opts.appendChild(wrap);
        });

        updateProgress();
        highlightMarked();
      }

      function submitAnswerAndMove(dir) {
        state.current += dir;
        if (state.current < 0) state.current = 0;
        if (state.current >= state.questions.length) {
          finishExam();
          return;
        }
        renderQuestion();
      }

      function toggleMark() {
        const q = state.questions[state.current];
        if (state.marked.has(q.id)) {
          state.marked.delete(q.id);
          Swal.fire({
            icon: 'info',
            title: 'Question Unmarked',
            text: 'Question removed from review list.',
            timer: 1500,
            showConfirmButton: false
          });
        } else {
          state.marked.add(q.id);
          Swal.fire({
            icon: 'info',
            title: 'Question Marked',
            text: 'Question added to review list.',
            timer: 1500,
            showConfirmButton: false
          });
        }
        renderReviewList();
        highlightMarked();
      }

      function updateProgress() {
        const total = state.questions.length;
        const answered = Object.keys(state.answers).length;
        const percent = Math.round((answered / total) * 100);
        document.getElementById('aesProgBar').style.width = `${percent}%`;
        document.getElementById('aesCertScore').innerText = `${answered}/${total}`;
      }

      function renderReviewList() {
        const list = document.getElementById('aesReviewList');
        list.innerHTML = '';
        state.questions.forEach((q, idx) => {
          const pill = document.createElement('div');
          pill.className = 'aes-q-pill';
          if (state.answers[q.id]) pill.classList.add('answered');
          if (state.marked.has(q.id)) pill.classList.add('marked');
          pill.innerText = idx + 1;
          pill.addEventListener('click', () => {
            state.current = idx;
            renderQuestion();
          });
          list.appendChild(pill);
        });
      }

      function highlightMarked() {
        const pills = document.querySelectorAll('.aes-q-pill');
        pills.forEach((p, i) => {
          p.classList.toggle('marked', state.marked.has(state.questions[i].id));
        });
      }

      function finishExam() {
        clearInterval(state.timerInterval);
        const total = state.questions.length;
        let score = 0;

        state.questions.forEach(q => {
          const selectedAnswer = state.answers[q.id];
          if (selectedAnswer && selectedAnswer === q.options[q.ans]) {
            score++;
          }
        });

        document.getElementById('aesSystemStatus').innerText = 'Exam finished';
        document.getElementById('aesCertName').innerText = state.name;
        document.getElementById('aesCertScore').innerText = `${score}/${total}`;

        const percentage = Math.round((score / total) * 100);
        let grade = 'F';
        if (percentage >= 90) grade = 'A+';
        else if (percentage >= 80) grade = 'A';
        else if (percentage >= 70) grade = 'B';
        else if (percentage >= 60) grade = 'C';
        else if (percentage >= 50) grade = 'D';

        Swal.fire({
          icon: score >= total * 0.6 ? 'success' : 'info',
          title: 'Exam Completed!',
          html: `
          <div style="text-align: center;">
            <h3>${state.name}</h3>
            <p><strong>Score:</strong> ${score}/${total} (${percentage}%)</p>
            <p><strong>Grade:</strong> ${grade}</p>
            <p><strong>Subject:</strong> ${state.subject.toUpperCase()}</p>
            <p><strong>Level:</strong> ${capitalize(state.level)}</p>
          </div>
        `,
          confirmButtonText: 'Download Certificate',
          showCancelButton: true,
          cancelButtonText: 'Close'
        }).then((result) => {
          if (result.isConfirmed) {
            downloadCertificatePDF();
          }
        });
      }

      function capitalize(s) {
        return s.charAt(0).toUpperCase() + s.slice(1);
      }

      // lifelines
      function useHint() {
        const q = state.questions[state.current];
        if (state.usedHint.has(q.id)) {
          Swal.fire({
            icon: 'warning',
            title: 'Hint Already Used',
            text: 'You have already used the hint for this question.'
          });
          return;
        }
        state.usedHint.add(q.id);
        Swal.fire({
          icon: 'info',
          title: 'Hint',
          text: q.explain || 'No explanation available for this question.',
          confirmButtonText: 'Got it!'
        });
      }

      function useFifty() {
        const q = state.questions[state.current];
        if (state.usedFifty.has(q.id)) {
          Swal.fire({
            icon: 'warning',
            title: '50-50 Already Used',
            text: 'You have already used 50-50 for this question.'
          });
          return;
        }
        state.usedFifty.add(q.id);

        // Remove two incorrect options
        const correctAnswer = q.options[q.ans];
        const incorrectOptions = q.options.filter((opt, idx) => idx !== q.ans);
        const toRemove = incorrectOptions.slice(0, 2);

        // Hide the incorrect options
        const optionElements = document.querySelectorAll('.aes-option');
        optionElements.forEach((element, idx) => {
          const optionText = q.options[idx];
          if (toRemove.includes(optionText)) {
            element.style.opacity = '0.3';
            element.style.pointerEvents = 'none';
            element.querySelector('input').disabled = true;
          }
        });

        Swal.fire({
          icon: 'success',
          title: '50-50 Used!',
          text: 'Two incorrect options have been eliminated.',
          timer: 2000,
          showConfirmButton: false
        });
      }

      function useSkip() {
        if (state.skips >= 3) {
          Swal.fire({
            icon: 'error',
            title: 'Skip Limit Reached',
            text: 'Maximum 3 skips allowed per exam.'
          });
          return;
        }
        state.skips++;
        Swal.fire({
          icon: 'info',
          title: 'Question Skipped',
          text: `Skips remaining: ${3 - state.skips}`,
          timer: 1500,
          showConfirmButton: false
        });
        submitAnswerAndMove(1);
      }

      function showAnswer(showAlert = false) {
        const q = state.questions[state.current];
        const correctText = q.options[q.ans];
        if (showAlert) {
          Swal.fire({
            icon: 'info',
            title: 'Correct Answer',
            html: `
            <div style="text-align: left;">
              <p><strong>Answer:</strong> ${correctText}</p>
              <p><strong>Explanation:</strong> ${q.explain}</p>
            </div>
          `,
            confirmButtonText: 'Continue'
          });
        }
      }

      // Enhanced certificate generation
      async function downloadCertificatePDF() {
        const { jsPDF } = window.jspdf;

        // Create new PDF in landscape
        const pdf = new jsPDF("landscape", "pt", "a4");
        const pageWidth = pdf.internal.pageSize.getWidth();
        const pageHeight = pdf.internal.pageSize.getHeight();

        // Create certificate background
        pdf.setFillColor(240, 248, 255);
        pdf.rect(0, 0, pageWidth, pageHeight, 'F');

        // Add border
        pdf.setDrawColor(106, 27, 154);
        pdf.setLineWidth(8);
        pdf.rect(20, 20, pageWidth - 40, pageHeight - 40);

        // Add inner border
        pdf.setLineWidth(2);
        pdf.rect(40, 40, pageWidth - 80, pageHeight - 80);

        // Certificate title
        pdf.setFont("times", "bold");
        pdf.setFontSize(36);
        pdf.setTextColor(106, 27, 154);
        pdf.text("CERTIFICATE OF COMPLETION", pageWidth / 2, 120, { align: "center" });

        // Subtitle
        pdf.setFontSize(18);
        pdf.setTextColor(100, 100, 100);
        pdf.text("This is to certify that", pageWidth / 2, 160, { align: "center" });

        // Student name
        pdf.setFont("times", "bold");
        pdf.setFontSize(32);
        pdf.setTextColor(0, 0, 0);
        pdf.text(state.name, pageWidth / 2, 220, { align: "center" });

        // Achievement text
        pdf.setFont("times", "normal");
        pdf.setFontSize(18);
        pdf.setTextColor(100, 100, 100);
        const score = document.getElementById("aesCertScore").innerText;
        pdf.text(`has successfully completed the ${capitalize(state.subject)} examination`, pageWidth / 2, 270, { align: "center" });
        pdf.text(`at ${capitalize(state.level)} level with a score of ${score}`, pageWidth / 2, 300, { align: "center" });

        // Date and signature area
        const today = new Date().toLocaleDateString();
        pdf.setFontSize(14);
        pdf.text(`Date: ${today}`, 100, pageHeight - 80);
        pdf.text("Authorized Signature", pageWidth - 200, pageHeight - 80);

        // Add decorative elements
        pdf.setDrawColor(106, 27, 154);
        pdf.setLineWidth(1);
        pdf.line(pageWidth / 2 - 100, 240, pageWidth / 2 + 100, 240);
        pdf.line(pageWidth - 250, pageHeight - 60, pageWidth - 50, pageHeight - 60);

        // Save PDF
        pdf.save(`${state.name.replace(/\s+/g, '_')}_certificate.pdf`);

        Swal.fire({
          icon: 'success',
          title: 'Certificate Downloaded!',
          text: 'Your certificate has been saved to your downloads folder.',
          timer: 3000,
          showConfirmButton: false
        });
      }

      // Initial status
      document.getElementById('aesSystemStatus').innerText = 'Pools generated — ready';
    </script>
