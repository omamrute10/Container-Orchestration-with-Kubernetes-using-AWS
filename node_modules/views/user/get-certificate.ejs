    <!-- Banner End -->
    <div class="aes-container">
      <div class="aes-topbar">
        <div class="aes-brand">
          <div><strong>Advanced Exam System</strong>
            <div class="aes-small">Interactive MCQ pools • PDF certificate • gamified features</div>
          </div>
        </div>
        <div class="aes-status">Status: <span id="aesSystemStatus">Ready</span></div>
      </div>

      <div class="aes-card aes-grid">
        <!-- LEFT -->
        <div class="aes-left">
          <h3>Student & Exam Setup</h3>
          <label class="aes-label">Full name</label>
          <input id="aesName" class="aes-input" type="text" placeholder="Enter full name" />

          <label class="aes-label">Subject</label>
          <select id="aesSubject" class="aes-select">
            <option value="python">Python</option>
            <option value="java">Java</option>
            <option value="javascript">JavaScript</option>
            <option value="dbms">DBMS/SQL</option>
          </select>

          <label class="aes-label">Level</label>
          <select id="aesLevel" class="aes-select">
            <option value="basic">Basic (15)</option>
            <option value="intermediate">Intermediate (25)</option>
            <option value="advanced">Advanced (50)</option>
          </select>

          <label class="aes-label">Time (minutes)</label>
          <input id="aesTime" class="aes-input" type="text" value="30" />

          <div style="margin-top:12px;display:flex;gap:8px;align-items:center">
            <button id="aesStart" class="aes-btn"><i class="fa fa-play"></i> Start Exam</button>
            <button id="aesPractice" class="aes-btn ghost">Practice Mode</button>
          </div>

          <div style="margin-top:14px">
            <strong>Pool sizes</strong>
            <ul class="aes-small" style="margin-top:8px">
              <li>Basic: <span id="aesPoolBasic"></span></li>
              <li>Intermediate: <span id="aesPoolInter"></span></li>
              <li>Advanced: <span id="aesPoolAdv"></span></li>
            </ul>
          </div>

          <div style="margin-top:12px">
            <strong>Lifelines</strong>
            <div class="aes-lifelines" style="margin-top:8px">
              <button id="aesHint" class="aes-btn ghost aes-pill">Hint</button>
              <button id="aesFifty" class="aes-btn ghost aes-pill">50-50</button>
              <button id="aesSkip" class="aes-btn ghost aes-pill">Skip Q</button>
            </div>
          </div>
        </div>

        <!-- RIGHT -->
        <div class="aes-right">
          <div class="aes-meta">
            <div>
              <strong id="aesTitle">Not started</strong>
              <div id="aesSubtitle" class="aes-small">Fill details and press Start</div>
            </div>
            <div class="aes-timer">
              <div class="aes-time-ring aes-animate-pulse"><i class="fa fa-clock"></i></div>
              Time Left: <span id="aesTimer" class="aes-time-val">00:00</span>
            </div>
          </div>

          <div id="aesQuestionArea" class="aes-question-area aes-card" style="display:block">
            <div class="aes-question-float">Q</div>
            <div id="aesQNo" class="aes-qno"></div>
            <div id="aesQText" class="aes-qtext">Exam not started</div>

            <div id="aesOptions" class="aes-options"></div>

            <div class="aes-controls">
              <div class="aes-left-controls">
                <button id="aesPrev" class="aes-btn ghost"><i class="fa fa-arrow-left"></i> Prev</button>
                <button id="aesMark" class="aes-btn ghost">Mark</button>
                <button id="aesExplain" class="aes-btn ghost">Show Answer</button>
              </div>
              <div>
                <button id="aesNext" class="aes-btn">Next <i class="fa fa-arrow-right"></i></button>
              </div>
            </div>

            <div class="aes-progress"><i id="aesProgBar"></i></div>
          </div>

          <div class="aes-extras">
            <div class="aes-panel">
              <h4>Review & Navigation</h4>
              <div id="aesReviewList" class="aes-review-list"></div>
              <div style="margin-top:10px" class="aes-small">Click a pill to jump to that question. Colored = answered /
                marked.</div>
            </div>

            <div class="aes-panel">
              <h4>Result Preview</h4>
              <div class="aes-cert">
                <div class="aes-cert-canvas" id="aesCertCanvas">
                  <div class="aes-cert-overlay">
                    <h3 id="aesCertName"></h3>
                    <div class="aes-small">Score: <span id="aesCertScore">0/0</span></div>
                  </div>
                </div>
                <div style="margin-top:8px;display:flex;gap:8px;justify-content:center">
                  <button id="aesDownload" class="aes-btn">Download Certificate (PDF)</button>
                  <button id="aesRestart" class="aes-btn ghost">Restart</button>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
