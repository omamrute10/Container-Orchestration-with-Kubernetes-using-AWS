            },
            {
              id: 'py-b-10',
              q: 'What is the correct syntax for a while loop in Python?',
              options: ['while (condition):', 'while condition:', 'while condition do:', 'while condition then:'],
              ans: 1,
              explain: 'Python while loops use the syntax: while condition: (no parentheses needed).'
            },
            {
              id: 'py-b-11',
              q: 'Which of the following is used to handle exceptions in Python?',
              options: ['try-catch', 'try-except', 'catch-throw', 'handle-error'],
              ans: 1,
              explain: 'Python uses try-except blocks to handle exceptions.'
            },
            {
              id: 'py-b-12',
              q: 'What is the output of print("Hello" + "World")?',
              options: ['Hello World', 'HelloWorld', 'Hello+World', 'Error'],
              ans: 1,
