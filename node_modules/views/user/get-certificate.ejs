<%- include('header.ejs') %>

  <!doctype html>
  <html lang="en">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Advanced Online Examination System — Enhanced</title>
    <!-- External libraries for PDF generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
      /* ---------- THEME & UNIQUE CLASS NAMES (aes-) ---------- */
      :root {
        --aes-accent: #6a1b9a;
        --aes-accent-2: #8e24aa;
        --aes-bg: linear-gradient(180deg, #f6f8fb 0%, #eef3f8 100%);
        --aes-muted: #6b7280;
        --aes-card: #ffffff;
        --aes-glass: rgba(255, 255, 255, 0.7);
        --aes-success: #2e7d32;
      }

      * {
        box-sizing: border-box;
        font-family: Inter, 'Segoe UI', Roboto, Arial, sans-serif
      }

      body {
        background: var(--aes-bg);
        margin: 0;
        color: #111
      }

      /* container */
      .aes-container {
        max-width: 1300px;
        margin: 48px auto;
        padding: 0 20px;
      }

      /* top bar */
      .aes-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px
      }

      .aes-brand {
        display: flex;
        gap: 12px;
        align-items: center;
        font-size: 22px;
        line-height: 1.8;
      }

      .aes-brand img {
        height: 44px;
        border-radius: 8px;
        box-shadow: 0 6px 20px rgba(60, 0, 80, 0.08)
      }

      .aes-status {
        font-size: 14px;
        color: var(--aes-muted)
      }

      /* card grid */
      .aes-card {
        background: var(--aes-card);
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 12px 40px rgba(20, 20, 60, 0.06)
      }

      .aes-grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 18px
      }

      /* left panel */
      .aes-left {
        padding: 12px
      }

      .aes-left h3 {
        margin: 6px 0 12px
      }

      .aes-label {
        display: block;
        margin: 8px 0;
        color: var(--aes-muted);
        font-size: 14px
      }

      .aes-input,
      .aes-select {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #e6e6f0
      }

      .aes-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(90deg, var(--aes-accent), var(--aes-accent-2));
        color: #fff;
        font-weight: 600;
        cursor: pointer
      }

      .aes-btn.ghost {
        background: transparent;
        color: var(--aes-accent);
        border: 1px solid rgba(106, 27, 154, 0.14)
      }

      .aes-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px
      }

      .aes-chip {
        padding: 8px 10px;
        border-radius: 999px;
        border: 1px solid #eee;
        background: #fbfbff;
        cursor: pointer
      }

      .aes-chip.active {
        background: linear-gradient(90deg, var(--aes-accent), var(--aes-accent-2));
        color: #fff;
        border: none
      }

      /* right panel */
      .aes-right {
        padding: 12px
      }

      .aes-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px
      }

      .aes-timer {
        font-weight: 800;
        color: var(--aes-accent-2);
        display: flex;
        gap: 12px;
        align-items: center
      }

      .aes-timer .aes-time-val {
        font-family: monospace
      }

      /* animated question area */
      .aes-question-area {
        min-height: 240px;
        padding: 18px;
        border-radius: 12px;
        border: 1px dashed rgba(220, 220, 235, 0.8);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.6), rgba(250, 250, 255, 0.95));
        position: relative;
        overflow: hidden
      }

      .aes-question-float {
        position: absolute;
        right: -80px;
        top: -40px;
        opacity: 0.06;
        font-size: 120px;
        transform: rotate(-20deg)
      }

      .aes-qno {
        font-weight: 700;
        color: var(--aes-accent)
      }

      .aes-qtext {
        font-size: 18px;
        margin-top: 8px;
        color: #222
      }

      .aes-options {
        margin-top: 14px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px
      }

      .aes-option {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 10px;
        border: 1px solid #f0f0f5;
        background: #fff;
        cursor: pointer;
        transition: transform .12s ease, box-shadow .12s ease
      }

      .aes-option:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(80, 40, 120, 0.06)
      }

      .aes-option input {
        transform: scale(1.05)
      }

      /* controls */
      .aes-controls {
        display: flex;
        gap: 8px;
        justify-content: space-between;
        margin-top: 14px
      }

      .aes-controls .aes-left-controls {
        display: flex;
        gap: 8px
      }

      /* progress */
      .aes-progress {
        height: 10px;
        background: #eee;
        border-radius: 999px;
        overflow: hidden;
        margin-top: 12px
      }

      .aes-progress>i {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--aes-accent), var(--aes-accent-2));
        width: 0%
      }

      /* right-side extras */
      .aes-extras {
        display: flex;
        gap: 12px;
        margin-top: 12px
      }

      .aes-panel {
        flex: 1;
        padding: 12px;
        border-radius: 10px;
        background: linear-gradient(180deg, #fff, #fbfbff);
        border: 1px solid #f0f0f8
      }

      .aes-panel h4 {
        margin: 4px 0 8px
      }

      /* review list */
      .aes-review-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px
      }

      .aes-q-pill {
        padding: 8px 10px;
        border-radius: 8px;
        background: #fafafa;
        border: 1px solid #eee;
        cursor: pointer
      }

      .aes-q-pill.answered {
        background: linear-gradient(90deg, #e8f7ed, #dff3e6);
        border-color: #bfe6c5
      }

      .aes-q-pill.marked {
        background: #fff8e6;
        border-color: #f6d48a
      }

      /* certificate preview (compact) */
      .aes-cert {
        margin-top: 12px;
        text-align: center
      }

      .aes-cert-canvas {
        position: relative;
        width: 100%;
        height: 0;
        padding-bottom: 60%;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #eee
      }

      .aes-cert-canvas img {
        position: absolute;
        width: 100%;
        height: 100%;
        left: 0;
        top: 0;
        object-fit: cover
      }

      .aes-cert-overlay {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 18px
      }

      /* small utilities */
      .aes-small {
        font-size: 14px;
        color: var(--aes-muted)
      }

      .aes-lifelines {
        display: flex;
        gap: 8px
      }

      .aes-pill {
        padding: 8px;
        border-radius: 8px;
        background: #fff;
        border: 1px solid #eee
      }

      /* animations */
      @keyframes floaty {
        0% {
          transform: translateY(0)
        }

        50% {
          transform: translateY(-8px)
        }

        100% {
          transform: translateY(0)
        }
      }

      .aes-animate-pulse {
        animation: floaty 3.2s ease-in-out infinite
      }

      /* responsive */
      @media(max-width:980px) {
        .aes-grid {
          grid-template-columns: 1fr
        }

        .aes-question-float {
          display: none
        }
      }
    </style>
  </head>

  <body>
