      <div class="container">
        <div class="row">
          <div class="col-lg-12">
            <div class="banner-content text-center">
              <h1 class="h1-title">Start Your Professional Journey</h1>
              <div class="banner-breadcrum">
                <ul>
                  <li><a href="/" title="Home">Home</a></li>
                  <li><i class="fa-solid fa-angle-right"></i></li>
                  <li><a href="/get-certificate" title="Course">Online Certifications</a></li>
                </ul>
