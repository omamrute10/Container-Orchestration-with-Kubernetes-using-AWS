    <script>
      // ---------- CONFIG & POOLS ----------
      const AES = {
        poolSizes: { basic: 300, intermediate: 500, advanced: 1000 },
        examCounts: { basic: 15, intermediate: 25, advanced: 50 }
      };
      document.getElementById('aesPoolBasic').innerText = AES.poolSizes.basic;
      document.getElementById('aesPoolInter').innerText = AES.poolSizes.intermediate;
      document.getElementById('aesPoolAdv').innerText = AES.poolSizes.advanced;

      // Enhanced question pools with proper subject-specific questions
      const QUESTION_POOLS = {
        python: {
          basic: [
            {
              id: 'py-b-1',
              q: 'What is the correct way to create a list in Python?',
              options: ['my_list = []', 'my_list = ()', 'my_list = {}', 'my_list = <>'],
              ans: 0,
              explain: 'Square brackets [] are used to create lists in Python.'
            },
            {
              id: 'py-b-2',
              q: 'Which of the following is used to define a function in Python?',
              options: ['function', 'def', 'define', 'func'],
              ans: 1,
              explain: 'The "def" keyword is used to define functions in Python.'
            },
            {
              id: 'py-b-3',
              q: 'What is the output of print(type(5))?',
              options: ['<class "int">', '<class "float">', '<class "str">', '<class "number">'],
              ans: 0,
              explain: 'The number 5 is an integer, so type(5) returns <class "int">.'
            },
            {
              id: 'py-b-4',
              q: 'Which operator is used for exponentiation in Python?',
              options: ['^', '**', 'exp', 'pow'],
              ans: 1,
              explain: 'The ** operator is used for exponentiation in Python (e.g., 2**3 = 8).'
            },
            {
              id: 'py-b-5',
              q: 'How do you create a comment in Python?',
              options: ['// comment', '/* comment */', '# comment', '<!-- comment -->'],
              ans: 2,
              explain: 'Single-line comments in Python start with the # symbol.'
            },
            {
              id: 'py-b-6',
              q: 'What is the correct way to import a module in Python?',
              options: ['include module', 'import module', 'require module', 'using module'],
              ans: 1,
              explain: 'The "import" keyword is used to import modules in Python.'
            },
            {
              id: 'py-b-7',
              q: 'Which of these is a mutable data type in Python?',
              options: ['tuple', 'string', 'list', 'int'],
              ans: 2,
              explain: 'Lists are mutable in Python, meaning their contents can be changed after creation.'
            },
            {
              id: 'py-b-8',
              q: 'What does len() function return?',
              options: ['Length of an object', 'Last element', 'First element', 'Type of object'],
              ans: 0,
