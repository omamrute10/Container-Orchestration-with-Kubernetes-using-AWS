    <!-- Banner End -->
    <!-- Banner End -->

    <style>
        .session-card {
            border-radius: 18px;
            overflow: hidden;
        }

        .session-header {
            background: linear-gradient(135deg, #af0b4e, #6a0d83);
        }

        .section-title {
            color: #4c0a78;
            font-weight: 700;
            margin: 30px 0 15px;
            border-bottom: 2px dashed #ddd;
            padding-bottom: 6px;
            font-size: 20px;
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            padding: 12px;
            border: 1px solid #ddd;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #af0b4e;
            box-shadow: 0 0 0 0.2rem rgba(175, 11, 78, 0.25);
        }

        .submit-btn {
            background: linear-gradient(135deg, #af0b4e, #6a0d83);
            color: #fff;
            border-radius: 30px;
            border: none;
            padding: 12px 40px;
            transition: all 0.3s ease;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        }
    </style>

    <!-- Form -->
    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card session-card shadow-lg border-0">

                    <div class="card-header session-header text-center py-4">
                        <h2 class="text-white fw-bold mb-1">Session Registration Form</h2>
                        <p class="text-white mb-0">
                            📅 Friday 27 February 2026 | 🕛 12:00 PM – 2:00 PM
                        </p>
                    </div>

                    <div class="card-body p-4">
                        <form action="/save_resume_session_registration" method="POST" class="needs-validation"
                            novalidate>

                            <div class="section-title">
                                <i class="fa fa-user"></i> Registration Details
                            </div>

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label>Full Name *</label>
                                    <input type="text" class="form-control" name="full_name" required>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label>Mobile Number *</label>
                                    <input type="tel" class="form-control" name="mobile_number" pattern="[0-9]{10}"
                                        required>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label>College Name *</label>
                                    <input type="text" class="form-control" name="college_name" required>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label>Course / Degree *</label>
                                    <input type="text" class="form-control" name="course_degree" required>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label>Current Status *</label>
                                    <select class="form-select" name="current_status" required>
                                        <option value="" disabled selected>Select Status</option>
                                        <option>Student</option>
                                        <option>Job Seeker</option>
                                        <option>Working Professional</option>
                                    </select>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label>Do you have a Resume? *</label>
                                    <select class="form-select" name="have_resume" required>
                                        <option value="" disabled selected>Select Option</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label>Do you have a LinkedIn Profile? *</label>
                                    <select class="form-select" name="have_linkedin" required>
                                        <option value="" disabled selected>Select Option</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label>Mode of Attendance *</label>
                                    <select class="form-select" name="mode_of_attendance" required>
                                        <option value="" disabled selected>Select Mode</option>
                                        <option>Online</option>
                                        <option>Offline</option>
                                    </select>
                                </div>

                            </div>

                            <div class="text-center mt-4">
                                <button type="submit" class="submit-btn btn-lg">
                                    <i class="fa fa-paper-plane"></i> Register Now
                                </button>
                            </div>

                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Validation Script -->
    <script>
        (function () {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>

    <%- include('footer.ejs') %>