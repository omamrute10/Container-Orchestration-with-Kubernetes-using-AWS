                <img src="/user_assets/images/aliment-07.svg" width="38" height="32" alt="Aliment">
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="banner-content text-center">
                        <h1 class="h1-title">Help Us Improve – Your Feedback Counts</h1>
                        <div class="banner-breadcrum">
                            <ul>
                                <li><a href="/" title="Home">Home</a></li>
                                <li><i class="fa-solid fa-angle-right"></i></li>
                                <li><a href="/ai-agent-developement" title="Course">Advanced Internship Program</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Banner End -->


    <!-- Form Card -->

    <div class="form-card">
        <center>
            <h5>This feedback form is for the 10-day WordPress workshop held from 24/10 to 5/11, organized by PVP
                College of Arts, Science & Commerce, Loni, in association with Kanak Digifex. Please fill out this form
                and submit it.</h5>
        </center>
        <hr>
        <form action="/save-feedback" method="post" id="feedbackForm">
            <!-- Name Field -->
            <div class="form-group">
                <label>Your Name <span class="required">*</span></label>
                <input type="text" id="name" name="name" required placeholder="Enter your full name">
            </div>

            <!-- Mobile Field -->
            <div class="form-group">
                <label>Mobile Number</label>
                <input type="tel" id="mobile" name="mobile" placeholder="Enter 10-digit mobile number" maxlength="10"
                    pattern="\d{10}" inputmode="numeric">
            </div>

            <!-- Rating Section Header -->
            <div style="margin: 40px 0 25px 0;">
                <h3 style="color: #1e293b; font-size: 20px; margin-bottom: 10px;">Workshop Content & Teaching (1 = Poor,
                    5 =
                    Excellent)</h3>
                <p style="color: #64748b; font-size: 14px;font-weight: bold;">Slide to rate your experience</p>
            </div>

            <!-- Rating Sections -->
            <div class="rating-section">
                <label>Overall Workshop Experience</label>
                <div class="slider-container">
                    <input type="range" min="1" max="5" step="1" value="3" class="rating-slider" id="overall"
                        name="overall">
                    <div class="slider-labels">
                        <span>Poor</span>
                        <span>Fair</span>
                        <span>Good</span>
                        <span>Very Good</span>
                        <span>Excellent</span>
                    </div>
                    <div class="rating-value">
                        <span id="overall-value">3</span>/5
                        <span class="rating-emoji" id="overall-emoji">😊</span>
                    </div>
                </div>
            </div>

            <div class="rating-section">
                <label>Practical Sessions & Hands-On Experience</label>
                <div class="slider-container">
                    <input type="range" min="1" max="5" step="1" value="3" class="rating-slider" id="instructor"
                        name="instructor">
                    <div class="slider-labels">
                        <span>Poor</span>
                        <span>Fair</span>
                        <span>Good</span>
                        <span>Very Good</span>
                        <span>Excellent</span>
                    </div>
                    <div class="rating-value">
                        <span id="instructor-value">3</span>/5
                        <span class="rating-emoji" id="instructor-emoji">😊</span>
                    </div>
                </div>
            </div>

            <div class="rating-section">
                <label>How would you rate the overall content of the 10-day workshop?</label>
                <div class="slider-container">
                    <input type="range" min="1" max="5" step="1" value="3" class="rating-slider" id="handson"
                        name="handson">
                    <div class="slider-labels">
                        <span>Poor</span>
                        <span>Fair</span>
                        <span>Good</span>
                        <span>Very Good</span>
                        <span>Excellent</span>
                    </div>
                    <div class="rating-value">
                        <span id="handson-value">3</span>/5
                        <span class="rating-emoji" id="handson-emoji">😊</span>
                    </div>
                </div>
            </div>

            <div class="rating-section">
                <label>How effective was the trainer’s teaching style?</label>
                <div class="slider-container">
                    <input type="range" min="1" max="5" step="1" value="3" class="rating-slider" id="combined"
                        name="combined">
                    <div class="slider-labels">
                        <span>Poor</span>
                        <span>Fair</span>
                        <span>Good</span>
                        <span>Very Good</span>
                        <span>Excellent</span>
                    </div>
                    <div class="rating-value">
                        <span id="combined-value">3</span>/5
                        <span class="rating-emoji" id="combined-emoji">😊</span>
                    </div>
                </div>
            </div>

            <!-- Suggestions -->
            <div class="form-group" style="margin-top: 40px;">
                <label>Any other suggestions, comments, or feedback? (Optional)</label>
                <textarea id="suggestions" name="suggestions"
                    placeholder="Share your thoughts and suggestions..."></textarea>
            </div>

            <!-- Internship Interest -->
            <div class="form-group">
                <label>Are you interested in Advanced Internship Program?</label>
                <div class="radio-group">
                    <div class="radio-option">
                        <input type="radio" name="internship" id="int-yes" value="yes">
                        <label for="int-yes">Yes</label>
                    </div>
                    <div class="radio-option">
                        <input type="radio" name="internship" id="int-no" value="no">
                        <label for="int-no">No</label>
                    </div>
                </div>
            </div>

            <!-- Recommendation -->
            <div class="form-group">
                <label>Would you recommend this workshop to others?</label>
                <div class="radio-group">
                    <div class="radio-option">
                        <input type="radio" name="recommend" id="rec-yes" value="yes">
                        <label for="rec-yes">Yes, definitely!</label>
                    </div>
                    <div class="radio-option">
                        <input type="radio" name="recommend" id="rec-no" value="no">
                        <label for="rec-no">Probably not</label>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="submit-btn">Submit Feedback</button>
        </form>


    </div>
    </div>


    <script>
        // Rating slider functionality with emojis
        const emojis = {
            1: '😞',
            2: '😕',
            3: '😊',
            4: '😃',
            5: '🤩'
        };

        const sliders = document.querySelectorAll('.rating-slider');
        sliders.forEach(slider => {
            const valueSpan = document.getElementById(`${slider.id}-value`);
            const emojiSpan = document.getElementById(`${slider.id}-emoji`);

            slider.addEventListener('input', function () {
                const value = this.value;
                valueSpan.textContent = value;
                emojiSpan.textContent = emojis[value];
            });
        });

    </script>

    <%- include('footer.ejs') %>