            --accent: rgb(171, 64, 120);
            --success: #28a745;
            --card-bg: #ffffff;
            --muted: #6c757d;
            --light-bg: #f8f9fa;
            --gradient: linear-gradient(135deg, rgb(171, 64, 120) 0%, rgb(171, 64, 120) 100%);
            --shadow: 0 10px 30px rgba(11, 95, 255, 0.15);
            --shadow-hover: 0 15px 40px rgba(11, 95, 255, 0.25);
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(180deg, #f4f7fb 0%, #eef5ff 100%);
            font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
