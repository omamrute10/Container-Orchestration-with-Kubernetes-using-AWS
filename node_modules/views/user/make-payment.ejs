    <script>
        // Helper to read query params
        function getQueryParams() {
            const params = {};
            location.search.substring(1).split("&").forEach(pair => {
                if (!pair) return;
                const [k, v] = pair.split("=");
                params[decodeURIComponent(k)] = decodeURIComponent((v || "").replace(/\+/g, " "));
            });
            return params;
        }

        // Toggle payment method UI for each card
        function initPaymentMethodToggles() {
            document.querySelectorAll('.payment-card').forEach(card => {
                card.querySelectorAll('.payment-method').forEach(method => {
                    method.addEventListener('click', function () {
                        const methodType = this.getAttribute('data-method');
                        // remove active
                        card.querySelectorAll('.payment-method').forEach(m => m.classList.remove('active'));
                        this.classList.add('active');

                        // hide all details for this card
                        card.querySelectorAll('.payment-method-details').forEach(d => d.style.display = 'none');

                        // determine prefix based on which card this is
                        const isCollege = card.classList.contains('college-card');
                        const prefix = isCollege ? 'college' : 'corporate';
                        const el = document.getElementById(`${prefix}-${methodType}`);
                        if (el) el.style.display = 'block';
                    });
                });
            });
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function () {
            initPaymentMethodToggles();
        });
    </script>

