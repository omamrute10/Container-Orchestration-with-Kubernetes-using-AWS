            font-weight: 800;
            color: var(--brand-1);
            margin-bottom: 4px;
        }

        .muted {
            color: var(--muted);
        }

        .qr-code {
            width: 100%;
            max-width: 260px;
            height: 310px;
            border: 1px solid #e9ecef;
            margin-top: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            object-fit: cover;
        }

        .small-note {
            font-size: 0.95rem;
            color: var(--muted);
        }

        .feature-list li {
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .feature-list li i {
            color: var(--success);
            font-size: 0.9rem;
        }

        .actions .btn {
            min-width: 160px;
            border-radius: 8px;
            font-weight: 600;
            padding: 10px 18px;
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-primary {
            background: var(--gradient);
            border: none;
        }

        .btn-outline-primary {
            border: 2px solid var(--brand-1);
            color: var(--brand-1);
            background: transparent;
        }

        .payment-methods {
            display: flex;
            gap: 12px;
            margin: 12px 0;
        }

        .payment-method {
            flex: 1;
            text-align: center;
            padding: 10px;
            border-radius: 8px;
            background: var(--light-bg);
            cursor: pointer;
            transition: all 0.2s ease;
            border: 2px solid transparent;
            user-select: none;
            margin-bottom: 8px;
        }

        .payment-method.active {
            border-color: var(--brand-1);
            background: rgba(11, 95, 255, 0.05);
        }

        .payment-method i {
            font-size: 1.4rem;
            margin-bottom: 6px;
            color: var(--brand-1);
        }

        .contact-support {
            background: var(--gradient);
            color: white;
            border-radius: 12px;
            padding: 18px;
            text-align: center;
            margin-top: 14px;
        }

