            font-weight: 800;
            letter-spacing: -0.5px;
            font-size: 2.2rem;
            margin-bottom: 6px;
            display: inline-block;
        }

        .page-header p {
            max-width: 900px;
            margin: 0 auto;
            font-size: 1rem;
            color: var(--muted);
        }

        .payment-card {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 22px;
            box-shadow: var(--shadow);
            border: 1px solid rgba(15, 40, 80, 0.04);
            margin-bottom: 18px;
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
        }

        .payment-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .payment-card:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--gradient);
        }

        .plan-title {
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .price {
