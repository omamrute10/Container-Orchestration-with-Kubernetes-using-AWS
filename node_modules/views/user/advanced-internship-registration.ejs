    <script>
    // Global variable tracking verification state natively
    let isMobileVerified = false;

    (function () {
        'use strict';
        const forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                // Check default fields validity OR verify custom mobile verification flag status
                if (!form.checkValidity() || !isMobileVerified) {
                    event.preventDefault();
                    event.stopPropagation();
                    
                    if(!isMobileVerified) {
                        alert("Form submission halted: Please verify your mobile phone number via OTP sequence first.");
                    }
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const internshipType = document.getElementById("internshipType");
            const academicSection = document.getElementById("academicSection");
            const academicFields = document.querySelectorAll(".academic-field");
            const durationSelect = document.getElementById("internshipDuration");

            const fullDurationOptions = `
        <option value="" disabled selected>Select Duration</option>
        <option>30 Days</option>
        <option>45 Days</option>
        <option>60 Days</option>
        <option>3 Months</option>
        <option>4 Months</option>
        <option>5 Months</option>
        <option>6 Months</option>
    `;

            const corporateDurationOption = `
        <option value="6 Months" selected>6 Months</option>
    `;

            internshipType.addEventListener("change", function () {

                if (this.value === "Corporate") {

                    // Hide academic section
                    academicSection.style.display = "none";

                    // Remove required
                    academicFields.forEach(field => {
                        field.removeAttribute("required");
                        field.value = "";
                    });

                    // Only 6 months duration
                    durationSelect.innerHTML = corporateDurationOption;

                } else {

                    // Show academic section
                    academicSection.style.display = "block";

                    // Add required
                    academicFields.forEach(field => {
                        field.setAttribute("required", "required");
                    });

                    // Restore full duration list
                    durationSelect.innerHTML = fullDurationOptions;
                }
            });
        });
    </script>

    <script>
document.getElementById('btn-send-otp').addEventListener('click', async function() {
    const mobileField = document.getElementById('student_mobile');
    const mobile = mobileField.value;
    
    if (!mobile || mobile.length !== 10 || isNaN(mobile)) {
        alert("Please enter a valid 10-digit mobile number first.");
        return;
    }

    this.disabled = true;
    this.innerText = "Sending...";

    try {
        const response = await fetch('/send-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mobile: mobile })
        });
        const data = await response.json();

        if (data.success) {
            document.getElementById('otp-container').style.display = 'flex';
            this.innerText = "Resend";
            alert("An OTP code has been successfully sent to your mobile number.");
        } else {
            alert(data.message || "Failed to deliver text message gateway code.");
            this.innerText = "Get OTP";
        }
    } catch (error) {
        console.error("Transmission Error:", error);
        this.innerText = "Get OTP";
    } finally {
        this.disabled = false;
    }
});

document.getElementById('btn-verify-otp').addEventListener('click', async function() {
    const mobile = document.getElementById('student_mobile').value;
    const otp = document.getElementById('otp_input').value;
    const msgElem = document.getElementById('otp-message');
    const tickAddon = document.getElementById('mobile-success-tick');
    const sendOtpBtn = document.getElementById('btn-send-otp');

    if (!otp || otp.length !== 6) {
        alert("Please enter the complete 6-digit verification code.");
        return;
    }

    try {
        const response = await fetch('/verify-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mobile: mobile, otp: otp })
        });
        const data = await response.json();

        msgElem.classList.remove('d-none', 'text-danger', 'text-success');

        if (data.success) {
            msgElem.innerText = "✓ Mobile Number Verified Successfully";
            msgElem.classList.add('text-success');
            
            // Set security flags & unlock submit engine state safely
            isMobileVerified = true;
            
            // Safely target state element configurations
            const submitBtn = document.getElementById('btn-submit-form');
            if (submitBtn) submitBtn.disabled = false;
            
            // Permanently lock field configurations against edits
            document.getElementById('student_mobile').readOnly = true;
            document.getElementById('otp_input').readOnly = true;
            document.getElementById('btn-verify-otp').disabled = true;

            // 🌟 THE UPDATE: Hide the Resend button parent structure completely
            if (sendOtpBtn) {
                // Find the parent element wrapping the button (".input-group-append") and remove it
                const buttonWrapper = sendOtpBtn.closest('.input-group-append');
                if (buttonWrapper) {
                    buttonWrapper.style.setProperty('display', 'none', 'important');
                } else {
                    sendOtpBtn.style.setProperty('display', 'none', 'important');
                }
            }

            // 🌟 THE UPDATE: Display verification tick addon and fix its borders
            if (tickAddon) {
                tickAddon.classList.remove('d-none');
                tickAddon.classList.add('d-flex');
                // Give the checkmark container clean rounded corners since the button is gone
                tickAddon.style.borderTopRightRadius = '10px';
                tickAddon.style.borderBottomRightRadius = '10px';
            }

            // Disappear the wrapper code block cleanly with a professional fade out transition
            setTimeout(() => {
                const otpContainer = document.getElementById('otp-container');
                if (otpContainer) {
                    otpContainer.style.transition = "opacity 0.3s ease";
                    otpContainer.style.opacity = "0";
                    setTimeout(() => {
                        otpContainer.style.setProperty('display', 'none', 'important');
                    }, 300);
                }
            }, 1500);

        } else {
            msgElem.innerText = "✗ Incorrect code validation. Please check and retry.";
            msgElem.classList.add('text-danger');
        }
    } catch (error) {
        console.error("Validation Pipeline Interrupted:", error);
    }
});
</script>

