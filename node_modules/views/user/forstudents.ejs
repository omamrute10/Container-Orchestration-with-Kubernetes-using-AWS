<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <!-- Primary SEO Title -->
    <title>
        IT Corporate Training for Students in Ahilyanagar | Internships & Technology Training
    </title>

    <!-- SEO Description -->
    <meta name="description"
        content="Kanak Digifex provides IT corporate training for students in Ahilyanagar with internships, practical technology training, real-world client projects, workshops and masterclasses in Full Stack Development, AI & ML, Cloud Computing, Data Science, Data Analytics, Digital Marketing and IoT.">

    <!-- SEO Keywords -->
    <meta name="keywords"
        content="
        IT Corporate Training for Students in Ahilyanagar,
        Student IT Training in Ahilyanagar,
        Computer Training in Ahilyanagar,
        IT Internship in Ahilyanagar,
        Computer Science Internship in Ahilyanagar,
        Final Year Internship in Ahilyanagar,
        Academic Internship in Ahilyanagar,
        Corporate Training for Students,
        Full Stack Development Training,
        AI ML Training,
        Cloud Computing Training,
        Data Science Training,
        Data Analytics Training,
        Digital Marketing Training,
        IoT Training,
        Software Development Internship,
        Technology Training for Students,
        Career Oriented IT Training,
        IT Company in Ahilyanagar
        ">

    <meta name="robots" content="index, follow">

    <!-- Open Graph -->
    <meta property="og:title"
        content="IT Corporate Training for Students in Ahilyanagar | Kanak Digifex">

    <meta property="og:description"
        content="Industry-oriented IT training, internships, workshops and real-world client project experience for students in Ahilyanagar.">

    <meta property="og:type"
        content="website">

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


    <style>

        /* =========================================================
           STUDENT CORPORATE TRAINING PAGE
        ========================================================= */

        .student-training-page {
            font-family: inherit;
            color: #202a4a;
            background: #ffffff;
        }


        /* =========================================================
           HERO SECTION
        ========================================================= */

        .student-training-hero {
            position: relative;
            overflow: hidden;
            padding: 95px 0 85px;
            background:
                radial-gradient(circle at 10% 20%,
                    rgba(190, 59, 135, 0.12),
                    transparent 30%),
                radial-gradient(circle at 90% 20%,
                    rgba(0, 176, 216, 0.13),
                    transparent 30%),
                linear-gradient(135deg, #f9f8ff 0%, #ffffff 55%, #f5fbff 100%);
        }

        .student-training-hero::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border: 2px solid rgba(190, 59, 135, 0.12);
            border-radius: 50%;
            top: -120px;
            right: -80px;
        }

        .student-training-hero::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border: 2px solid rgba(0, 176, 216, 0.12);
            border-radius: 50%;
            bottom: -90px;
            left: -60px;
        }

        .student-hero-content {
            position: relative;
            z-index: 2;
            max-width: 900px;
            margin: auto;
            text-align: center;
        }

        .student-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 18px;
            margin-bottom: 22px;
            border-radius: 50px;
            background: rgba(190, 59, 135, 0.08);
            border: 1px solid rgba(190, 59, 135, 0.15);
            color: #be3b87;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .student-hero-title {
            margin: 0 auto 22px;
            max-width: 900px;
            color: #18244b;
            font-size: 48px;
            line-height: 1.15;
            font-weight: 800;
        }

        .student-hero-title span {
            color: #be3b87;
        }

        .student-hero-description {
            max-width: 780px;
            margin: 0 auto 32px;
            color: #626a7d;
            font-size: 17px;
            line-height: 1.8;
        }

        .student-hero-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .student-primary-btn,
        .student-secondary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            min-width: 190px;
            padding: 14px 25px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .student-primary-btn {
            background: #be3b87;
            color: #ffffff;
            box-shadow: 0 10px 25px rgba(190, 59, 135, 0.22);
        }

        .student-primary-btn:hover {
            color: #ffffff;
            transform: translateY(-3px);
            box-shadow: 0 14px 30px rgba(190, 59, 135, 0.30);
        }

        .student-secondary-btn {
            background: #ffffff;
            color: #18244b;
            border: 1px solid #e4e6ed;
        }

        .student-secondary-btn:hover {
            color: #be3b87;
            border-color: #be3b87;
            transform: translateY(-3px);
        }


        /* =========================================================
           TRUST / INTRO STRIP
        ========================================================= */

        .student-trust-strip {
            background: #18244b;
            padding: 22px 0;
        }

        .student-trust-items {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 45px;
            flex-wrap: wrap;
        }

        .student-trust-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            font-weight: 600;
        }

        .student-trust-item i {
            color: #00b0d8;
            font-size: 16px;
        }


        /* =========================================================
           COMMON SECTION
        ========================================================= */

        .student-section {
            padding: 80px 0;
        }

        .student-section-light {
            background: #f8f9fc;
        }

        .student-section-heading {
            max-width: 800px;
            margin: 0 auto 50px;
            text-align: center;
        }

        .student-section-label {
            display: inline-block;
            margin-bottom: 12px;
            color: #be3b87;
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .student-section-title {
            margin: 0 0 16px;
            color: #18244b;
            font-size: 36px;
            line-height: 1.25;
            font-weight: 800;
        }

        .student-section-description {
            margin: 0;
            color: #6b7280;
            font-size: 16px;
            line-height: 1.8;
        }


        /* =========================================================
           INTRO CONTENT
        ========================================================= */

        .student-intro-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 50px;
            align-items: center;
        }

        .student-intro-content h3 {
            margin-bottom: 18px;
            color: #18244b;
            font-size: 28px;
            font-weight: 750;
            line-height: 1.35;
        }

        .student-intro-content p {
            margin-bottom: 17px;
            color: #626a7d;
            font-size: 15.5px;
            line-height: 1.85;
        }

        .student-intro-content strong {
            color: #18244b;
        }

        .student-highlight-box {
            padding: 35px;
            border-radius: 22px;
            background: linear-gradient(
                145deg,
                #18244b,
                #283663
            );
            box-shadow: 0 20px 45px rgba(24, 36, 75, 0.16);
        }

        .student-highlight-box h4 {
            margin-bottom: 22px;
            color: #ffffff;
            font-size: 22px;
            font-weight: 700;
        }

        .student-highlight-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .student-highlight-list li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 17px;
            color: rgba(255, 255, 255, 0.88);
            font-size: 14px;
            line-height: 1.6;
        }

        .student-highlight-list li:last-child {
            margin-bottom: 0;
        }

        .student-highlight-list i {
            margin-top: 4px;
            color: #00b0d8;
        }


        /* =========================================================
           TECHNOLOGY CARDS
        ========================================================= */

        .student-tech-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
        }

        .student-tech-card {
            position: relative;
            padding: 28px 22px;
            background: #ffffff;
            border: 1px solid #e9eaf0;
            border-radius: 17px;
            transition: all 0.35s ease;
            overflow: hidden;
        }

        .student-tech-card::before {
            content: "";
            position: absolute;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(190, 59, 135, 0.06);
            top: -35px;
            right: -35px;
            transition: all 0.35s ease;
        }

        .student-tech-card:hover {
            transform: translateY(-7px);
            border-color: rgba(190, 59, 135, 0.25);
            box-shadow: 0 15px 35px rgba(24, 36, 75, 0.09);
        }

        .student-tech-card:hover::before {
            transform: scale(1.5);
        }

        .student-tech-icon {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            margin-bottom: 20px;
            border-radius: 13px;
            background: rgba(190, 59, 135, 0.09);
            color: #be3b87;
            font-size: 22px;
        }

        .student-tech-card h3 {
            position: relative;
            z-index: 2;
            margin-bottom: 10px;
            color: #18244b;
            font-size: 18px;
            font-weight: 700;
        }

        .student-tech-card p {
            position: relative;
            z-index: 2;
            margin: 0;
            color: #73798a;
            font-size: 13.5px;
            line-height: 1.7;
        }


        /* =========================================================
           LEARNING JOURNEY
        ========================================================= */

        .student-learning-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .student-learning-card {
            padding: 32px;
            background: #ffffff;
            border-radius: 18px;
            border: 1px solid #e8e9ef;
            text-align: center;
            transition: all 0.3s ease;
        }

        .student-learning-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(24, 36, 75, 0.08);
        }

        .student-step-number {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: #be3b87;
            color: #ffffff;
            font-size: 17px;
            font-weight: 800;
        }

        .student-learning-card h3 {
            margin-bottom: 10px;
            color: #18244b;
            font-size: 19px;
            font-weight: 700;
        }

        .student-learning-card p {
            margin: 0;
            color: #72798b;
            font-size: 14px;
            line-height: 1.75;
        }


        /* =========================================================
           REAL WORLD PROJECT SECTION
        ========================================================= */

        .student-project-section {
            background: linear-gradient(
                135deg,
                #18244b 0%,
                #283663 100%
            );
            color: #ffffff;
        }

        .student-project-grid {
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 55px;
            align-items: center;
        }

        .student-project-content .student-section-label {
            color: #00b0d8;
        }

        .student-project-content h2 {
            margin-bottom: 20px;
            color: #ffffff;
            font-size: 36px;
            line-height: 1.3;
            font-weight: 800;
        }

        .student-project-content > p {
            margin-bottom: 20px;
            color: rgba(255, 255, 255, 0.78);
            font-size: 15.5px;
            line-height: 1.85;
        }

        .student-project-points {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
            margin-top: 25px;
        }

        .student-project-point {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.04);
            color: rgba(255, 255, 255, 0.88);
            font-size: 13px;
        }

        .student-project-point i {
            color: #00b0d8;
        }

        .student-mentor-card {
            padding: 35px;
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
        }

        .student-mentor-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 62px;
            height: 62px;
            margin-bottom: 20px;
            border-radius: 15px;
            background: rgba(0, 176, 216, 0.14);
            color: #00b0d8;
            font-size: 25px;
        }

        .student-mentor-card h3 {
            margin-bottom: 12px;
            color: #ffffff;
            font-size: 23px;
            font-weight: 700;
        }

        .student-mentor-card p {
            margin-bottom: 20px;
            color: rgba(255, 255, 255, 0.72);
            font-size: 14px;
            line-height: 1.8;
        }

        .student-mentor-card ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .student-mentor-card li {
            margin-bottom: 12px;
            color: rgba(255, 255, 255, 0.82);
            font-size: 14px;
        }

        .student-mentor-card li i {
            margin-right: 8px;
            color: #00b0d8;
        }


        /* =========================================================
           INTERNSHIP SECTION
        ========================================================= */

        .student-internship-card {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: 45px;
            padding: 45px;
            border-radius: 24px;
            background: #ffffff;
            border: 1px solid #e7e8ee;
            box-shadow: 0 15px 40px rgba(24, 36, 75, 0.07);
        }

        .student-internship-left h2 {
            margin-bottom: 15px;
            color: #18244b;
            font-size: 30px;
            line-height: 1.3;
            font-weight: 800;
        }

        .student-internship-left p {
            color: #707789;
            font-size: 15px;
            line-height: 1.8;
        }

        .student-internship-right {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .student-internship-feature {
            padding: 20px;
            border-radius: 13px;
            background: #f8f8fb;
        }

        .student-internship-feature i {
            margin-bottom: 12px;
            color: #be3b87;
            font-size: 20px;
        }

        .student-internship-feature h3 {
            margin-bottom: 7px;
            color: #18244b;
            font-size: 16px;
            font-weight: 700;
        }

        .student-internship-feature p {
            margin: 0;
            color: #777d8d;
            font-size: 13px;
            line-height: 1.65;
        }


        /* =========================================================
           WORKSHOPS
        ========================================================= */

        .student-workshop-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .student-workshop-card {
            padding: 30px;
            border-radius: 18px;
            background: #ffffff;
            border: 1px solid #e8e9ef;
            transition: all 0.3s ease;
        }

        .student-workshop-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(24, 36, 75, 0.08);
        }

        .student-workshop-card i {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 52px;
            height: 52px;
            margin-bottom: 18px;
            border-radius: 12px;
            background: rgba(0, 176, 216, 0.09);
            color: #00a0c4;
            font-size: 21px;
        }

        .student-workshop-card h3 {
            margin-bottom: 10px;
            color: #18244b;
            font-size: 19px;
            font-weight: 700;
        }

        .student-workshop-card p {
            margin: 0;
            color: #73798a;
            font-size: 14px;
            line-height: 1.75;
        }


        /* =========================================================
           WHO CAN JOIN
        ========================================================= */

        .student-audience-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .student-audience-card {
            padding: 25px 18px;
            text-align: center;
            background: #ffffff;
            border: 1px solid #e8e9ef;
            border-radius: 15px;
        }

        .student-audience-card i {
            margin-bottom: 15px;
            color: #be3b87;
            font-size: 26px;
        }

        .student-audience-card h3 {
            margin: 0;
            color: #18244b;
            font-size: 16px;
            line-height: 1.5;
            font-weight: 700;
        }


        /* =========================================================
           FAQ
        ========================================================= */

        .student-faq {
            max-width: 900px;
            margin: auto;
        }

        .student-faq-item {
            margin-bottom: 14px;
            padding: 22px 25px;
            background: #ffffff;
            border: 1px solid #e7e8ed;
            border-radius: 12px;
        }

        .student-faq-item h3 {
            margin: 0 0 9px;
            color: #18244b;
            font-size: 17px;
            font-weight: 700;
        }

        .student-faq-item p {
            margin: 0;
            color: #73798a;
            font-size: 14px;
            line-height: 1.75;
        }


        /* =========================================================
           FINAL CTA
        ========================================================= */

        .student-final-cta {
            padding: 75px 20px;
            background: linear-gradient(
                135deg,
                #be3b87,
                #9d2e70
            );
            text-align: center;
        }

        .student-final-cta h2 {
            margin-bottom: 15px;
            color: #ffffff;
            font-size: 36px;
            font-weight: 800;
        }

        .student-final-cta p {
            max-width: 700px;
            margin: 0 auto 28px;
            color: rgba(255, 255, 255, 0.86);
            font-size: 16px;
            line-height: 1.8;
        }

        .student-final-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 15px 30px;
            border-radius: 8px;
            background: #ffffff;
            color: #be3b87;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .student-final-btn:hover {
            color: #be3b87;
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 1199px) {

            .student-tech-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .student-audience-grid {
                grid-template-columns: repeat(2, 1fr);
            }

        }


        @media (max-width: 991px) {

            .student-training-hero {
                padding: 75px 20px;
            }

            .student-hero-title {
                font-size: 40px;
            }

            .student-intro-grid,
            .student-project-grid,
            .student-internship-card {
                grid-template-columns: 1fr;
            }

            .student-learning-grid,
            .student-workshop-grid {
                grid-template-columns: 1fr;
            }

            .student-project-grid {
                gap: 35px;
            }

        }


        @media (max-width: 767px) {

            .student-training-hero {
                padding: 60px 15px;
            }

            .student-hero-title {
                font-size: 31px;
            }

            .student-hero-description {
                font-size: 15px;
            }

            .student-section {
                padding: 55px 15px;
            }

            .student-section-title {
                font-size: 28px;
            }

            .student-trust-items {
                gap: 18px;
                flex-direction: column;
            }

            .student-tech-grid,
            .student-audience-grid,
            .student-project-points,
            .student-internship-right {
                grid-template-columns: 1fr;
            }

            .student-highlight-box,
            .student-mentor-card,
            .student-internship-card {
                padding: 28px 22px;
            }

            .student-project-content h2 {
                font-size: 29px;
            }

            .student-final-cta h2 {
                font-size: 28px;
            }

            .student-primary-btn,
            .student-secondary-btn {
                width: 100%;
            }

        }

    </style>

</head>


<body>


<!-- =========================================================
     EXISTING WEBSITE HEADER
========================================================= -->

<%- include("header.ejs") %>


<main class="student-training-page">


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="student-training-hero">

        <div class="container">

            <div class="student-hero-content">

                <div class="student-hero-badge">
                    <i class="fa-solid fa-graduation-cap"></i>
                    Corporate IT Training for Students
                </div>

                <h1 class="student-hero-title">
                    Industry-Ready
                    <span>IT Training & Internships</span>
                    for Students in Ahilyanagar
                </h1>

                <p class="student-hero-description">
                    Build practical technology skills with corporate IT training,
                    internships, workshops, masterclasses and real-world project
                    experience. Learn modern technologies from basic to advanced
                    levels under the guidance of experienced IT professionals and
                    senior developers.
                </p>

                <div class="student-hero-buttons">

                    <a href="/advanced-internship-registration"
                       class="student-primary-btn">
                        <i class="fa-solid fa-paper-plane"></i>
                        Apply for Internship
                    </a>

                    <a href="/courses"
                       class="student-secondary-btn">
                        <i class="fa-solid fa-laptop-code"></i>
                        Explore Programs
                    </a>

                </div>

            </div>

        </div>

    </section>



    <!-- =====================================================
         TRUST STRIP
    ====================================================== -->

    <section class="student-trust-strip">

        <div class="container">

            <div class="student-trust-items">

                <div class="student-trust-item">
                    <i class="fa-solid fa-code"></i>
                    Practical Technology Training
                </div>

                <div class="student-trust-item">
                    <i class="fa-solid fa-briefcase"></i>
                    Internship Opportunities
                </div>

                <div class="student-trust-item">
                    <i class="fa-solid fa-diagram-project"></i>
                    Real-World Projects
                </div>

                <div class="student-trust-item">
                    <i class="fa-solid fa-user-tie"></i>
                    Senior Developer Guidance
                </div>

                <div class="student-trust-item">
                    <i class="fa-solid fa-chalkboard-user"></i>
                    Workshops & Masterclasses
                </div>

            </div>

        </div>

    </section>



    <!-- =====================================================
         INTRODUCTION
    ====================================================== -->

    <section class="student-section">

        <div class="container">

            <div class="student-intro-grid">

                <div class="student-intro-content">

                    <span class="student-section-label">
                        Corporate Learning for Students
                    </span>

                    <h2>
                        Learn Technology. Build Projects.
                        Gain Real Industry Experience.
                    </h2>

                    <p>
                        Kanak Digifex NextGen Pvt. Ltd. is an
                        <strong>IT company in Ahilyanagar</strong> providing
