                    <div class="learning-outcomes mb-4">
                        <h5 class="fw-semibold mb-3">What You'll Learn</h5>
                        <div class="accordion" id="internshipAccordion">

                            <!-- Technical Skills -->
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingOne">
