    <div class="container mt-5 mb-5">
        <div class="row ">
            <div class="col-12 col-md-10 col-lg-7">
                <div class="card border-0 shadow-lg overflow-hidden">
                    <!-- Form Header with Gradient Background -->
                    <div class="card-header py-4"
                        style="background: linear-gradient(135deg, #af0b4e 0%, #6a0d83 100%);">
                        <h3 class="font-weight-bold text-white text-center mb-0">Internship Application</h3>
                        <p class="text-white text-center mb-0 mt-2">Launch your career with hands-on experience</p>
                    </div>

                    <!-- Form Body -->
                    <div class="card-body px-4 py-4">
                        <form action="/save_college_internships_registration" method="post" id="internshipForm"
                            class="needs-validation" novalidate>
                            <!-- Personal Information Section -->
                            <div class="mb-4">
                                <h5 class=" mb-3 border-bottom pb-2"><i class="fas fa-user-circle mr-2"></i> Personal
                                    Information</h5>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="fullName" class="form-label">Full Name <span
                                                class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                                            <input type="text" class="form-control" name="student_name" id="fullName"
                                                placeholder="Enter your full name" required>
                                            <div class="invalid-feedback">Please enter your full name.</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="mobile" class="form-label">Mobile <span
                                                class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                            <input type="tel" class="form-control" name="student_mobile" id="mobile"
                                                placeholder="Enter your mobile number" required pattern="[0-9]{10}">
                                            <div class="invalid-feedback">Please enter a valid 10-digit mobile number.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="email" class="form-label">Email <span
                                            class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                        <input type="email" class="form-control" name="student_email" id="email"
                                            placeholder="Enter your email" required>
                                        <div class="invalid-feedback">Please enter a valid email address.</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Academic Information Section -->
                            <div class="mb-4">
                                <h5 class=" mb-3 border-bottom pb-2"><i class="fas fa-graduation-cap mr-2"></i> Academic
                                    Information</h5>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="college" class="form-label">College Name <span
                                                class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-university"></i></span>
                                            <input type="text" class="form-control" name="student_college_name"
                                                id="college" placeholder="Enter your college name" required>
                                            <div class="invalid-feedback">Please enter your college name.</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="degree" class="form-label">Current Stream <span
                                                class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-book"></i></span>
                                            <input type="text" class="form-control" name="student_degree" id="degree"
                                                placeholder="Diploma/Graduation/Post-Graduation" required>
                                            <div class="invalid-feedback">Please enter at least one.</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="academicYear" class="form-label">Current Academic Year <span
                                            class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                        <select class="form-select" name="student_academic_year" id="academicYear"
                                            required>
                                            <option value="" disabled selected>Select your academic year</option>
                                            <option value="1">1st Year</option>
                                            <option value="2">2nd Year</option>
                                            <option value="3">3rd Year</option>
                                            <option value="4">4th Year</option>
                                        </select>
                                        <div class="invalid-feedback">Please select your academic year.</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Internship Selection Section -->
                            <div class="mb-4">
                                <h5 class=" mb-3 border-bottom pb-2"><i class="fas fa-briefcase mr-2"></i> Internship
                                    Preferences</h5>
                                <div class="mb-3">
                                    <label for="internshipOptions" class="form-label">Select Internship(s) <small
                                            class="text-muted">(Hold Ctrl/Cmd to select multiple)</small> <span
                                            class="text-danger">*</span></label>
                                    <select class="form-select" name="student_selected_internships"
                                        id="internshipOptions" multiple size="5" required>
                                        <optgroup label="Development">
                                            <option value="Web Development">Web Development</option>
                                            <option value="Mobile App Development">Mobile App Development</option>
                                            <option value="Python">Python</option>
                                            <option value="PHP">PHP</option>
                                            <option value="Node.js">Node.js</option>
                                            <option value="React.js">React.js</option>
                                            <option value="Angular">Angular</option>
                                        </optgroup>
                                        <optgroup label="Data & AI">
                                            <option value="Artificial Intelligence">Artificial Intelligence</option>
                                            <option value="Data Science">Data Science</option>
                                            <option value="Machine Learning">Machine Learning</option>
                                            <option value="Power BI">Power BI</option>
                                        </optgroup>
                                        <optgroup label="Other Fields">
                                            <option value="Cloud Computing">Cloud Computing</option>
                                            <option value="Digital Marketing">Digital Marketing</option>
                                            <option value="Corporate Graphic Design">Corporate Graphic Design</option>
                                        </optgroup>
                                    </select>
                                    <div class="invalid-feedback">Please select at least one internship option.</div>
                                    <small class="text-muted">We'll match you with the best opportunities based on your
                                        selection</small>
                                </div>
                            </div>

                            <!-- Submit Button -->
