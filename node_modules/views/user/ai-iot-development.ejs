}

.services-points{
    list-style: none;
    padding: 0;
    margin: 0;
}

.services-points li{
    position: relative;
    padding: 12px 0 12px 35px;
    border-bottom: 1px dashed #d7d7d7;
    color: #555;
    font-size: 15px;
    font-weight: 500;
}

.services-points li:last-child{
    border-bottom: none;
}

.services-points li::before{
    content: "✓";
    position: absolute;
    left: 0;
    top: 10px;
    width: 22px;
    height: 22px;
