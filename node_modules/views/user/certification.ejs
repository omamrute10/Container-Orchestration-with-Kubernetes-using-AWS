    <div class="container mb-5">
        <div class="row">
            <div class="col-md-12 mt-4 text-center" data-aos="fade-down">
                <h3 class="font-weight-bold display-5 mb-4" style="font-weight: bold;">Our Certificate Gallery</h3>
                <div class="divider mx-auto" style="background-color: rgb(175,11,78);"></div>
            </div>

            <% for(var i=0;i<certification_images.length;i++) { %>
                <div class="col-12 col-sm-6 col-md-6 col-lg-4 mt-5" data-aos="zoom-in" data-aos-delay="<%=i*50%>">
                    <div class="certificate-card">
                        <div class="certificate-img-container">
                            <img src="/uploads/<%=certification_images[i].certification_image%>"
                                alt="Certificate <%=i+1%>" class="certificate-image" loading="lazy">
                            <div class="certificate-overlay">
                                <button class="btn btn-view"
                                    onclick="openCertificateModal('/uploads/<%=certification_images[i].certification_image%>')">
                                    <i class="bi bi-zoom-in"></i> View Certificate
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
        </div>
    </div>

    <!-- Certificate Modal -->
    <div class="modal fade" id="certificateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-header border-0">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-0">
                    <img id="modalCertificateImage" src="" class="img-fluid rounded-3 shadow-lg" alt="Certificate">
                </div>
            </div>
        </div>
    </div>

    <script>
        function openCertificateModal(imageSrc) {
            document.getElementById('modalCertificateImage').src = imageSrc;
            var modal = new bootstrap.Modal(document.getElementById('certificateModal'));
            modal.show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const certificateForm = document.getElementById("certificateForm");
            const certificateContainer = document.getElementById("certificateContainer");
            const certificatePlaceholder = document.getElementById("certificatePlaceholder");
            const certificateImage = document.getElementById("certificateImage");
            const downloadBtn = document.getElementById("downloadBtn");

            certificateForm.addEventListener("submit", async function (event) {
                event.preventDefault();

                const submitBtn = this.querySelector('button[type="submit"]');
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Verifying...';
                submitBtn.disabled = true;

                const formData = new FormData(this);
                const name = formData.get("name");
                const certificateNumber = formData.get("certificateNumber");
                const mobileNumber = formData.get("mobileNumber");

                try {
                    const response = await fetch("/verify-certificate", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },
                        body: JSON.stringify({
                            name,
                            certificateNumber,
                            mobileNumber
                        })
                    });

                    const data = await response.json();

                    if (data.success && data.image) {
                        // Show certificate and hide placeholder
                        certificateImage.src = "/uploads/" + data.image;
                        certificatePlaceholder.classList.add("d-none");
                        certificateContainer.classList.remove("d-none");

                        // Set up download button
                        downloadBtn.onclick = function () {
                            const link = document.createElement('a');
                            link.href = "/uploads/" + data.image;
                            link.download = `certificate_${certificateNumber}.jpg`;
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);
                        };
                    } else {
                        alert(data.message || "No certificate found. Please check the details and try again.");
                    }
                } catch (error) {
                    console.error("Error verifying certificate:", error);
                    alert("An error occurred. Please try again.");
                } finally {
                    submitBtn.innerHTML = '<i class="bi bi-search me-2"></i> Verify Certificate';
                    submitBtn.disabled = false;
                }
            });
        });
    </script>

    <script>
    document.getElementById("downloadBtn").addEventListener("click", function () {
        const image = document.getElementById("certificateImage");

        // Get the current image source
        const imageUrl = image.src;

        if (!imageUrl) {
            alert("No certificate to download.");
            return;
        }

        // Create a temporary anchor tag for download
        const a = document.createElement("a");
        a.href = imageUrl;
        a.download = "Certificate.jpg"; // तुमच्या file चं नाव
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    });
</script>


