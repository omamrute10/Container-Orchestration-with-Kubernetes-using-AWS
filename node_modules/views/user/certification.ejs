    <div class="container-fluid certificate-verify-container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="verify-card shadow-lg rounded-4 overflow-hidden">
                    <div class="row g-0">
                        <!-- Verification Form Section -->
                        <div class="col-lg-6 form-section p-4 p-md-5" data-aos="fade-right">
                            <div class="text-center mb-4">
                                <h2 class="verify-title mb-3">Verify Your Certificate</h2>
                                <div class="title-divider mx-auto"></div>
                            </div>

                            <form class="row g-3 needs-validation" novalidate id="certificateForm">
                                <div class="col-12">
                                    <label for="name" class="form-label fw-semibold">Student Name</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control form-control" id="name" name="name"
                                            placeholder="Enter your name" required>
                                    </div>
                                    <div class="invalid-feedback">Please provide a valid name.</div>
                                </div>

                                <div class="col-12">
                                    <label for="certificateNumber" class="form-label fw-semibold">Certificate
                                        Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text text-white fw-semibold">UCN-KD-</span>
                                        <input type="text" class="form-control form-control" id="certificateNumber"
                                            name="certificateNumber" placeholder="Enter certificate number"
