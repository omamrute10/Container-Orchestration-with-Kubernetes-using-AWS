    <style>
        /* Certificate Gallery Styles */
        .certificate-card {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            height: 100%;
            background: white;
        }

        .certificate-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }

        .certificate-img-container {
            position: relative;
            padding-top: 140%;
            /* 5:7 aspect ratio for certificates */
            overflow: hidden;
        }

        .certificate-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .certificate-card:hover .certificate-image {
            transform: scale(1.03);
        }

        .certificate-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(195, 86, 252, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .certificate-card:hover .certificate-overlay {
            opacity: 1;
        }

        .btn-view {
            background: white;
            color: rgb(195, 86, 252);
            border: none;
            padding: 8px 20px;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-view:hover {
            background: #f8f9fa;
            transform: translateY(-2px);
        }

        .divider {
            width: 80px;
            height: 3px;
        }

        /* Modal Styles */
        #certificateModal .modal-content {
            background: transparent;
            border: none;
        }

        #modalCertificateImage {
            max-height: 85vh;
            max-width: 100%;
            object-fit: contain;
            border: 10px solid white;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .certificate-verify-container {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

        .verify-card {
            background: white;
            border: none;
            transition: all 0.3s ease;
        }

        .verify-title {
            color: rgb(150, 21, 219);
            font-weight: bold;
            font-size: 2rem;
            position: relative;
        }

        .title-divider {
            width: 80px;
            height: 4px;
            background: rgb(131, 7, 197);
            border-radius: 2px;
        }

        .form-section {
            background: white;
        }

        .input-group-text {
            background: rgb(195, 86, 252);
            color: white;
            border: none;
        }

        .result-section {
            background: linear-gradient(135deg, rgb(195, 86, 252) 0%, #9c0b4a 100%);
            color: white;
        }

        .result-header {
            background: rgba(0, 0, 0, 0.1);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .certificate-frame {
            border: 2px dashed rgba(175, 11, 78, 0.3);
            max-width: 100%;
        }

        .download-btn {
            border-width: 2px;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .download-btn:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .illustration-section {
            background: linear-gradient(135deg, rgba(175, 11, 78, 0.05) 0%, rgba(175, 11, 78, 0.02) 100%);
        }

        @media (max-width: 992px) {
            .verify-card {
                border-radius: 12px;
            }

            .form-section,
            .result-section,
            .illustration-section {
                padding: 2rem !important;
            }

            .result-section {
                border-bottom-left-radius: 12px;
                border-bottom-right-radius: 12px;
            }
        }

        .verify-btn {
            position: relative;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            padding: 1rem 2rem;
            font-size: 1.1rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: white;
            background: linear-gradient(135deg, rgb(195, 86, 252) 0%, rgb(149, 6, 225) 100%);
            border: none;
            border-radius: 50px;
            box-shadow: 0 4px 15px rgba(175, 11, 78, 0.3);
            cursor: pointer;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .verify-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(175, 11, 78, 0.4);
            background: linear-gradient(135deg, rgb(48, 7, 70) 0%, rgb(92, 4, 139) 100%);
        }

        .verify-btn:active {
            transform: translateY(0);
            box-shadow: 0 3px 10px rgba(175, 11, 78, 0.3);
        }
    </style>
