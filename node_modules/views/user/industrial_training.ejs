            width: 0;
            height: 3px;
            background-color: #4d0997;
            transition: width 0.3s ease-in-out, left 0.3s ease-in-out;
        }

        .input-container input:focus~.input-underline {
            width: 100%;
            left: 0;
        }

        .input-underline {
            position: absolute;
            bottom: 0;
            left: 50%;
            width: 0;
            height: 3px;
            background-color: #4d0997;
            transition: width 0.3s ease-in-out, left 0.3s ease-in-out;
        }

        .form-card {
            max-width: 800px;
            margin: 20px auto;
            background: white;
            padding: 25px;
            padding-bottom: 0px;
