<style>

/*========== SERVICES PAGE CSS START ==========*/

.services-section{
    padding: 60px 0;
    background: #f8f9fc;
}

.services-card{
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    transition: 0.4s ease;
    box-shadow: 0 5px 25px rgba(0,0,0,0.08);
    height: 100%;
}

.services-card:hover{
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

/* Image */

.services-image{
    overflow: hidden;
}

.services-image img{
    width: 100%;
    height: 220px;
    object-fit: cover;
    transition: 0.5s ease;
}

.services-card:hover .services-image img{
    transform: scale(1.05);
}

/* Content Area */

.services-content{
    padding: 14px 16px;
}

/* Title */

.services-content h3{
    font-size: 21px;
    font-weight: 700;
    color: #111;
    margin-bottom: 8px;   /* Reduced from 20px */
    line-height: 1.3;
}

/* Link */

.service-link{
    text-decoration: none;
    color: #111;
    transition: 0.3s;
}

.service-link:hover{
    color: #c056fc;
}

/* Points List */

.services-points{
    list-style: none;
    padding: 0;
    margin: 0;
}

.services-points li{
    position: relative;
    padding: 8px 0 8px 30px; /* Reduced from 12px */
    border-bottom: 1px dashed #d7d7d7;
    color: #555;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
}

.services-points li:last-child{
    border-bottom: none;
}

/* Check Icon */

.services-points li::before{
    content: "✓";
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 18px;
    background: linear-gradient(135deg,#7b2ff7,#c056fc);
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
}

/* Mobile */

@media(max-width:767px){

    .services-content{
        padding: 12px;
    }

    .services-content h3{
        font-size: 20px;
        margin-bottom: 6px;
    }

    .services-image img{
        height: 200px;
    }

    .services-points li{
        font-size: 14px;
        padding: 7px 0 7px 28px;
    }
}

/*========== SERVICES PAGE CSS END ==========*/
/*========== SERVICES PAGE CSS END ==========*/

</style>

