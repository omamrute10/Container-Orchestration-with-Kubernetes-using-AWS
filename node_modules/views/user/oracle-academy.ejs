                        padding: 10px 14px;
                        border-radius: 8px;
                        cursor: pointer;
                        font-weight: 600;
                        transition: all .18s;
                        box-shadow: 0 3px 8px rgba(71, 48, 109, 0.15);
                    }

                    .cert-btn:hover {
                        transform: translateY(-2px);
                    }

                    .cert-btn.selected {
                        background: linear-gradient(90deg, #ffbf00, #ff8a00);
                        color: #111;
                        box-shadow: 0 6px 18px rgba(255, 142, 0, 0.18);
                    }

                    .cert-btn[disabled] {
                        opacity: 0.5;
                        cursor: not-allowed;
