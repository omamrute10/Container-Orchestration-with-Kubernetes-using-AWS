    <style>
        .indi-marquee-section {
            background: linear-gradient(135deg, rgba(205, 92, 252, 0.9), rgba(155, 52, 202, 0.9));
            color: white;
            overflow: hidden;
            position: relative;
            box-shadow: 0 4px 20px rgba(205, 92, 252, 0.3);
            font-family: 'Poppins', sans-serif;
            animation: indi-pulse-glow 3s infinite;
            padding: 5px;
        }

        .indi-marquee-container {
            display: flex;
            width: 100%;
            position: relative;
        }

        .indi-marquee-content {
            display: flex;
            flex-shrink: 0;
            align-items: center;
            justify-content: space-around;
            min-width: 100%;
            animation: indi-scroll 25s linear infinite;
            padding: 0 20px;
        }

        .indi-marquee-item {
            display: flex;
            align-items: center;
            margin: 0 40px;
            white-space: nowrap;
        }

        .indi-marquee-icon {
            font-size: 24px;
            margin-right: 12px;
            animation: indi-bounce 2s infinite;
        }

        .indi-offer-text {
            font-size: 18px;
            font-weight: 600;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.2);
        }

        .indi-highlight {
            font-weight: bold;
            color: white;
            text-shadow: 0 0 5px rgba(255, 215, 0, 0.5);
        }

        .indi-claim-button {
            background: white;
            color: rgb(205, 92, 252);
            border: none;
            padding: 5px 15px;
            border-radius: 30px;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            margin-left: 20px;
            position: relative;
            overflow: hidden;
        }

        .indi-claim-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        .indi-claim-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: 0.5s;
        }

        .indi-claim-button:hover::before {
            left: 100%;
        }

        /* Edge fading */
        .indi-marquee-section::before,
        .indi-marquee-section::after {
            content: '';
            position: absolute;
            top: 0;
            height: 100%;
            width: 100px;
            z-index: 2;
        }

        .indi-marquee-section::before {
            left: 0;
            background: linear-gradient(90deg, rgba(205, 92, 252, 1), rgba(205, 92, 252, 0));
        }

        .indi-marquee-section::after {
            right: 0;
            background: linear-gradient(90deg, rgba(205, 92, 252, 0), rgba(205, 92, 252, 1));
        }

        /* Animations */
        @keyframes indi-scroll {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-100%);
            }
        }

        @keyframes indi-bounce {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }

        @keyframes indi-pulse-glow {
            0% {
                box-shadow: 0 0 10px rgba(205, 92, 252, 0.5);
            }

            50% {
                box-shadow: 0 0 20px rgba(205, 92, 252, 0.8);
            }

            100% {
                box-shadow: 0 0 10px rgba(205, 92, 252, 0.5);
            }
        }

        @media(max-width:667px) {
            .sec-btn {
                margin-bottom: 20px;
            }
        }
    </style>
