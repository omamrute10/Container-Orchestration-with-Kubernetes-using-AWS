    <!-- Workshop Registration Modal -->
    <div id="workshopModal" class="modal" style="display:none;">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal()">&times;</span>
            <h3>Workshop Registration</h3>
            <form id="workshopForm">
                <input type="text" name="name" placeholder="Your Name" required />
                <input type="email" name="email" placeholder="Your Email" required />
                <input type="tel" name="mobile" placeholder="Mobile Number" required />
                <input type="text" name="workshop" id="selectedWorkshop" placeholder="Workshop Name" readonly
                    required />
                <textarea name="message" placeholder="Your Message (Optional)"></textarea>
                <div class="our-event-btn">
                    <button type="submit" class="sec-btn">Confirm Registration</button>
                </div>
            </form>
        </div>
    </div>


    <style>
        .modal {
            position: fixed;
            z-index: 999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background: rgba(0, 0, 0, 0.6);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: white;
            padding: 30px;
            width: 100%;
            max-width: 500px;
            border-radius: 12px;
            position: relative;
        }

        .modal-content h3 {
            margin-bottom: 20px;
            text-align: center;
        }

        .modal-content input,
        .modal-content textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        .modal-content button {
            background: #007bff;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .close-modal {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 20px;
            cursor: pointer;
        }
    </style>

    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Open modal with specific workshop name
        const registerButtons = document.querySelectorAll('.our-event-btn a');
        registerButtons.forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const title = this.closest('.our-event-box').querySelector('.h4-title').innerText;
                document.getElementById('selectedWorkshop').value = title;
                document.getElementById('workshopModal').style.display = 'flex';
            });
        });

        // Close modal
        function closeModal() {
            document.getElementById('workshopModal').style.display = 'none';
        }

        // Submit form with SweetAlert
        document.getElementById('workshopForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const form = this;
            const formData = {
                customer_name: form.name.value,
                customer_email: form.email.value,
                customer_mobile: form.mobile.value,
                customer_workshop: form.workshop.value,
                customer_message: form.message.value
            };

            fetch('/save_workshop_details', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            })
                .then(res => res.json())
                .then(data => {
                    Swal.fire({
                        icon: 'success',
                        title: 'Registration Successful!',
                        text: data.message || 'You have been registered for the workshop.',
                        confirmButtonColor: '#007bff'
                    });

                    form.reset();
                    closeModal();
                })
                .catch(err => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops!',
                        text: 'Something went wrong. Please try again later.',
                        confirmButtonColor: '#dc3545'
                    });
                });
        });
    </script>

