    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Advanced Workshop Registration</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet">
    </head>

    <body>
        <section class="workshop-section">
            <div class="bg-shapes">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
                <div class="shape shape-3"></div>
            </div>

            <div class="workshop-container">
                <div class="workshop-header">
                    <div class="particles" id="particles"></div>
                    <h2 class="title-animated">PVP COLLEGE OF ART'S, SCIENCE & COMMERCE, LONI</h2>
                    <div class="subtitle">In Association With </div>
                    <h2 class="title-animated">KANAK DIGIFEX NEXTGEN PVT. LTD </h2>
                    <div class="subtitle">First Ever Corporate IT Company Of Ahilyanagar (Reg.Office-Mumbai) </div>

                </div>

                <div class="workshop-content">
                    <div class="info-section">
                        <div class="info-grid">
                            <div class="info-card" data-aos="fade-up" data-delay="0">
                                <div class="info-icon gradient-bg">📅</div>
                                <div class="info-details">
                                    <div class="info-label">Start Date</div>
                                    <div class="info-value">24 October 2025</div>
                                </div>
                                <div class="card-glow"></div>
                            </div>
                            <div class="info-card" data-aos="fade-up" data-delay="100">
                                <div class="info-icon gradient-bg">⏰</div>
                                <div class="info-details">
                                    <div class="info-label">Schedule</div>
                                    <div class="info-value">11:00 AM - 1:00 PM</div>
                                </div>
                                <div class="card-glow"></div>
                            </div>
                            <div class="info-card" data-aos="fade-up" data-delay="200">
                                <div class="info-icon gradient-bg">🔄</div>
                                <div class="info-details">
                                    <div class="info-label">Duration</div>
                                    <div class="info-value">10 Days Intensive</div>
                                </div>
                                <div class="card-glow"></div>
                            </div>
                            <div class="info-card" data-aos="fade-up" data-delay="300">
                                <div class="info-icon gradient-bg">💻</div>
                                <div class="info-details">
                                    <div class="info-label">Platform</div>
                                    <div class="info-value">WordPress Focus</div>
                                </div>
                                <div class="card-glow"></div>
                            </div>
                        </div>

                        <div class="description-box">
                            <h3>Why This Workshop?</h3>
                            <p>Join our <strong>10-day intensive workshop</strong> designed to transform complete
                                beginners into confident WordPress developers. This isn't just theory—it's hands-on,
                                project-based learning with real-world applications.</p>
                            <div class="features-list">
                                <div class="feature-item">
                                    <span class="feature-icon">✓</span>
                                    <span>Work with Premium Themes & Page Builders</span>
                                </div>
                                <div class="feature-item">
                                    <span class="feature-icon">✓</span>
                                    <span>Master WordPress customization & plugins</span>
                                </div>
                                <div class="feature-item">
                                    <span class="feature-icon">✓</span>
                                    <span>Learn SEO, security, and performance optimization</span>
                                </div>
                                <div class="feature-item">
                                    <span class="feature-icon">✓</span>
                                    <span>Deploy Websites on Hosting & Custom Domains</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-wrapper">
                            <div class="form-header">
                                <h3>Secure Your Spot Today</h3>
                                <p>Join the next generation of web developers</p>
                            </div>

                            <form action="/save_workshop_details" method="post" id="registrationForm">
                                <div class="input-wrapper">
                                    <div class="input-group">
                                        <div class="input-icon"><i class="fa fa-user"></i></div>
                                        <input type="text" id="name" name="customer_name" required placeholder=" ">
                                        <label for="name">Full Name</label>
                                        <div class="input-line"></div>
                                    </div>
                                </div>

                                <div class="input-wrapper">
                                    <div class="input-group">
                                        <div class="input-icon"><i class="fa fa-envelope"></i></div>
                                        <input type="email" id="email" name="customer_email" required placeholder=" ">
                                        <label for="email">Email Address</label>
                                        <div class="input-line"></div>
                                    </div>
                                </div>


                                <div class="input-row">
                                    <div class="input-wrapper">
                                        <div class="input-group">
                                            <div class="input-icon"><i class="fa fa-mobile"></i></div>
                                            <input type="tel" id="phone" name="customer_mobile" required
                                                placeholder=" ">
                                            <label for="phone">Phone Number</label>
                                            <div class="input-line"></div>
                                        </div>
                                    </div>

                                    <div class="input-wrapper">
                                        <div class="input-group">
                                            <div class="input-icon"><i class="fa fa-mobile"></i></div>
                                            <input type="tel" id="workshop" value="WP 10-Day Workshop" readonly
                                                name="customer_workshop" required placeholder=" ">
                                            <div class="input-line"></div>
                                        </div>
                                    </div>
                                </div>

                                <p
                                    style="text-transform: capitalize;color: white;font-size: 14.5px;padding-bottom: 5px;">
                                    Before clicking on register now make sure you have followed us on instagram</p>
                                <button type="submit" class="submit-btn">
