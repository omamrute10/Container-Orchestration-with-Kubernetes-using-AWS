<%- include('header.ejs') %>

    <!-- Google Fonts Link -->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@100..900&amp;family=Rubik:ital,wght@0,300..900;1,300..900&amp;display=swap"
        rel="stylesheet">
    <style>
        :root {
            --p: #6d3fd1;
            --p-dark: #4b20a2;
            --p-light: #a78bfa;
            --p-soft: #f4efff;
            --ink: #14101f;
            --text: #625a70;
            --muted: #948aa3;
            --line: #e9e2f5;
            --white: #fff;
            --shadow: 0 20px 55px rgba(73, 42, 126, .10);
            --shadow-lg: 0 30px 80px rgba(73, 42, 126, .16);
            --radius: 24px;
        }

        .fs-page {
            color: var(--ink);
            background: #fff;
            overflow: hidden;
            font-family: "Rubik", sans-serif;
        }

        .fs-page *,
        .fs-page *::before,
        .fs-page *::after {
            box-sizing: border-box
        }

        .fs-wrap {
            width: min(1240px, calc(100% - 40px));
            margin: auto;
            position: relative;
            z-index: 2
        }

        .fs-section {
            padding: 96px 0;
            position: relative
        }

        .fs-reveal {
            opacity: 0;
            transform: translateY(22px);
            transition: opacity .65s ease, transform .65s ease
        }

        .fs-reveal.is-visible {
            opacity: 1;
            transform: none
        }

        .fs-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 7px 13px;
            border: 1px solid rgba(109, 63, 209, .12);
            border-radius: 999px;
            background: rgba(109, 63, 209, .06);
            color: var(--p);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .fs-kicker::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--p);
            box-shadow: 0 0 0 4px rgba(109, 63, 209, .10)
        }

        .fs-title {
            margin: 15px 0 0;
            font-family: "Plus Jakarta Sans", Inter, sans-serif;
            font-size: clamp(30px, 2.5vw, 48px);
            line-height: 1.02;
            letter-spacing: -.045em;
            font-weight: 800;
            color: var(--ink)
        }

        .fs-title .accent {
            background: linear-gradient(135deg, var(--p-dark), var(--p-light));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent
        }

        .fs-copy {
            max-width: 610px;
            color: var(--text);
            font-size: 15px;
            line-height: 1.8
        }

        .fs-btn {
            min-height: 52px;
            padding: 0 23px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border-radius: 14px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 750;
            transition: .25s ease
        }

        .fs-btn-primary {
            color: #fff;
            background: linear-gradient(135deg, var(--p-light), var(--p-dark));
            box-shadow: 0 15px 35px rgba(109, 63, 209, .24);
            font-size: 18px !important;

        }

        .fs-btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 45px rgba(109, 63, 209, .32)
        }

        .fs-btn-ghost {
            color: var(--ink);
            background: #fff;
            border: 1px solid var(--line)
        }

        .fs-btn-ghost:hover {
            transform: translateY(-3px);
            border-color: rgba(109, 63, 209, .3);
            box-shadow: var(--shadow)
        }

        .fs-hero {
            display: flex;
            align-items: center;
            position: relative;
            background:
                radial-gradient(circle at 78% 18%, rgba(167, 139, 250, .16), transparent 30%),
                radial-gradient(circle at 10% 88%, rgba(109, 63, 209, .08), transparent 32%),
                linear-gradient(180deg, #fff 0%, #fcfaff 100%);
        }

        .fs-hero::before {
            content: "";
            position: absolute;
            width: 520px;
            height: 520px;
            border-radius: 50%;
            right: -220px;
            top: 70px;
            border: 1px solid rgba(109, 63, 209, .07);
            box-shadow: 0 0 0 70px rgba(109, 63, 209, .018), 0 0 0 140px rgba(109, 63, 209, .012);
        }

        .fs-hero-grid {
            display: grid;
            grid-template-columns: 1.03fr .97fr;
            gap: 50px;
            align-items: center
        }

        .fs-hero-copy {
            padding: 25px 0
        }

        .fs-hero h1 {
            margin: 22px 0;
            font-family: "Plus Jakarta Sans", Inter, sans-serif;
            font-size: clamp(40px, 6.2vw, 60px);
            line-height: 1.2;
            letter-spacing: -.055em;
            font-weight: 850;
            color: var(--ink)
        }

        .fs-hero h1 .gradient-text {
            background: linear-gradient(135deg, var(--p-dark), #8b5cf6 55%, var(--p-light));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent
        }

        .fs-hero-lead {
            max-width: 590px;
            margin: 0 0 28px;
            color: var(--text);
            font-size: 16px;
            line-height: 1.8
        }

        .fs-partners {
            display: flex;
            align-items: center;
            gap: 22px;
            flex-wrap: wrap;
            margin: 24px 0 30px
        }

        .fs-partner {
            display: flex;
            flex-direction: column;
            gap: 3px
        }

        .fs-partner small {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--muted)
        }

        .fs-partner strong {
            font-size: 13px;
            color: var(--ink)
        }

        .fs-partner-divider {
            width: 1px;
            height: 32px;
            background: var(--line)
        }

        .fs-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap
        }

        .fs-visual {
            position: relative;
            min-height: 570px;
            display: grid;
            place-items: center
        }

        .fs-ring {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(109, 63, 209, .08)
        }

        .fs-ring-1 {
            width: 340px;
            height: 340px
        }

        .fs-ring-2 {
            width: 500px;
            height: 500px;
            border-color: rgba(109, 63, 209, .05)
        }

        .fs-ring-3 {
            width: 650px;
            height: 650px;
            border-color: rgba(109, 63, 209, .025)
        }

        .fs-orbit-dot {
            position: absolute;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--p);
            box-shadow: 0 0 25px rgba(109, 63, 209, .45);
            z-index: 5
        }

        .fs-orbit-dot.one {
            top: 17%;
            right: 20%
        }

        .fs-orbit-dot.two {
            bottom: 18%;
            left: 17%;
            background: var(--p-light)
        }

        .fs-terminal {
            width: min(520px, 100%);
            position: relative;
            z-index: 6;
            overflow: hidden;
            border: 1px solid rgba(109, 63, 209, .16);
            border-radius: 22px;
            background: rgba(255, 255, 255, .88);
            backdrop-filter: blur(18px);
            box-shadow: var(--shadow-lg);
            transform: perspective(1200px) rotateY(-5deg) rotateX(2deg);
            transition: transform .2s ease
        }

        .fs-terminal-head {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 18px;
            border-bottom: 1px solid var(--line);
            background: #fff
        }

        .fs-dots {
            display: flex;
            gap: 6px
        }

        .fs-dots i {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #d8d0e5
        }

        .fs-dots i:first-child {
            background: #f87171
        }

        .fs-dots i:nth-child(2) {
            background: #fbbf24
        }

        .fs-dots i:last-child {
            background: #34d399
        }

        .fs-terminal-body {
            padding: 25px 22px 28px;
            font-family: "SF Mono", "Cascadia Code", "Courier New", monospace;
            font-size: 12px;
            line-height: 2;
            color: #312b3d
        }

        .fs-line-no {
            display: inline-block;
            width: 27px;
            color: #b8afc5;
            font-size: 10px
        }

        .c-purple {
            color: var(--p)
        }

        .c-blue {
            color: #4d83e8
        }

        .c-green {
            color: #29935a
        }

        .c-orange {
            color: #d87935
        }

        .c-pink {
            color: #d45a9a
        }

        .fs-progress {
            height: 6px;
            margin-top: 20px;
            overflow: hidden;
            border-radius: 99px;
            background: #eee9f6
        }

        .fs-progress span {
            display: block;
            width: 82%;
            height: 100%;
            border-radius: 99px;
            background: linear-gradient(90deg, var(--p), var(--p-light));
            box-shadow: 0 0 15px rgba(109, 63, 209, .35)
        }

        .fs-terminal-status {
            display: flex;
            justify-content: space-between;
            margin-top: 9px;
            font: 9px Inter, sans-serif;
            letter-spacing: 1.4px;
            color: var(--muted)
        }

        .fs-float {
            position: absolute;
            z-index: 8;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 15px;
            border: 1px solid rgba(109, 63, 209, .10);
            border-radius: 16px;
            background: rgba(255, 255, 255, .92);
            backdrop-filter: blur(12px);
            box-shadow: var(--shadow);
            animation: floatY 5s ease-in-out infinite
        }

        .fs-float-icon {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            background: var(--p-soft);
            color: var(--p);
            font-size: 17px
        }

        .fs-float b {
            display: block;
            font-size: 12px
        }

        .fs-float small {
            display: block;
            margin-top: 2px;
            font-size: 9px;
            color: var(--muted)
        }

        .fs-float-one {
            left: -8px;
            top: 80px
        }

        .fs-float-two {
            right: -8px;
            bottom: 72px;
            animation-delay: 1.4s
        }

        @keyframes floatY {
            50% {
                transform: translateY(-10px)
            }
        }

        .fs-quick {
            border-block: 1px solid var(--line);
            background: #fff
        }

        .fs-quick-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr)
        }

        .fs-quick-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 25px 20px;
            border-right: 1px solid var(--line)
        }

        .fs-quick-item:last-child {
            border-right: 0
        }

        .fs-quick-number {
            font-family: "Plus Jakarta Sans", sans-serif;
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -.04em
        }

        .fs-quick-label {
            font-size: 9px;
            line-height: 1.5;
            text-transform: uppercase;
            letter-spacing: 1.4px;
            color: var(--muted);
            font-weight: 700
        }

        .fs-intro-grid {
            display: grid;
            grid-template-columns: 1fr .82fr;
            gap: 50px;
            align-items: center
        }

        .fs-gap-card {
            position: relative;
            overflow: hidden;
            padding: 26px;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: linear-gradient(145deg, #fff, #fbf8ff);
            box-shadow: var(--shadow);
            transition: .3s ease
        }

        .fs-gap-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg)
        }

        .fs-gap-card::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -80px;
            bottom: -90px;
            border: 1px solid rgba(109, 63, 209, .08);
            border-radius: 50%
        }

        .fs-gap-icon,
        .fs-card-symbol {
            display: grid;
            place-items: center;
            background: var(--p-soft);
            color: var(--p)
        }

        .fs-gap-icon {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            font-size: 23px
        }

        .fs-gap-card h3 {
            margin: 25px 0 12px;
            font: 700 27px/1.1 "Plus Jakarta Sans", Inter, sans-serif;
            letter-spacing: -.035em
        }

        .fs-gap-card p {
            margin: 0;
            color: var(--text);
            font-size: 14px;
            line-height: 1.8
        }

        .fs-mini-flow {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 24px
        }

        .fs-mini-flow span {
            padding: 7px 13px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: #fff;
            font-size: 10px;
            font-weight: 700
        }

        .fs-mini-flow i {
            font-style: normal;
            color: var(--p)
        }

        .fs-dark {
            background: linear-gradient(180deg, #faf8ff, #f5efff);
            border-block: 1px solid var(--line)
        }

        .fs-section-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 35px;
            margin-bottom: 46px
        }

        .fs-learning {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px
        }

        .fs-learn-card {
            position: relative;
            min-height: 250px;
            padding: 28px;
            border: 1px solid var(--line);
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(73, 42, 126, .05);
            transition: .3s ease
        }

        .fs-learn-card:hover {
            transform: translateY(-7px);
            border-color: rgba(109, 63, 209, .25);
            box-shadow: var(--shadow)
        }

        .fs-card-index {
            position: absolute;
            top: 20px;
            right: 22px;
            color: #c8bfd6;
            font: 600 11px monospace
        }

        .fs-card-symbol {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            font-size: 19px
        }

        .fs-learn-card h3 {
            margin: 28px 0 10px;
            font: 700 19px/1.2 "Plus Jakarta Sans", Inter, sans-serif;
            letter-spacing: -.02em
        }

        .fs-learn-card p {
            margin: 0;
            color: var(--text);
            font-size: 13px;
            line-height: 1.75
        }

        .fs-journey {
            background: #fff
        }

        .fs-centered {
            text-align: center
        }

        .fs-centered .fs-copy {
            margin: 16px auto 0
        }

        .fs-road {
            position: relative;
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            margin-top: 65px
        }

        .fs-road-line {
            position: absolute;
            left: 8%;
            right: 8%;
            top: 27px;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(109, 63, 209, .28), transparent)
        }

        .fs-road-step {
            text-align: center;
            position: relative;
            z-index: 2;
            padding: 0 7px
        }

        .fs-road-num {
            width: 56px;
            height: 56px;
            margin: 0 auto 18px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            border: 1px solid rgba(109, 63, 209, .22);
            background: #fff;
            color: var(--p);
            font: 800 11px "Plus Jakarta Sans", sans-serif;
            box-shadow: 0 0 0 7px #fff, 0 12px 25px rgba(73, 42, 126, .10)
        }

        .fs-road-step h3 {
            margin: 0 0 5px;
            font-size: 14px
        }

        .fs-road-step p {
            margin: 0;
            color: var(--muted);
            font-size: 10px
        }

        .fs-stack {
            background: #faf9fd;
            border-top: 1px solid var(--line)
        }

        .fs-stack-grid {
            display: grid;
            grid-template-columns: 1.45fr .9fr .9fr;
            gap: 16px
        }

        .fs-stack-card {
            padding: 27px 22px;
            border: 1px solid var(--line);
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(73, 42, 126, .05);
            transition: .25s
        }

        .fs-stack-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow)
        }

        .fs-stack-card.featured {
            background: linear-gradient(145deg, #fff, #faf6ff)
        }

        .fs-stack-head {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px
        }

        .fs-stack-no {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            background: var(--p-soft);
            color: var(--p);
            font-size: 10px;
            font-weight: 800
        }

        .fs-stack-head small {
            display: block;
            color: var(--muted);
            font-size: 8px;
            letter-spacing: 1.5px
        }

        .fs-stack-head h3 {
            margin: 2px 0 0;
            font: 700 19px "Plus Jakarta Sans", Inter, sans-serif
        }

        .fs-techs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px
        }

        .fs-stack-card:not(.featured) .fs-techs {
            grid-template-columns: 1fr
        }

        .fs-tech {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 11px;
            border: 1px solid #eee9f5;
            border-radius: 13px;
            background: #fbfaff;
            transition: .2s
        }

        .fs-tech:hover {
            background: #fff;
            border-color: rgba(109, 63, 209, .16);
            transform: translateY(-2px)
        }

        .fs-tech-logo {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: #fff;
            font-size: 11px;
            font-weight: 800
        }

        .html {
            color: #e66c3d
        }

        .css {
            color: #4f87e8
        }

        .js {
            color: #caa832
        }

        .bootstrap {
            color: #8054d8
        }

        .react {
            color: #27b9dd
        }

        .angular {
            color: #e44c54
        }

        .node {
            color: #49a964
        }

        .postgres {
            color: #5188cf
        }

        .fs-tech strong {
            display: block;
            font-size: 11px
        }

        .fs-tech small {
            display: block;
            margin-top: 2px;
            font-size: 8px;
            color: var(--muted)
        }

        .fs-outcomes {
            display: grid;
            grid-template-columns: .82fr 1.18fr;
            gap: 75px;
            align-items: start
        }

        .fs-outcome-copy h2 {
            margin: 16px 0 18px;
            font: 800 clamp(40px, 4.6vw, 64px)/.98 "Plus Jakarta Sans", Inter, sans-serif;
            letter-spacing: -.05em
        }

        .fs-outcome-copy h2 span {
            color: var(--p)
        }

        .fs-quote {
            margin-top: 28px;
            padding: 20px 22px;
            border-left: 3px solid var(--p);
            border-radius: 12px;
            background: var(--p-soft);
            color: #3a3345;
            font-size: 13px;
            line-height: 1.7
        }

        .fs-outcome-list {
            border-top: 1px solid var(--line)
        }

        .fs-outcome-row {
            display: grid;
            grid-template-columns: 34px 1fr;
            gap: 12px;
            padding: 15px 0;
            border-bottom: 1px solid var(--line)
        }

        .fs-outcome-row span {
            font: 800 10px "Plus Jakarta Sans", sans-serif;
            color: var(--p);
            padding-top: 2px
        }

        .fs-outcome-row p {
            margin: 0;
            color: var(--text);
            font-size: 13px;
            line-height: 1.6
        }

        @media(max-width:1100px) {

            .fs-hero-grid,
            .fs-intro-grid,
            .fs-outcomes {
                grid-template-columns: 1fr
            }

            .fs-hero {
                text-align: center;
                min-height: auto;
                padding: 80px 0 45px
            }

            .fs-hero-lead,
            .fs-copy {
                margin-left: auto;
                margin-right: auto
            }

            .fs-partners,
            .fs-actions {
                justify-content: center
            }

            .fs-visual {
                min-height: 480px
            }

            .fs-learning {
                grid-template-columns: repeat(2, 1fr)
            }

            .fs-stack-grid {
                grid-template-columns: 1fr 1fr
            }

            .fs-stack-card.featured {
                grid-column: 1/-1
            }
        }

        @media(max-width:800px) {
            .fs-wrap {
                width: min(100% - 30px, 680px)
            }

            .fs-section {
                padding: 70px 0
            }

            .fs-hero h1 {
                font-size: 48px
            }

            .fs-visual {
                min-height: 380px
            }

            .fs-quick-grid {
                grid-template-columns: 1fr 1fr
            }

            .fs-quick-item:nth-child(2) {
                border-right: 0
            }

            .fs-quick-item:nth-child(n+3) {
                border-top: 1px solid var(--line)
            }

            .fs-intro-grid {
                gap: 35px
            }

            .fs-section-head {
                display: block;
                margin-bottom: 35px
            }

            .fs-section-head .fs-copy {
                margin-top: 18px
            }

            .fs-learning,
            .fs-stack-grid {
                grid-template-columns: 1fr
            }

            .fs-stack-card.featured {
                grid-column: auto
            }

            .fs-road {
                grid-template-columns: repeat(2, 1fr);
                gap: 35px 10px
            }

            .fs-road-line {
                display: none
            }

            .fs-cert {
                flex-direction: column
            }
        }

        @media(max-width:520px) {
            .fs-wrap {
                width: calc(100% - 24px)
            }

            .fs-hero {
                padding: 55px 0 20px
            }

            .fs-hero h1 {
                font-size: 36px
            }

            .fs-hero-lead {
                font-size: 14px
            }

            .fs-actions {
                flex-direction: column
            }

            .fs-btn {
                width: 100%
            }

            .fs-visual {
                min-height: 290px;
                transform: scale(.78);
                margin: -30px 0
            }

