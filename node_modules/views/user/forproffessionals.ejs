            }

            .professional-cta {
                padding: 65px 15px;
            }

            .professional-cta h2 {
                font-size: 29px;
            }

        }


        @media (max-width: 575px) {

            .professional-hero h1 {
                font-size: 30px;
            }

            .professional-primary-btn,
            .professional-secondary-btn {
                width: 100%;

                justify-content: center;
            }

        }

