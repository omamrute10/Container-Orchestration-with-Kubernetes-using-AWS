    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Animate stats counting
            const statElements = document.querySelectorAll('.career-stat-number');
            const stats = [10000, 95, 500, 24];

            statElements.forEach((element, index) => {
                const target = stats[index];
                const duration = 2000;
                const step = target / (duration / 16);
                let current = 0;

                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        element.textContent = index === 1 ? target + '%' :
                            index === 3 ? target + '/7' :
                                target.toLocaleString() + '+';
                        clearInterval(timer);
                    } else {
                        element.textContent = index === 1 ? Math.floor(current) + '%' :
                            index === 3 ? Math.floor(current) + '/7' :
                                Math.floor(current).toLocaleString() + '+';
                    }
                }, 16);
            });

            // Add hover effects to cards
            const cards = document.querySelectorAll('.career-feature-card');

            cards.forEach(card => {
                card.addEventListener('mouseenter', () => {
                    cards.forEach(otherCard => {
                        if (otherCard !== card) {
                            otherCard.style.opacity = '0.7';
                            otherCard.style.transform = 'scale(0.95)';
                        }
                    });
                });

                card.addEventListener('mouseleave', () => {
                    cards.forEach(otherCard => {
                        otherCard.style.opacity = '1';
                        otherCard.style.transform = 'scale(1)';
                    });
                });
            });
        });
    </script>

