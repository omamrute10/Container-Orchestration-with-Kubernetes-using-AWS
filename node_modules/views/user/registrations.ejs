    <style>
        .career-portal-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3rem 1rem;
            overflow: hidden;
            background: linear-gradient(135deg, rgb(58, 12, 55) 0%, rgb(116, 81, 171) 100%);
        }

        /* Animated Background Elements */
        .career-portal-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: backgroundShift 20s linear infinite;
            z-index: 1;
        }

        @keyframes backgroundShift {
            0% {
                transform: translate(0, 0) rotate(0deg);
            }

            100% {
                transform: translate(-50px, -50px) rotate(360deg);
            }
        }

        /* Floating Shapes */
        .career-floating-shape {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            animation: floatShape 15s ease-in-out infinite;
        }

        .career-floating-shape:nth-child(1) {
            width: 200px;
            height: 200px;
            top: 10%;
            left: 5%;
            animation-delay: 0s;
        }

        .career-floating-shape:nth-child(2) {
            width: 150px;
            height: 150px;
            top: 60%;
            right: 10%;
            animation-delay: -5s;
        }

        .career-floating-shape:nth-child(3) {
            width: 100px;
            height: 100px;
            bottom: 20%;
            left: 15%;
            animation-delay: -10s;
        }

        @keyframes floatShape {

            0%,
            100% {
                transform: translateY(0px) rotate(0deg);
            }

            50% {
                transform: translateY(-30px) rotate(180deg);
            }
        }

        /* Main Content Container */
        .career-content-wrapper {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 1400px;
        }

        /* Main Heading */
        .career-portal-title {
            font-size: clamp(1rem, 8vw, 4rem);
            font-weight: 800;
            text-align: center;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, #fff 0%, #e2e8f0 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        /* Subtitle */
        .career-portal-subtitle {
            font-size: clamp(1.2rem, 3vw, 0.8rem);
            text-align: center;
            max-width: 800px;
            margin: 0 auto 3rem auto;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 300;
            line-height: 1.6;
        }

        /* Stats Container */
        .career-stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 3rem;
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
        }

        .career-stat-item {
            text-align: center;
            padding: 1.5rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .career-stat-item:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.15);
        }

        .career-stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.5rem;
            display: block;
        }

        .career-stat-label {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.8);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Enhanced Cards Grid */
        .career-features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2.5rem;
            margin-bottom: 4rem;
        }

        /* Feature Cards */
        .career-feature-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
            backdrop-filter: blur(20px);
            border-radius: 2rem;
            padding: 3rem 2.5rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        .career-feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 0.6s;
        }

        .career-feature-card:hover::before {
            left: 100%;
        }

        .career-feature-card:hover {
            transform: translateY(-10px);
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.08) 100%);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        /* Card Icon */
        .career-feature-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 2rem auto;
            background: linear-gradient(135deg, rgba(116, 81, 171, 0.3) 0%, rgba(58, 12, 55, 0.3) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: all 0.4s ease;
        }

        .career-feature-card:hover .career-feature-icon {
            transform: scale(1.1) rotate(5deg);
            background: linear-gradient(135deg, rgba(116, 81, 171, 0.5) 0%, rgba(58, 12, 55, 0.5) 100%);
        }

        .career-feature-icon svg {
            width: 50px;
            height: 50px;
            stroke: #fff;
        }

        /* Card Content */
        .career-feature-title {
            font-size: 1.7rem;
            font-weight: 700;
            color: #fff;
            text-align: center;
            margin-bottom: 1rem;
        }

        .career-feature-desc {
            color: rgba(255, 255, 255, 0.8);
            text-align: center;
            line-height: 1.6;
            margin-bottom: 3rem;
            font-size: 1.1rem;
            width: 100%;
            margin: 0px;
        }

        .career-feature-benefits {
            list-style: none;
            padding: 0;
            margin: 0;
            margin-top: 20px;
        }

        .career-feature-benefits li {
            color: rgba(255, 255, 255, 0.7);
            padding: 0.5rem 0;
            font-size: 1rem;
            display: flex;
            align-items: flex-start;
            justify-content: flex-start;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .career-feature-benefits li:last-child {
            border-bottom: none;
        }

        .career-feature-benefits li::before {
            content: '✓';
            color: #fff;
            font-weight: bold;
            margin-right: 0.75rem;
            flex-shrink: 0;
            margin-top: 0.1rem;
        }

        /* Alternative vertical layout with better spacing */
        .career-feature-benefits.vertical-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .career-feature-benefits.vertical-list li {
            padding: 0.75rem 1rem;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 0.5rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .career-feature-benefits.vertical-list li:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateX(5px);
        }

        /* For grid layout within cards */
        .career-feature-benefits.grid-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .career-feature-benefits.grid-layout li {
            display: flex;
            align-items: center;
            padding: 0.6rem 0.8rem;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 0.4rem;
            border-left: 3px solid rgba(255, 255, 255, 0.3);
        }

        /* Simple vertical stack */
        .career-feature-benefits.simple-vertical {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .career-feature-benefits.simple-vertical li {
            display: flex;
            align-items: center;
            padding: 0.4rem 0;
        }

        /* CTA Button */
        .career-cta-button {
            display: inline-block;
            padding: 1rem 3rem;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.1) 100%);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 3rem;
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }

        .career-cta-button:hover {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.2) 100%);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

        /* Footer */
        .career-portal-footer {
            text-align: center;
            margin-top: 1.5rem;
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.2rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .career-portal-section {
                padding: 4rem 1.5rem;
            }

            .career-features-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .career-stats-container {
                grid-template-columns: repeat(2, 1fr);
                gap: 1rem;
            }

            .career-feature-card {
                padding: 2rem 1.5rem;
            }

            .career-floating-shape {
                display: none;
            }
        }

        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {

            .career-portal-section::before,
            .career-floating-shape,
            .career-feature-card::before {
                animation: none;
            }
        }

        .job-search-btn {
            position: relative;
            padding: 0.6rem 3rem;
            margin-top: 30px;
            font-size: 1rem;
            font-weight: 600;
            background: linear-gradient(135deg, #667eea 0%, #52277d 100%);
            color: white;
            border: none;
            text-align: center;
            justify-content: center;
            align-items: center;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-family: 'Poppins', sans-serif;
        }

        .job-search-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s;
        }

        .job-search-btn:hover::before {
            left: 100%;
        }

        .job-search-btn:hover {
            transform: translateY(-3px);
            box-shadow:
                0 15px 35px rgba(102, 126, 234, 0.4),
                0 0 0 1px rgba(255, 255, 255, 0.2);
            background: linear-gradient(135deg, #768aea 0%, #865bb2 100%);
        }

        .job-search-btn:active {
            transform: translateY(-1px);
            box-shadow:
                0 5px 20px rgba(102, 126, 234, 0.3),
                0 0 0 1px rgba(255, 255, 255, 0.1);
        }
    </style>

