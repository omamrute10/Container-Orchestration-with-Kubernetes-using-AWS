                        border-radius: 8px;
                        cursor: pointer;
                        font-weight: 600;
                        transition: all .18s;
                        box-shadow: 0 3px 8px rgba(71, 48, 109, 0.15);
                    }

                    .cert-btn:hover {
                        transform: translateY(-2px);
                    }

                    .cert-btn.selected {
                        background: linear-gradient(90deg, #ffbf00, #ff8a00);
                        color: #111;
                        box-shadow: 0 6px 18px rgba(255, 142, 0, 0.18);
                    }

                    .cert-btn[disabled] {
                        opacity: 0.5;
                        cursor: not-allowed;
                        transform: none;
                        box-shadow: none;
                    }

                    .note {
                        margin-top: 8px;
                        font-size: 0.95rem;
                        color: #555;
                    }
                </style>

                <script>
                    (function () {
                        const maxSelect = 3;
                        const container = document.getElementById('certButtons');
                        const hiddenContainer = document.getElementById('hiddenInterestsContainer');
                        const note = document.getElementById('certNote');

                        function updateNote() {
                            const count = hiddenContainer.querySelectorAll('input[name="interest[]"]').length;
                            note.textContent = `${count} of ${maxSelect} selected`;
                        }

                        function addHidden(value) {
                            const input = document.createElement('input');
                            input.type = 'hidden';
                            input.name = 'interest[]';
                            input.value = value;
                            input.dataset.value = value;
                            hiddenContainer.appendChild(input);
                        }

                        function removeHidden(value) {
                            const existing = hiddenContainer.querySelector(`input[data-value="${CSS.escape(value)}"]`);
                            if (existing) existing.remove();
                        }

                        function selectedCount() {
                            return hiddenContainer.querySelectorAll('input[name="interest[]"]').length;
                        }

                        container.addEventListener('click', (e) => {
                            const btn = e.target.closest('.cert-btn');
                            if (!btn) return;

                            const value = btn.dataset.value;
                            const isSelected = btn.classList.contains('selected');

                            if (isSelected) {
                                // Deselect
                                btn.classList.remove('selected');
                                btn.setAttribute('aria-pressed', 'false');
                                removeHidden(value);
                                // Re-enable other disabled buttons (if any)
                                Array.from(container.querySelectorAll('.cert-btn[disabled]')).forEach(b => b.removeAttribute('disabled'));
                            } else {
                                // Select (check limit)
                                if (selectedCount() >= maxSelect) {
                                    // show small shake/pulse or alert
                                    btn.classList.add('shake-temp');
                                    setTimeout(() => btn.classList.remove('shake-temp'), 400);
                                    alert('You can select up to ' + maxSelect + ' certifications.');
                                    return;
                                }
                                btn.classList.add('selected');
                                btn.setAttribute('aria-pressed', 'true');
                                addHidden(value);
                                // If now reached limit, disable other unselected buttons
                                if (selectedCount() >= maxSelect) {
                                    Array.from(container.querySelectorAll('.cert-btn')).forEach(b => {
                                        if (!b.classList.contains('selected')) b.setAttribute('disabled', 'true');
                                    });
                                }
                            }
                            updateNote();
                        });

                        // small CSS for shake (optional)
                        const style = document.createElement('style');
                        style.textContent = `
      .shake-temp { animation: shake .35s; }
      @keyframes shake { 0%{ transform: translateX(0) } 25%{ transform: translateX(-6px) } 50%{ transform: translateX(6px) } 75%{ transform: translateX(-4px) } 100%{ transform: translateX(0) } }
    `;
                        document.head.appendChild(style);

                        // ✅ Minimum 1 selection required on submit
                        // Uses form with id "regForm" (if your form id is different, replace 'regForm' with your form's id)
                        const form = document.getElementById('regForm');
                        if (form) {
                            form.addEventListener('submit', function (e) {
                                if (selectedCount() === 0) {
                                    e.preventDefault();
                                    // small visual cue + alert
                                    note.textContent = 'Please select at least 1 certification.';
                                    note.style.color = 'crimson';
                                    alert('Please select at least 1 certification.');
                                    // focus first button to help user
                                    const firstBtn = container.querySelector('.cert-btn');
                                    if (firstBtn) firstBtn.focus();
                                    return false;
                                }
                                // otherwise allow submit (hidden inputs already present)
                            });
                        }

                        // initialize note
                        updateNote();
                    })();
                </script>

